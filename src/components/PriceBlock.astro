---
import { contacts } from '../data/prices';
import { currentNews } from '../data/news';

interface Props {
  kind: 'current' | 'promo';
  title: string;
  description: string;
  file: string;
  date: string;
}

const { kind, title, description, file, date } = Astro.props;
const d = new Date(date);
const day = d.toLocaleDateString('ru-RU', { day: 'numeric' });
const month = d.toLocaleDateString('ru-RU', { month: 'long' });
const full = d.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
const blockIcon = kind === 'current' ? '/images/blocks/block-current.png' : '/images/blocks/block-promo.png';
// PDF заменён на интерактивный список товаров с чекбоксами, открывается модальным окном (см. PriceChecklist.astro) —
// удобнее читать и заказывать с телефона, чем скачанный файл.
const dialogId = `checklist-${kind}-dialog`;

const icons: Record<string, string> = {
  telegram: 'M22 2 11 13 M22 2 15 22 11 13 2 9 22 2Z',
  email: 'M3 5h18v14H3z M4 7l8 6 8-6',
};
// whatsapp и bip — составные иконки (несколько path/circle), нарисованы вручную под currentColor (растровые PNG не подошли: мутные в 18px и ломались на hover)

// Заготовленный текст заказа — один и тот же для обоих блоков (прайс и акции), подставляется в Telegram/WhatsApp/почту.
// Bip не поддерживает предзаполнение текста через ссылку — оставлен как есть.
const orderText = 'Здравствуйте! Хочу оформить заказ. Подскажите, пожалуйста, актуальное наличие.';

// У Telegram нет официальной поддержки ?text= для прямой ссылки на человека (только для t.me/share) —
// клиенты (особенно мобильные) этот параметр игнорируют, поэтому ссылка на Telegram — просто чат,
// а сам текст копируется в буфer обмена через data-copy-text (см. script ниже).
const links: Record<string, string> = {
  telegram: contacts.telegram.href,
  whatsapp: `${contacts.whatsapp.href}?text=${encodeURIComponent(orderText)}`,
  bip: contacts.bip.href,
  email: `${contacts.email.href}?subject=${encodeURIComponent('Заявка с сайта Zilma')}&body=${encodeURIComponent(orderText)}`,
};
---
<article class:list={['price-card', kind]}>
  <div class="split">
    <div class:list={['stat-panel', { 'has-news': kind === 'current' && currentNews }]}>
      {kind === 'current' && currentNews ? (
        <>
          <div class="stat-compact">
            <span class="stat-compact-date"><b>{day}</b> {month}</span>
            <span class="stat-compact-label">актуально на дату</span>
          </div>
          <div class="news-block">
            <span class="news-icon-badge">
              <svg class="news-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 11v2a2 2 0 0 0 2 2h1l3 5V4L6 9H5a2 2 0 0 0-2 2Z" />
                <path d="M15 8a4 4 0 0 1 0 8" />
                <path d="M18 5a8 8 0 0 1 0 14" />
              </svg>
            </span>
            <div class="news-body">
              <span class="news-badge">Новость</span>
              <p class="news-text">{currentNews.text}</p>
              {currentNews.link && (
                <a class="news-link" href={currentNews.link}>{currentNews.linkLabel ?? 'Подробнее'} →</a>
              )}
            </div>
          </div>
        </>
      ) : (
        <>
          <p class="stat"><span class="stat-num">{day}</span> <span class="stat-unit">{month}</span></p>
          <p class="meta-label">актуально на дату</p>
          <img src={blockIcon} alt="" class="block-icon" />
        </>
      )}
    </div>
    <div class="text-panel">
      <h2>{title}</h2>
      <p class="desc">{description}</p>
      <div class="row">
        <div class="download-group">
          {kind === 'current' && (
            <button type="button" class="download" data-open-modal={dialogId}>Каталог — выбрать и заказать</button>
          )}
          {kind === 'current' && (
            <button type="button" class="download promo-trigger" data-open-modal="checklist-promo-dialog">Акции — выбрать и заказать</button>
          )}
          <a class:list={['download', { outline: kind === 'current' }]} href={file} download>Скачать EXCEL</a>
        </div>
        <span class="meta-label">{kind === 'current' ? 'прайс' : 'акции'} · {full}</span>
      </div>
    </div>
  </div>
  <div class="contacts">
    <span class="meta-label">оформить заказ</span>
    <ul>
      {Object.entries(contacts).map(([key, c]) => (
        <li>
          <a
            href={links[key]}
            target="_blank"
            rel="noopener"
            aria-label={`${c.label}: ${c.value}`}
            title={`${c.label}: ${c.value}`}
            data-copy-text={key === 'telegram' ? orderText : undefined}
          >
            {key === 'whatsapp' ? (
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M12 21a9 9 0 1 0-7.6-4.2L3 21l4.4-1.3A9 9 0 0 0 12 21Z" />
                <path
                  transform="translate(6.3,5.3) scale(0.56)"
                  fill="currentColor"
                  stroke="none"
                  d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8Z"
                />
              </svg>
            ) : key === 'bip' ? (
              <svg viewBox="0 0 100 100" width="23" height="23" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="46" cy="44" r="38" />
                <path d="M66 76 L82 82 L74 64" />
                <line x1="24" y1="24" x2="24" y2="62" />
                <circle cx="32" cy="54" r="11" />
                <circle cx="46" cy="27" r="2.3" fill="currentColor" stroke="none" />
                <line x1="46" y1="35" x2="46" y2="62" />
                <line x1="62" y1="35" x2="62" y2="74" />
                <circle cx="70" cy="54" r="11" />
              </svg>
            ) : (
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d={icons[key]} />
              </svg>
            )}
          </a>
        </li>
      ))}
    </ul>
  </div>
</article>

<script>
  // Telegram игнорирует ?text= на прямых ссылках — копируем текст заказа в буфер обмена
  // перед открытием чата, чтобы человеку осталось только вставить (Ctrl+V).
  let toastEl: HTMLDivElement | null = null;
  function showToast(message: string) {
    if (!toastEl) {
      toastEl = document.createElement('div');
      toastEl.className = 'copy-toast';
      document.body.appendChild(toastEl);
    }
    toastEl.textContent = message;
    toastEl.classList.add('show');
    clearTimeout((toastEl as any)._t);
    (toastEl as any)._t = setTimeout(() => toastEl?.classList.remove('show'), 2500);
  }

  document.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest('a[data-copy-text]') as HTMLAnchorElement | null;
    if (!link) return;
    const text = link.getAttribute('data-copy-text');
    if (!text) return;
    e.preventDefault();
    navigator.clipboard?.writeText(text).catch(() => {});
    showToast('Текст заказа скопирован — вставьте в чат (Ctrl+V)');
    window.open(link.href, '_blank', 'noopener');
  });
</script>

<style is:global>
  .copy-toast {
    position: fixed;
    left: 50%;
    bottom: 28px;
    transform: translate(-50%, 12px);
    background: var(--color-ink);
    color: #fff;
    font-size: 0.9rem;
    padding: 12px 20px;
    border-radius: var(--radius-control);
    box-shadow: var(--shadow-card-hover);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
    z-index: 100;
    max-width: 90vw;
    text-align: center;
  }
  .copy-toast.show {
    opacity: 1;
    transform: translate(-50%, 0);
  }
</style>

<style>
  .price-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-paper);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    border: 1px solid var(--color-panel-line);
    overflow: hidden;
    transition: box-shadow 0.25s ease, opacity 0.8s ease, transform 0.8s ease;
  }

  .price-card:hover {
    box-shadow: var(--shadow-card-hover);
  }

  .split {
    display: flex;
    flex: 1;
    min-height: 220px;
  }

  .stat-panel {
    flex: 0 0 38%;
    background: var(--color-panel);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 24px;
    text-align: center;
  }

  .price-card.current .stat-panel {
    background: var(--gradient-surface-blue);
  }

  .price-card.promo .stat-panel {
    background: var(--gradient-surface-pink);
  }

  .stat {
    font-family: var(--font-serif);
    margin: 0;
    line-height: 1;
    color: var(--color-ink);
  }

  .stat-num {
    font-size: 2.6rem;
  }

  .stat-unit {
    font-size: 1.1rem;
  }

  .block-icon {
    width: 60px;
    height: 60px;
    opacity: 0.62;
  }

  /* Когда есть активная новость (src/data/news.ts) — панель делится на 2 части вместо того,
     чтобы новость требовала отдельное место на странице: компактная дата сверху (не пропадает,
     просто уступает площадь) + новость снизу, крупнее и на переднем плане. Без новости —
     .has-news не навешивается, панель остаётся как была (дата на всю площадь). */
  .stat-panel.has-news {
    justify-content: flex-start;
    align-items: stretch;
    text-align: left;
    gap: 14px;
    padding: 18px 22px;
  }

  .stat-compact {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
    opacity: 0.75;
  }

  .stat-compact-date {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    color: var(--color-ink);
  }

  .stat-compact-label {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-meta);
  }

  .news-block {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: #fff;
    border-left: 4px solid var(--color-red);
    border-radius: var(--radius-card);
    padding: 14px 16px;
    box-shadow: 0 6px 16px rgba(43, 32, 28, 0.14);
  }

  .news-icon-badge {
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--color-red);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .news-icon {
    width: 20px;
    height: 20px;
    color: #fff;
  }

  .news-badge {
    align-self: flex-start;
    display: inline-block;
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    background: var(--color-red);
    color: #fff;
    padding: 2px 8px;
    border-radius: var(--radius-control);
    margin-bottom: 5px;
  }

  .news-body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .news-text {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--color-ink);
  }

  .news-link {
    display: inline-block;
    margin-top: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-blue-dark);
    text-decoration: none;
  }

  .news-link:hover {
    text-decoration: underline;
  }

  .text-panel {
    flex: 1;
    padding: 28px 30px;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 10px;
  }

  .text-panel h2 {
    align-self: start;
  }

  .text-panel .desc {
    align-self: start;
  }

  .text-panel .row {
    align-self: end;
  }

  h2 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.35rem;
    margin: 0;
    color: var(--color-ink);
  }

  .desc {
    margin: 0;
    color: #5c5049;
    line-height: 1.55;
    font-size: 0.95rem;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 8px;
    flex-wrap: wrap;
  }

  .download-group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .download {
    display: inline-block;
    background: var(--color-ink);
    color: #fff;
    text-decoration: none;
    font: inherit;
    font-weight: 600;
    font-size: 0.9rem;
    padding: 10px 20px;
    border: none;
    border-radius: var(--radius-card);
    white-space: nowrap;
    box-shadow: var(--shadow-sm);
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .price-card.current .download {
    background: var(--color-blue-dark);
  }

  .price-card.promo .download {
    background: var(--color-red);
  }

  .download:hover {
    filter: brightness(1.1);
  }

  .price-card .download.outline {
    background: transparent;
    box-shadow: none;
    border: 1.5px solid var(--color-blue-dark);
    color: var(--color-blue-dark);
  }

  .price-card.promo .download.outline {
    border-color: var(--color-red);
    color: var(--color-red);
  }

  .price-card.current .download.outline:hover {
    background: var(--color-blue-dark);
    color: #fff;
  }

  .price-card.promo .download.outline:hover {
    background: var(--color-red);
    color: #fff;
  }

  .price-card .download.promo-trigger {
    background: var(--color-red);
    color: #fff;
  }

  .price-card .download.promo-trigger:hover {
    filter: brightness(1.1);
  }

  .contacts {
    border-top: 1px solid var(--color-panel-line);
    padding: 14px 30px;
    min-height: 90px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .contacts ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .contacts a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-mist);
    color: var(--color-blue-dark);
    box-shadow: var(--shadow-sm);
    transition: background 0.2s ease, color 0.2s ease;
  }

  .price-card.promo .contacts a {
    color: var(--color-red);
  }

  .contacts a:hover {
    background: var(--color-blue-dark);
    color: #fff;
  }

  .price-card.promo .contacts a:hover {
    background: var(--color-red);
    color: #fff;
  }

  @media (max-width: 640px) {
    .split {
      flex-direction: column;
      min-height: auto;
    }
    .stat-panel {
      flex: none;
      padding: 20px;
    }
    .text-panel {
      padding: 22px 20px;
    }
    .row {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
    }
  }
</style>
