---
// Плавающая нижняя плашка быстрой навигации — только на мобильных экранах (см. media query ниже).
// «Каталог»/«Акции» всегда ведут на главную с якорем-командой (#open-catalog / #open-promo) —
// именно там, и только там, гарантированно есть обе модалки (PriceChecklist.astro); открытие по
// этим якорям обрабатывает скрипт в PriceChecklist.astro (общий, страница-уровня).
---
<nav class="mobile-nav" aria-label="Быстрая навигация">
  <a href="/" class="mobile-nav-item">
    <span class="mobile-nav-icon">
      <svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 11.5 12 4l9 7.5" />
        <path d="M5.5 10v10.5h5V14h3v6.5h5V10" />
      </svg>
    </span>
    <span class="mobile-nav-label">Главная</span>
  </a>
  <a href="/#open-catalog" class="mobile-nav-item">
    <span class="mobile-nav-icon">
      <svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3.5" y="3.5" width="7.5" height="7.5" rx="1.2" />
        <rect x="13" y="3.5" width="7.5" height="7.5" rx="1.2" />
        <rect x="3.5" y="13" width="7.5" height="7.5" rx="1.2" />
        <rect x="13" y="13" width="7.5" height="7.5" rx="1.2" />
      </svg>
    </span>
    <span class="mobile-nav-label">Каталог</span>
  </a>
  <a href="/#open-promo" class="mobile-nav-item">
    <span class="mobile-nav-icon">
      <svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 2h7a2 2 0 0 1 2 2v7a2 2 0 0 1-.6 1.4l-8 8a2 2 0 0 1-2.8 0l-7-7a2 2 0 0 1 0-2.8l8-8A2 2 0 0 1 12 2Z" />
        <circle cx="16.5" cy="7.5" r="1.4" fill="currentColor" stroke="none" />
      </svg>
    </span>
    <span class="mobile-nav-label">Акции</span>
  </a>
  <a href="/#info" class="mobile-nav-item">
    <span class="mobile-nav-icon">
      <svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 2.5h8.5L19 7v14.5H6Z" />
        <path d="M14.5 2.5V7H19" />
        <line x1="9" y1="13" x2="15.5" y2="13" />
        <line x1="9" y1="17" x2="15.5" y2="17" />
      </svg>
    </span>
    <span class="mobile-nav-label">Инфо</span>
  </a>
</nav>

<style>
  .mobile-nav {
    display: none;
  }

  @media (max-width: 640px) {
    .mobile-nav {
      display: flex;
      position: fixed;
      left: 12px;
      right: 12px;
      bottom: calc(10px + env(safe-area-inset-bottom));
      z-index: 150;
      justify-content: space-around;
      align-items: center;
      background: rgba(188, 216, 242, 0.58);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.5);
      border-radius: 24px;
      box-shadow: var(--shadow-card-hover);
      padding: 9px 6px;
      transition: transform 0.38s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.28s ease;
      animation: nav-rise 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .mobile-nav.nav-hidden {
      transform: translateY(160%) scale(0.92);
      opacity: 0;
    }

    @keyframes nav-rise {
      from {
        opacity: 0;
        transform: translateY(28px) scale(0.94);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .mobile-nav {
        animation: none;
        transition: opacity 0.2s ease;
      }
      .mobile-nav.nav-hidden {
        transform: none;
      }
    }
  }

  .mobile-nav-item {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-decoration: none;
    color: var(--color-ink);
  }

  .mobile-nav-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-panel);
    color: var(--color-red);
    box-shadow: var(--shadow-sm);
    transition: transform 0.15s ease, background 0.15s ease;
  }

  .mobile-nav-label {
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1;
  }

  .mobile-nav-item:active .mobile-nav-icon {
    transform: scale(0.92);
    background: var(--color-paper);
  }
</style>

<script>
  // Скрытие/показ плашки по кастомным событиям — их шлёт PriceChecklist.astro при скролле списка
  // внутри открытого окна Каталог/Акции (дальше вниз по списку — прячем, назад к началу — показываем).
  const nav = document.querySelector<HTMLElement>('.mobile-nav');
  document.addEventListener('zilma:nav-hide', () => nav?.classList.add('nav-hidden'));
  document.addEventListener('zilma:nav-show', () => nav?.classList.remove('nav-hidden'));
</script>
