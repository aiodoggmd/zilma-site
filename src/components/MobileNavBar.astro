---
// Плавающая нижняя плашка быстрой навигации — только на мобильных экранах (см. media query ниже).
// «Каталог»/«Акции» всегда ведут на главную с якорем-командой (#open-catalog / #open-promo) —
// именно там, и только там, гарантированно есть обе модалки (PriceChecklist.astro); открытие по
// этим якорям обрабатывает скрипт в PriceChecklist.astro (общий, страница-уровня).
---
<nav class="mobile-nav" aria-label="Быстрая навигация">
  <a href="/" class="mobile-nav-item">
    <span class="mobile-nav-icon">
      <svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 11.5 12 4l9 7.5" />
        <path d="M5.5 10v10.5h5V14h3v6.5h5V10" />
      </svg>
    </span>
    <span class="mobile-nav-label">Главная</span>
  </a>
  <a href="/#open-catalog" class="mobile-nav-item">
    <span class="mobile-nav-icon">
      <svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3.5" y="3.5" width="7.5" height="7.5" rx="1.2" />
        <rect x="13" y="3.5" width="7.5" height="7.5" rx="1.2" />
        <rect x="3.5" y="13" width="7.5" height="7.5" rx="1.2" />
        <rect x="13" y="13" width="7.5" height="7.5" rx="1.2" />
      </svg>
    </span>
    <span class="mobile-nav-label">Каталог</span>
  </a>
  <a href="/#open-promo" class="mobile-nav-item">
    <span class="mobile-nav-icon">
      <svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 2h7a2 2 0 0 1 2 2v7a2 2 0 0 1-.6 1.4l-8 8a2 2 0 0 1-2.8 0l-7-7a2 2 0 0 1 0-2.8l8-8A2 2 0 0 1 12 2Z" />
        <circle cx="16.5" cy="7.5" r="1.4" fill="currentColor" stroke="none" />
      </svg>
    </span>
    <span class="mobile-nav-label">Акции</span>
  </a>
  <a href="/order/#order" class="mobile-nav-item" data-cart-link>
    <span class="mobile-nav-icon">
      <svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="9" cy="20" r="1.4" fill="currentColor" stroke="none" />
        <circle cx="18" cy="20" r="1.4" fill="currentColor" stroke="none" />
        <path d="M2.5 3h2l2.6 12.6a2 2 0 0 0 2 1.6h8.4a2 2 0 0 0 2-1.5L21 8H6" />
      </svg>
      <span class="mobile-nav-badge" id="mobile-nav-cart-badge" hidden>0</span>
    </span>
    <span class="mobile-nav-label">Заявка</span>
  </a>
  <a href="/#info" class="mobile-nav-item" data-info-link>
    <span class="mobile-nav-icon">
      <svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 2.5h8.5L19 7v14.5H6Z" />
        <path d="M14.5 2.5V7H19" />
        <line x1="9" y1="13" x2="15.5" y2="13" />
        <line x1="9" y1="17" x2="15.5" y2="17" />
      </svg>
    </span>
    <span class="mobile-nav-label">Инфо</span>
  </a>
</nav>

<style>
  .mobile-nav {
    display: none;
  }

  @media (max-width: 640px) {
    .mobile-nav {
      display: flex;
      position: fixed;
      left: 12px;
      right: 12px;
      bottom: calc(10px + env(safe-area-inset-bottom));
      z-index: 150;
      justify-content: space-around;
      align-items: center;
      /* Сплошной белый вместо прежнего пастельного градиента с блюром (2026-09-04, по прямой
         просьбе пользователя — градиент перекрывал контент под собой и читался как визуальный
         мусор). Простой чистый фон + тонкая рамка, иконки/подписи контрастнее без полупрозрачности. */
      background: var(--color-paper);
      border: 1px solid #d7d5de;
      border-radius: var(--radius-card);
      box-shadow: var(--shadow-card-hover);
      padding: 9px 6px;
      transition: transform 0.38s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.28s ease;
      animation: nav-rise 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .mobile-nav.nav-hidden {
      transform: translateY(160%) scale(0.92);
      opacity: 0;
    }

    @keyframes nav-rise {
      from {
        opacity: 0;
        transform: translateY(28px) scale(0.94);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .mobile-nav {
        animation: none;
        transition: opacity 0.2s ease;
      }
      .mobile-nav.nav-hidden {
        transform: none;
      }
    }
  }

  .mobile-nav-item {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-decoration: none;
    color: var(--color-ink);
  }

  .mobile-nav-icon {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    color: var(--color-red);
    transition: transform 0.15s ease;
  }

  .mobile-nav-icon svg {
    width: 27px;
    height: 27px;
  }

  .mobile-nav-badge {
    position: absolute;
    top: -2px;
    right: -2px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: var(--radius-control);
    background: var(--color-red);
    color: #fff;
    font-size: 0.62rem;
    font-weight: 700;
    line-height: 16px;
    text-align: center;
    box-shadow: 0 0 0 2px #fff;
  }

  .mobile-nav-badge[hidden] {
    display: none;
  }

  .mobile-nav-label {
    font-family: var(--font-sans);
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1;
  }

  .mobile-nav-item:active .mobile-nav-icon {
    transform: scale(0.92);
  }
</style>

<script>
  // Скрытие/показ плашки по кастомным событиям — их шлёт PriceChecklist.astro при скролле списка
  // внутри открытого окна Каталог/Акции (дальше вниз по списку — прячем, назад к началу — показываем).
  const nav = document.querySelector<HTMLElement>('.mobile-nav');
  document.addEventListener('zilma:nav-hide', () => nav?.classList.add('nav-hidden'));
  document.addEventListener('zilma:nav-show', () => nav?.classList.remove('nav-hidden'));

  // Бейдж на «Корзине» — читает общее хранилище корзины (window.zilmaCart, localStorage,
  // см. CartStore.astro), поэтому теперь верно считает и на страницах статей, не только
  // на главной. Обновляется тем же событием zilma:cart-updated, что и сама корзина в OrderForm.astro.
  const cartBadge = document.getElementById('mobile-nav-cart-badge') as HTMLElement | null;
  function updateCartBadge() {
    if (!cartBadge) return;
    const items = (window as any).zilmaCart?.get() ?? [];
    const count = Array.isArray(items) ? items.length : 0;
    cartBadge.textContent = String(count);
    cartBadge.hidden = count === 0;
  }
  document.addEventListener('zilma:cart-updated', updateCartBadge);
  updateCartBadge();

  // Реальный баг с телефона (2026-08-28): со страницы статьи «Корзина» вела на /#order —
  // это полная перезагрузка на главную (с её большим херо-баннером) ради того, чтобы потом
  // проскроллить вниз к форме заказа. На самой же главной такой переход не нужен — там форма
  // уже на странице, и /#order — это мгновенный скролл без перезагрузки. Поэтому именно на
  // главной оставляем якорь, а с любой другой страницы (статьи и т.п.) ведём на лёгкую
  // страницу /order/ — без херо, без лишней перезагрузки-в-никуда.
  const cartLink = document.querySelector<HTMLAnchorElement>('[data-cart-link]');
  if (location.pathname === '/' && cartLink) {
    cartLink.href = '/#order';
  } else if (cartLink) {
    // Якорь #order убран: форма заявки теперь ПЕРВЫЙ блок на /order/ (переставлена
    // 2026-08-30), прыгать к ней больше некуда — страница и так открывается на ней.
    // А прыжок был виден как «дёрнулось и поехало» сразу после загрузки.
    cartLink.href = '/order/';
  }

  // «Инфо» больше НЕ перехватывается на /order/. Раньше там она делала history.back()
  // (задумка: человек жмёт её, чтобы вернуться откуда пришёл). На практике это читалось
  // как поломка — пользователь 2026-09-05: «на инфо из корзины не переходит, появляется
  // главный с херо». И правильно: пункт подписан «Инфо», значит должен вести в «Инфо»,
  // а «вернуться назад» — это кнопка «назад» самого браузера, она и так под рукой.

  // Каталог и Акции: если нужное окно есть НА ЭТОЙ странице — открываем его на месте,
  // без перехода. Раньше обе ссылки всегда вели на главную, и со страницы заявки это
  // выглядело так: мелькнула главная с логотипом, только потом открылось окно
  // (жалоба пользователя 2026-09-05). Клик отдаём существующей кнопке с data-open-modal,
  // а не открываем диалог сами: у неё уже есть вся логика открытия, дублировать её —
  // верный способ со временем получить два разных поведения.
  const LOCAL_TARGET: Record<string, string> = {
    '/#open-catalog': 'checklist-current-dialog',
    '/#open-promo': 'checklist-promo-dialog',
  };
  document.querySelectorAll<HTMLAnchorElement>('.mobile-nav a').forEach((link) => {
    const targetId = LOCAL_TARGET[link.getAttribute('href') ?? ''];
    if (!targetId) return;
    link.addEventListener('click', (e) => {
      if (!document.getElementById(targetId)) return;   // окна тут нет — обычный переход
      const trigger = document.querySelector<HTMLElement>(`[data-open-modal="${targetId}"]`);
      if (!trigger) return;
      e.preventDefault();
      trigger.click();
    });
  });

  /* Тап по разделу, в котором человек УЖЕ находится, не должен перезагружать страницу.
     Реальная жалоба 2026-09-05: «тап по главной и на долю исчезает навигация». В логе
     диагностики это видно как два «--- открыта / ---» подряд: человек стоял на главной,
     жал «Главная» и получал полную перезагрузку страницы весом 2.6 МБ. Плашка при этом
     пропадает вместе со старым документом — отсюда и «моргание».
     Ссылки с якорем (#order, #info, #open-catalog) не трогаем: они и так работают внутри
     страницы, без перезагрузки. */
  document.querySelectorAll<HTMLAnchorElement>('.mobile-nav a').forEach((link) => {
    const href = link.getAttribute('href') ?? '';
    if (href.includes('#')) return;
    link.addEventListener('click', (e) => {
      if (new URL(link.href).pathname !== location.pathname) return;   // другой раздел — обычный переход
      e.preventDefault();
      // Закрываем открытое окно каталога: тап по разделу, где ты стоишь, читается как
      // «вернуться к началу этого раздела», а не «оставить всё как есть».
      document.querySelectorAll<HTMLDialogElement>('dialog[open]').forEach((d) => d.close());

      // На главной повторяем её фирменный эффект — наверх к логотипу, а затем мягкий
      // доскролл к причинам и новости. Раньше он получался сам собой, потому что тап
      // перезагружал страницу; перезагрузку убрали, и эффект пришлось вызвать явно
      // (пользователь заметил пропажу сразу). На остальных страницах — просто наверх.
      const heroScroll = (window as any).zilmaHeroScroll;
      if (typeof heroScroll === 'function') heroScroll();
      else window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });

</script>
