---
// Плавающая нижняя плашка быстрой навигации — только на мобильных экранах (см. media query ниже).
// «Каталог»/«Акции» всегда ведут на главную с якорем-командой (#open-catalog / #open-promo) —
// именно там, и только там, гарантированно есть обе модалки (PriceChecklist.astro); открытие по
// этим якорям обрабатывает скрипт в PriceChecklist.astro (общий, страница-уровня).
---
<nav class="mobile-nav" aria-label="Быстрая навигация">
  <a href="/" class="mobile-nav-item">
    <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3 11.5 12 4l9 7.5" />
      <path d="M5.5 10v10.5h5V14h3v6.5h5V10" />
    </svg>
    <span>Главная</span>
  </a>
  <a href="/#open-catalog" class="mobile-nav-item">
    <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3.5" y="3.5" width="7.5" height="7.5" rx="1.2" />
      <rect x="13" y="3.5" width="7.5" height="7.5" rx="1.2" />
      <rect x="3.5" y="13" width="7.5" height="7.5" rx="1.2" />
      <rect x="13" y="13" width="7.5" height="7.5" rx="1.2" />
    </svg>
    <span>Каталог</span>
  </a>
  <a href="/#open-promo" class="mobile-nav-item">
    <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 2h7a2 2 0 0 1 2 2v7a2 2 0 0 1-.6 1.4l-8 8a2 2 0 0 1-2.8 0l-7-7a2 2 0 0 1 0-2.8l8-8A2 2 0 0 1 12 2Z" />
      <circle cx="16.5" cy="7.5" r="1.4" fill="currentColor" stroke="none" />
    </svg>
    <span>Акции</span>
  </a>
  <a href="/#info" class="mobile-nav-item">
    <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6 2.5h8.5L19 7v14.5H6Z" />
      <path d="M14.5 2.5V7H19" />
      <line x1="9" y1="13" x2="15.5" y2="13" />
      <line x1="9" y1="17" x2="15.5" y2="17" />
    </svg>
    <span>Инфо</span>
  </a>
</nav>

<style>
  .mobile-nav {
    display: none;
  }

  @media (max-width: 640px) {
    .mobile-nav {
      display: flex;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 150;
      justify-content: space-around;
      align-items: center;
      background: rgba(188, 216, 242, 0.86);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border-top: 1px solid var(--color-panel-line);
      box-shadow: 0 -6px 18px rgba(43, 32, 28, 0.1);
      padding: 7px 4px calc(7px + env(safe-area-inset-bottom));
    }
  }

  .mobile-nav-item {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    padding: 4px 2px;
    text-decoration: none;
    color: var(--color-ink);
  }

  .mobile-nav-item svg {
    color: var(--color-red);
    flex: none;
  }

  .mobile-nav-item span {
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1;
  }

  .mobile-nav-item:active {
    opacity: 0.7;
  }
</style>
