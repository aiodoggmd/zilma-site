---
// Единый синий акцент на весь раздел «Инфо» — установлено 2026-09-04 по прямой просьбе
// пользователя: «в прайсе акцент красный, в разделе инфо — синий». Отменяет прежнюю схему
// 2026-08-29, где каждая категория имела свой цвет (колористика синяя, уход красный, база
// знаний градиентом), а активная вкладка заливалась чёрным (--color-ink) — чёрного в палитре
// сайта нет, и разноцветные вкладки читались как разные сущности, а не как один фильтр.
interface Props {
  brands?: string[];
}
const { brands = [] } = Astro.props;

const tabs = [
  { key: 'all', label: 'Все' },
  { key: 'колористика', label: 'Колористика' },
  { key: 'уход и восстановление', label: 'Уход и восстановление' },
  { key: 'база знаний', label: 'База знаний' },
];
---
<div class="filter-bar">
  <div class="filter-tabs" id="filter-tabs">
    {tabs.map((t, i) => (
      <button type="button" class:list={['tab', { active: i === 0 }]} data-tag={t.key}>{t.label}</button>
    ))}
  </div>
  {brands.length > 1 && (
    <div class="filter-tabs brand-tabs" id="brand-tabs">
      <button type="button" class="tab brand active" data-brand="all">Все бренды</button>
      {brands.map((b) => (
        <button type="button" class="tab brand" data-brand={b}>{b}</button>
      ))}
    </div>
  )}
  <div class="search-box">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7" />
      <line x1="21" y1="21" x2="16.65" y2="16.65" />
    </svg>
    <input type="search" id="article-search" placeholder="Поиск по статьям…" aria-label="Поиск по статьям" />
  </div>
</div>

<style>
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin: 24px 0 8px;
  }

  .filter-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* flex-basis:100% в оборачивающемся flex-контейнере форсит перенос на новую строку — так
     ряд брендов всегда идёт отдельной строкой под категориями, а не втискивается между ними
     и строкой поиска по .filter-bar { justify-content: space-between }. */
  .brand-tabs {
    flex-basis: 100%;
  }

  /* Все вкладки раздела «Инфо» — один синий акцент: неактивная белая с приглушённым
     текстом, активная — мягкая пастельно-синяя подложка с синим текстом и рамкой.
     Заливок «в лоб» (чёрной/красной/синей с белым текстом) и градиентов больше нет. */
  .tab {
    background: var(--color-paper);
    border: 1.5px solid var(--color-panel-line);
    color: var(--color-meta);
    padding: 9px 18px;
    border-radius: 8px;
    font-size: 0.88rem;
    font-family: var(--font-sans);
    font-weight: 600;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }

  .tab.active {
    background: var(--color-pastel-blue);
    border-color: var(--color-blue-dark);
    color: var(--color-blue-dark);
  }

  .tab:hover:not(.active) {
    border-color: var(--color-blue);
    color: var(--color-blue-dark);
  }

  .tab.brand {
    font-size: 0.82rem;
    padding: 7px 14px;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--color-paper);
    border: 1px solid var(--color-panel-line);
    border-radius: 8px;
    padding: 9px 16px;
    color: var(--color-meta);
    flex: 1 1 220px;
    max-width: 280px;
  }

  .search-box svg {
    flex: none;
  }

  .search-box input {
    border: none;
    outline: none;
    background: none;
    font: inherit;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    color: var(--color-ink);
    width: 100%;
  }

  .search-box input::placeholder {
    color: var(--color-meta);
  }

  @media (max-width: 640px) {
    .search-box {
      max-width: none;
      flex-basis: 100%;
      order: 3;
    }

    /* Тот же приём, что для .checklist в [id].astro: flex-wrap на пилюлях разной ширины
       переносил их вразнобой (2+1+1) — ровная сетка 2 колонки выглядит аккуратнее. */
    .filter-tabs {
      width: 100%;
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .tab {
      width: 100%;
      text-align: center;
    }
  }
</style>

<script>
  const tabsEl = document.getElementById('filter-tabs');
  const brandTabsEl = document.getElementById('brand-tabs');
  const searchInput = document.getElementById('article-search') as HTMLInputElement | null;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-tags]'));

  let activeTag = 'all';
  let activeBrand = 'all';

  function normalize(s: string): string {
    return s.toLowerCase().trim();
  }

  function applyFilters() {
    const query = normalize(searchInput?.value ?? '');
    const tokens = query.split(/\s+/).filter(Boolean);

    cards.forEach((card) => {
      const tags = card.dataset.tags?.split(',') ?? [];
      const matchesTag = activeTag === 'all' || tags.includes(activeTag);
      const matchesBrand = activeBrand === 'all' || card.dataset.brand === activeBrand;
      const haystack = normalize(card.textContent ?? '');
      const matchesSearch = tokens.every((t) => haystack.includes(t));
      card.style.display = matchesTag && matchesBrand && matchesSearch ? '' : 'none';
    });
  }

  tabsEl?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.tab');
    if (!btn) return;
    tabsEl.querySelectorAll('.tab').forEach((t) => t.classList.remove('active'));
    btn.classList.add('active');
    activeTag = btn.dataset.tag ?? 'all';
    applyFilters();
  });

  brandTabsEl?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.tab');
    if (!btn) return;
    brandTabsEl.querySelectorAll('.tab').forEach((t) => t.classList.remove('active'));
    btn.classList.add('active');
    activeBrand = btn.dataset.brand ?? 'all';
    applyFilters();
  });

  searchInput?.addEventListener('input', applyFilters);
</script>
