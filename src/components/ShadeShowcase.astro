---
// Витрина оттенков на главной (2026-09-05).
//
// Зачем. Самое сильное, что есть на сайте — 355 оттенков с РЕАЛЬНЫМИ фото и живой ценой
// по прайсу — было спрятано внутри статей: узнать о нём можно было, только открыв гид.
// На главной об этом не говорилось ничего, а четыре причины в херо («актуальный прайс»,
// «быстрая доставка») может написать любой поставщик. Этот блок показывает отличие, а не
// рассказывает о нём.
//
// Что показываем. Настоящие вырезанные фото свотчей из официальных карт брендов, только
// те оттенки, что реально есть в прайсе. Никаких «примеров цвета» и плашек-заглушек:
// каждый кружок — конкретный товар, который можно заказать.
import priceItems from '../data/priceItems.json';

type Shade = { code: string; hex?: string; image?: string; name?: string };
const shadeModules = import.meta.glob<{ default: Shade[] }>('../data/*-shades.json', { eager: true });

// Только палитры с уже написанным гидом — кружок ведёт в статью, а обещать статью,
// которой нет, нельзя (та же оговорка, что и у плашек «Гид» в каталоге).
const PALETTE_ARTICLE: Record<string, string> = {
  illumina: '2026-08-13-illumina-color',
  shinefinity: '2026-08-13-shinefinity',
  koleston: '2026-08-13-koleston-perfect',
  colortouch: '2026-08-13-color-touch',
  'igora-royal': '2026-08-28-igora-royal',
  londa: '2026-08-29-londa-professional',
  'londa-demi': '2026-08-29-londa-professional',
  colortune: '2026-08-30-londa-color-tune',
};

const inPrice = new Set(priceItems.map((i) => i.name));

type Tile = { code: string; image: string; hex: string; article: string; lum: number };
const pool: Tile[] = [];
for (const [path, mod] of Object.entries(shadeModules)) {
  const file = path.split('/').pop()?.replace('-shades.json', '') ?? '';
  const article = PALETTE_ARTICLE[file];
  if (!article) continue;
  for (const s of mod.default) {
    if (!s.image || !s.name || !inPrice.has(s.name)) continue;
    const hex = s.hex ?? '#cccccc';
    const r = parseInt(hex.slice(1, 3), 16) || 0;
    const g = parseInt(hex.slice(3, 5), 16) || 0;
    const b = parseInt(hex.slice(5, 7), 16) || 0;
    pool.push({ code: s.code, image: s.image, hex, article, lum: 0.299 * r + 0.587 * g + 0.114 * b });
  }
}

const totalShades = pool.length;

// Раскладка от светлых к тёмным — так это читается как настоящая карта глубин, а не
// как случайная россыпь кружков. Берём равномерную выборку по всей шкале, чтобы в ряду
// были и блонды, и тёмные, а не 40 соседних оттенков одной глубины.
pool.sort((a, b) => b.lum - a.lum);
const SHOWN = 44;
const step = Math.max(1, Math.floor(pool.length / SHOWN));
const tiles = Array.from({ length: Math.min(SHOWN, pool.length) }, (_, i) => pool[i * step]).filter(Boolean);

const lines = new Set(Object.values(PALETTE_ARTICLE)).size;

// Русское склонение по числу: «355 оттенков», но «22 оттенка» и «41 оттенок».
function plural(n: number, one: string, few: string, many: string): string {
  const n10 = n % 10;
  const n100 = n % 100;
  if (n10 === 1 && n100 !== 11) return one;
  if (n10 >= 2 && n10 <= 4 && (n100 < 12 || n100 > 14)) return few;
  return many;
}
const shadesWord = plural(totalShades, 'оттенок', 'оттенка', 'оттенков');
const linesWord = plural(lines, 'линейке', 'линейкам', 'линейкам');
---
<section class="showcase" aria-labelledby="showcase-title">
  <div class="showcase-head">
    <p class="showcase-kicker">Подобрать оттенок</p>
    <h2 id="showcase-title">{totalShades} {shadesWord} с реальным фото и ценой</h2>
    <p class="showcase-lede">
      Не выкраска на экране, а вырезанные фото из официальных карт брендов.
      Нажмите на любой — увидите номер, цену по актуальному прайсу и сможете сразу
      добавить в заявку.
    </p>
  </div>

  <div class="swatch-wall">
    {tiles.map((t) => (
      <a
        class="swatch"
        href={`/articles/${t.article}/#палитра-оттенков`}
        style={`background:${t.hex}`}
        title={`Оттенок ${t.code}`}
        aria-label={`Оттенок ${t.code} — открыть палитру`}
      >
        <img src={t.image} alt="" loading="lazy" decoding="async" width="60" height="60" />
        <span class="swatch-code">{t.code}</span>
      </a>
    ))}
  </div>

  <p class="showcase-note">
    Палитры собраны по {lines} {linesWord}. Цена и наличие подтягиваются из того же прайса,
    что и каталог — оттенка нет в наличии, и в палитре он честно помечен серым.
  </p>
</section>

<style>
  .showcase {
    margin: 48px 0 8px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .showcase-head {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 62ch;
  }

  .showcase-kicker {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-blue-dark);
  }

  .showcase h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 3.2vw, 2rem);
    line-height: 1.15;
    color: var(--color-ink);
  }

  .showcase-lede {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-meta);
  }

  /* Стена оттенков. Плотная сетка без зазоров-«окон»: так она читается как единая
     выкладка, а не как набор отдельных значков. Кружки — потому что фото свотчей
     вырезаны круглыми, той же формы, что в палитрах статей и в каталоге. */
  .swatch-wall {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(56px, 1fr));
    gap: 10px;
  }

  .swatch {
    position: relative;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    text-decoration: none;
    box-shadow: var(--shadow-card);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .swatch img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Номер оттенка появляется при наведении: на 44 кружках сразу он превратил бы стену
     в мелкий нечитаемый текст, а без него не понять, что это не декоративные точки. */
  .swatch-code {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    color: #fff;
    background: rgba(43, 32, 28, 0.55);
    opacity: 0;
    transition: opacity 0.18s ease;
  }

  .swatch:hover,
  .swatch:focus-visible {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card-hover);
  }

  .swatch:hover .swatch-code,
  .swatch:focus-visible .swatch-code {
    opacity: 1;
  }

  .showcase-note {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--color-meta);
    max-width: 68ch;
  }

  @media (max-width: 640px) {
    .showcase {
      margin-top: 34px;
      gap: 14px;
    }

    .swatch-wall {
      grid-template-columns: repeat(auto-fill, minmax(44px, 1fr));
      gap: 8px;
    }

    /* На телефоне наведения нет — номер показываем сразу, иначе кружки выглядят
       декорацией и непонятно, что за ними стоит конкретный товар. */
    .swatch-code {
      opacity: 1;
      font-size: 0.6rem;
      background: rgba(43, 32, 28, 0.4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .swatch,
    .swatch-code {
      transition: none;
    }
    .swatch:hover {
      transform: none;
    }
  }
</style>
