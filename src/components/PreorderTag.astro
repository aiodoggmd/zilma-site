---
// Пометка «под заказ» — ОДНО место на весь сайт.
//
// Зачем отдельным компонентом: строка товара в PriceChecklist.astro отрисовывается в
// пяти местах (по бренду, по линейке, акции, поиск, категории). Вписать пометку пять
// раз — гарантия, что однажды они разойдутся: где-то останется старый текст, где-то
// другой цвет. Правка срока поставки тоже должна быть одной.
//
// Цвет СЕРЫЙ, не оранжевый — решение обсуждалось 21.09.2026: «под заказ» у 575 позиций
// из 667, то есть у большинства. Оранжевый на большинстве карточек превращается в
// тревожный фон и перестаёт читаться, а серый остаётся спокойной технической пометкой
// и не спорит с обводкой «нет в наличии» в палитрах оттенков.
interface Props {
  leadTime?: string;
  compact?: boolean;   // в узких местах (палитра оттенков) — только точка и слово
}
const { leadTime, compact = false } = Astro.props;
---

<span class="preorder-tag" class:list={[{ compact }]}>
  <span class="preorder-dot" aria-hidden="true"></span>
  <span>под заказ</span>
  {!compact && leadTime && <span class="preorder-lead">· {leadTime}</span>}
</span>

<!-- Стили — в src/styles/global.css: эту же разметку создаёт скрипт палитры
     оттенков, где scoped-классы компонента не работают. -->
