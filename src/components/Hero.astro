---
---
<section class="hero">
  <div class="bg-blue"></div>
  <div class="container hero-inner">
    <div class="hero-text">
      <h1>Профессиональная косметика для салонов</h1>
      <p class="brands">Wella · Londa · Schwarzkopf · Matrix · Lebel</p>
      <p class="subtitle">Актуальный прайс и гиды по оттенкам и подбором под руку мастера.</p>
    </div>
    <div class="hero-art">
      <div class="halo"></div>
      <div class="bubble">
        <img src="/images/logo.jpg" alt="Zilma" class="hero-logo" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--color-red);
    padding: 44px 0;
    overflow: hidden;
  }

  .bg-blue {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--color-blue-dark), var(--color-blue));
    opacity: 0;
    animation: bg-fade-in 1.1s ease-in-out 1.3s forwards;
    z-index: 0;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    min-height: 200px;
  }

  .hero-text {
    max-width: 560px;
    color: var(--color-cream);
  }

  .hero-text h1 {
    font-family: var(--font-serif);
    font-size: clamp(1.7rem, 3.2vw, 2.5rem);
    line-height: 1.15;
    margin: 0 0 14px;
    font-weight: 600;
  }

  .brands {
    margin: 0 0 8px;
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-cream);
  }

  .subtitle {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-cream);
    opacity: 0.88;
  }

  .hero-art {
    position: relative;
    flex-shrink: 0;
    width: clamp(170px, 22vw, 260px);
    aspect-ratio: 1;
    perspective: 900px;
  }

  .halo {
    position: absolute;
    inset: -9%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.92) 0%, rgba(255, 255, 255, 0.28) 34%, rgba(255, 255, 255, 0) 56%);
    opacity: 0;
    animation: halo-in 1.1s ease-out 1.3s forwards;
    z-index: 0;
  }

  .bubble {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 0 0 6px rgba(250, 243, 234, 0.32), 0 20px 40px rgba(0, 0, 0, 0.35);
    animation: coin-flip 1.2s cubic-bezier(0.4, 0.2, 0.2, 1) forwards;
  }

  .hero-logo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    animation: zilma-wipe 2.1s cubic-bezier(0.25, 0.7, 0.3, 1) 2.4s forwards;
  }

  @keyframes coin-flip {
    from {
      transform: rotateY(0deg);
    }
    to {
      transform: rotateY(360deg);
    }
  }

  @keyframes bg-fade-in {
    to {
      opacity: 1;
    }
  }

  @keyframes halo-in {
    to {
      opacity: 1;
    }
  }

  @keyframes zilma-wipe {
    from {
      -webkit-mask-image: linear-gradient(100deg, transparent 0%, transparent 42%, black 58%, black 100%);
      mask-image: linear-gradient(100deg, transparent 0%, transparent 42%, black 58%, black 100%);
      -webkit-mask-size: 320% 100%;
      mask-size: 320% 100%;
      -webkit-mask-position: 0% 0;
      mask-position: 0% 0;
    }
    to {
      -webkit-mask-image: linear-gradient(100deg, transparent 0%, transparent 42%, black 58%, black 100%);
      mask-image: linear-gradient(100deg, transparent 0%, transparent 42%, black 58%, black 100%);
      -webkit-mask-size: 320% 100%;
      mask-size: 320% 100%;
      -webkit-mask-position: 100% 0;
      mask-position: 100% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bg-blue,
    .halo {
      animation: none;
      opacity: 1;
    }
    .bubble {
      animation: none;
    }
    .hero-logo {
      animation: none;
    }
  }

  @media (max-width: 720px) {
    .hero-inner {
      flex-direction: column;
      text-align: center;
      min-height: auto;
    }
    .hero-text {
      max-width: 100%;
    }
  }
</style>
