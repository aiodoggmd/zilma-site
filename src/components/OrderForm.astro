---
interface Props {
  // framed — используется в сетке рядом с price-card (главная страница), где форма должна
  // выглядеть таким же цельным блоком с рамкой/тенью, а не отдельным заголовком над своей мини-рамкой.
  framed?: boolean;
}
const { framed = false } = Astro.props;
---
<section class:list={['order-form', { framed }]} id="order">
  <div class="order-panel">
    <div class="order-panel-body">
      <h2>Оформить заявку</h2>
      <p class="desc">Осталось оставить контакт — и заявка уйдёт.</p>
      <form id="order-form-el" novalidate>
        {/* Телефон ПЕРВЫМ, имя вторым (порядок задан пользователем 2026-09-05): телефон —
            то, без чего заявку не обработать, имя лишь помогает обратиться. Оба в одну
            строку — экономит высоту в пользу корзины. */}
        <div class="row">
          {/* Подсказка укорочена с «Телефон, например +7 999 123-45-67»: в паре с именем
              на одной строке длинная не помещалась и обрезалась на середине. Формат всё
              равно виден, а если человек введёт не номер — об этом скажет .contact-warning. */}
          <input type="text" name="contact" placeholder="Телефон +7 999…" required maxlength="200" autocomplete="tel" inputmode="tel" title="Телефон, например +7 999 123-45-67" />
          <input type="text" name="name" placeholder="Имя" required maxlength="200" autocomplete="name" />
        </div>
        <p class="contact-warning" id="contact-warning" hidden>Похоже, это не номер телефона — укажите номер, по которому можно связаться.</p>
        {/* Подпись и кнопки в одну строку, кнопки — иконками вместо слов (правка пользователя).
            «Чат» вместо «мессенджер»: короче и понятнее тем, кто про VPN и слово «мессенджер»
            не думает — та же причина, по которой из плейсхолдера телефона убрали «Telegram».
            Иконки те же, что в контактах блока прайса, чтобы значки на сайте не разъезжались.
            У MAX официальной иконки нет — ставим буквенный знак в том же круге, а не рисуем
            похожий на настоящий логотип. Название остаётся в aria-label и title: без текста
            кнопка должна оставаться понятной и скринридеру, и по наведению. */}
        <div class="messenger-group">
          <span class="messenger-label">Удобный чат</span>
          <div class="messenger-chips" id="messenger-chips">
            <button type="button" class="chip" data-messenger="Telegram" aria-label="Telegram" title="Telegram">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 2 11 13 M22 2 15 22 11 13 2 9 22 2Z" />
              </svg>
            </button>
            <button type="button" class="chip" data-messenger="WhatsApp" aria-label="WhatsApp" title="WhatsApp">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <path d="M12 21a9 9 0 1 0-7.6-4.2L3 21l4.4-1.3A9 9 0 0 0 12 21Z" />
                <path
                  transform="translate(6.3,5.3) scale(0.56)"
                  fill="currentColor"
                  stroke="none"
                  d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8Z"
                />
              </svg>
            </button>
            <button type="button" class="chip chip-lettermark" data-messenger="MAX" aria-label="MAX" title="MAX">MAX</button>
            <button type="button" class="chip" data-messenger="Bip" aria-label="Bip" title="Bip">
              <svg viewBox="0 0 100 100" width="21" height="21" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="46" cy="44" r="38" />
                <path d="M66 76 L82 82 L74 64" />
                <line x1="24" y1="24" x2="24" y2="62" />
                <circle cx="32" cy="54" r="11" />
                <circle cx="46" cy="27" r="2.3" fill="currentColor" stroke="none" />
                <line x1="46" y1="35" x2="46" y2="62" />
                <line x1="62" y1="35" x2="62" y2="74" />
                <circle cx="70" cy="54" r="11" />
              </svg>
            </button>
          </div>
        </div>
        {/* rows=1 + авторост (см. initCommentAutogrow): поле начинается с одной строки и
            растёт под текст. Раньше три пустые строки занимали высоту всегда, даже когда
            комментарий никто не писал, — а он необязательный. */}
        <textarea name="comment" placeholder="Комментарий (необязательно)" rows="1"></textarea>
        <input type="hidden" name="messenger" />
        <input type="hidden" name="items_json" />
        <input type="hidden" name="form_rendered_at" />

        <!-- Honeypot: реальный посетитель это поле не видит и не заполняет, спам-боты
             обычно заполняют все поля подряд — заполненное значение выдаёт бота. -->
        <div class="hp-wrap" aria-hidden="true">
          <label for="hp-field">Оставьте это поле пустым</label>
          <input type="text" id="hp-field" name="hp_field" tabindex="-1" autocomplete="off" />
        </div>

        <div class="cart" id="order-cart" hidden>
          <span class="cart-label">Выбранные товары</span>
          {/* Обёртка нужна только под затухание у нижнего края (см. .cart-list-wrap::after):
              сам список прокручивается, а тень на него не повесить — она уехала бы вместе
              с содержимым. Класс is-scrollable ставит renderCart, когда строки не влезли. */}
          <div class="cart-list-wrap">
            <ul class="cart-list" id="cart-list"></ul>
          </div>
          <div class="cart-total" id="cart-total"></div>
          {/* Шкала до минимального заказа. Раньше про минимум в 5 000 ₽ человек узнавал
              только в конце — кнопка просто не нажималась. Теперь видно с первого товара,
              сколько осталось: это и честнее, и заметно понятнее, чем запрет постфактум. */}
          <div class="min-progress" id="min-progress" hidden>
            <div class="min-bar"><span class="min-fill" id="min-fill"></span></div>
            <p class="min-text" id="min-text"></p>
          </div>
        </div>

        {/* ЗДЕСЬ БЫЛ резерв высоты под строки корзины — инлайн-скрипт заранее показывал
            блок и занимал место, чтобы товары не «падали» в форму, сдвигая её.
            УБРАН 2026-09-05 в тот же день: на реальном телефоне вышло хуже, чем было.
            Страница каталога весит больше мегабайта, модульный скрипт со строками
            выполняется через заметное время после разбора — и всё это время человек
            видел большую пустую серую коробку с подписью «Выбранные товары» (скриншот
            пользователя). Небольшой сдвиг при появлении строк честнее, чем пустая
            коробка на несколько секунд: сдвиг длится один кадр, коробка — пока грузится.
            Урок: приём, который выглядит выигрышно на быстрой машине, надо оценивать
            на медленной — там он может ровно перевернуться. */}

        <label class="file-drop" id="file-drop" for="attachment-input" title="Фото, скриншот или документ, до 4 МБ. Можно перетащить файл сюда.">
          <input type="file" name="attachment" id="attachment-input" accept="image/*,.pdf,.doc,.docx,.xls,.xlsx" />
          <svg class="file-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 11.5 12.5 20a5 5 0 0 1-7-7l8.5-8.5a3.3 3.3 0 0 1 4.7 4.7l-8.5 8.5a1.7 1.7 0 0 1-2.4-2.4l7.9-7.9" />
          </svg>
          {/* Одна короткая строка вместо двух (правка пользователя 2026-09-05). Формат файла
              и лимит в 4 МБ ушли в title: это подробности для тех немногих, кто до них дойдёт,
              а место на экране нужно корзине. Перетаскивание работает как работало — просто
              больше не описывается словами, на телефоне его всё равно нет. */}
          <span class="file-hint" id="file-hint">Прикрепить файл</span>
          <span class="file-picked" id="file-picked" hidden>
            <span id="file-picked-name"></span>
            <button type="button" id="file-remove" aria-label="Убрать файл">✕</button>
          </span>
        </label>

        <div class="submit-row">
          <button type="submit" disabled>Отправить заявку</button>
          <span class="status" role="status" aria-live="polite"></span>
        </div>
      </form>
    </div>
    <p class="order-note">Доставка по Москве бесплатно — на следующий рабочий день (пн–пт) после подтверждения заказа. В регионы — СДЭК или ваша ТК. Минимальный заказ 5 000 ₽.</p>
  </div>
</section>

<style>
  .order-form {
    max-width: 640px;
    margin: 0 auto;
    padding: 32px 0;
  }

  .order-form.framed {
    max-width: none;
    margin: 0;
    padding: 0;
    height: 100%;
  }

  .order-panel {
    height: 100%;
  }

  .hp-wrap {
    position: absolute;
    left: -9999px;
    top: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .order-panel-body {
    display: flex;
    flex-direction: column;
  }

  .order-form.framed .order-panel {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-paper);
    /* Красной полосы сверху больше нет (правка пользователя 2026-09-05) — рядом стоит
       карточка прайса с обычной рамкой, и полоса выбивалась из пары. */
    border: 1px solid var(--color-card-line);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .order-form.framed .order-panel-body {
    flex: 1;
    padding: 26px 30px 18px;
  }

  .order-note {
    margin: 0;
    border-top: 1px solid var(--color-panel-line);
    background: var(--color-paper);
    padding: 14px 30px;
    min-height: 90px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    line-height: 1.5;
    color: #5c5049;
    text-align: center;
  }

  .order-form.framed form {
    flex: 1;
    border: none;
    box-shadow: none;
    padding: 0;
    background: transparent;
  }

  h2 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.4rem;
    margin: 0 0 6px;
    color: var(--color-ink);
    text-align: center;
  }

  .desc {
    margin: 0 0 14px;
    text-align: center;
    color: #5c5049;
    font-size: 0.95rem;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: var(--color-paper);
    border: 1px solid var(--color-panel-line);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    padding: 24px;
  }

  /* Телефон и имя всегда в одну строку, в том числе на телефоне (правка пользователя
     2026-09-05). Раньше строка переносилась из-за `min-width: 200px` у полей — на 390px
     два поля по 200 не помещались. Здесь min-width снят, а телефону дана бОльшая доля:
     номер длиннее имени, делить пополам было бы неверно. */
  .row {
    display: flex;
    gap: 12px;
    flex-wrap: nowrap;
  }

  .row input[type='text'] {
    min-width: 0;
  }

  .row input[name='contact'] {
    flex: 1.45;
  }

  .row input[name='name'] {
    flex: 1;
  }

  /* Ниже 360px одна строка перестаёт работать: телефону остаётся ~119px, а подсказке
     «Телефон +7 999…» нужно 159px — она обрезалась бы на середине (замерено, не на глаз).
     Такие экраны сегодня редкость, поэтому там честнее вернуть две строки, чем показать
     огрызок подсказки в поле, где важен формат ввода. */
  @media (max-width: 359px) {
    .row {
      flex-wrap: wrap;
    }
    .row input[name='contact'],
    .row input[name='name'] {
      flex: 1 1 100%;
    }
  }

  /* Подпись и кнопки в ОДНУ строку (правка пользователя 2026-09-05) — отдельная строка
     под подпись съедала высоту, которая нужнее корзине. */
  .messenger-group {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .messenger-label {
    flex: none;
    font-size: 0.82rem;
    color: #5c5049;
  }

  .messenger-chips {
    display: flex;
    flex-wrap: nowrap;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .messenger-chips::-webkit-scrollbar {
    display: none;
  }

  /* Кнопка-иконка вместо кнопки-слова. Квадрат со стороной 38px — палец попадает,
     и четыре штуки помещаются в строку рядом с подписью даже на 320px. */
  .chip {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--color-panel-line);
    background: #fff;
    color: var(--color-ink);
    padding: 0;
    border-radius: var(--radius-control);
    font-family: var(--font-sans);
    cursor: pointer;
    box-shadow: none;
    transition: all 0.2s ease;
  }

  /* У MAX официальной иконки нет — буквенный знак в том же круге. Рисовать похожий
     на настоящий логотип нельзя: это чужой знак, а выдуманный вводит в заблуждение. */
  .chip-lettermark {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  @media (max-width: 420px) {
    .chip {
      width: 34px;
      height: 34px;
    }
    .chip-lettermark {
      font-size: 0.56rem;
    }
    .messenger-chips {
      gap: 6px;
    }
  }

  .chip:hover {
    border-color: var(--color-blue-dark);
  }

  .chip.active {
    background: var(--color-blue-dark);
    border-color: var(--color-blue-dark);
    color: #fff;
  }

  input[type='text'], textarea {
    flex: 1;
    min-width: 200px;
    font: inherit;
    font-size: 0.95rem;
    padding: 12px 14px;
    border: 1px solid var(--color-panel-line);
    border-radius: var(--radius-card);
    background: #fff;
    color: var(--color-ink);
  }

  /* Поле растёт под текст (см. initCommentAutogrow), поэтому ручную «резинку» убрали:
     две системы изменения высоты на одном поле мешают друг другу — после ручного
     растягивания авторост сбрасывал бы высоту при первом же вводе.
     Потолок: дальше поле прокручивается само, чтобы длинный комментарий не выдавил
     корзину вниз — ради неё эту компоновку и собирали. */
  textarea {
    /* flex: none обязателен. Общее правило `input, textarea { flex: 1 }` писалось под
       .row — горизонтальную пару полей. Но форма выложена колонкой, и в ней flex:1
       означает «расти/сжиматься по вертикали»: высота, которую ставит авторост, молча
       игнорировалась, поле замирало на min-height (замерено: inline height был 100px,
       computed оставался 46px). */
    flex: none;
    resize: none;
    min-height: 46px;
    max-height: 150px;
    overflow-y: auto;
  }

  input:focus, textarea:focus {
    outline: 2px solid var(--color-blue-dark);
    outline-offset: 1px;
  }

  /* Компактная строка вместо блока с пунктирной рамкой (правка пользователя 2026-09-05):
     опция нужна — клиенты присылают заказ фотографией списка или скриншотом, — но занимала
     высоту как полноценный блок. Рамка убрана, отступы урезаны: выглядит как действие,
     а не как ещё одна зона ввода. Область перетаскивания это не меняет — она по-прежнему
     весь label, просто он теперь ниже. */
  .file-drop {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 4px 2px;
    font-size: 0.82rem;
    color: var(--color-blue-dark);
    cursor: pointer;
    border-radius: var(--radius-control);
    transition: color 0.2s ease, background 0.2s ease;
  }

  .file-icon {
    flex: none;
  }

  .file-drop:hover {
    color: var(--color-blue);
  }

  /* При перетаскивании подсветка нужна заметная — человек должен видеть, куда бросает. */
  .file-drop.drag-over {
    background: rgba(56, 98, 140, 0.09);
    outline: 1.5px dashed var(--color-blue-dark);
    outline-offset: 2px;
  }

  .file-drop input[type='file'] {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    overflow: hidden;
  }

  .file-picked {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    color: var(--color-ink);
  }

  .file-picked[hidden] {
    display: none;
  }

  .file-picked button {
    background: none;
    border: none;
    color: #5c5049;
    cursor: pointer;
    font-size: 0.95rem;
    padding: 0 4px;
    box-shadow: none;
  }

  .file-picked button:hover { color: var(--color-red); filter: none; }

  .submit-row {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  button {
    background: var(--color-blue-dark);
    color: #fff;
    border: none;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 12px 26px;
    border-radius: var(--radius-card);
    cursor: pointer;
    box-shadow: var(--shadow-sm);
    transition: filter 0.2s ease, background 0.2s ease, color 0.2s ease;
  }

  button:hover { filter: brightness(1.1); }
  button:disabled {
    background: var(--color-pastel-blue);
    color: var(--color-blue-dark);
    opacity: 1;
    cursor: default;
  }

  .status {
    font-size: 0.9rem;
  }

  .status.ok { color: var(--color-blue-dark); }
  .status.err { color: var(--color-red); }

  .cart {
    display: flex;
    flex-direction: column;
    gap: 8px;
    border: 1px solid var(--color-panel-line);
    border-radius: var(--radius-card);
    background: var(--color-mist);
    padding: 12px 14px;
  }

  .cart[hidden] {
    display: none;
  }

  .cart-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: #5c5049;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  /* Список ВСЕГДА со своим скроллом и фиксированным потолком высоты — правка пользователя
     2026-09-05: «отключи флексибельность корзины и верни скролл внутри».
     Причина: без потолка блок заявки растёт вместе с числом позиций (замерено: секция
     572px при пустой корзине против 860px при шести товарах), а соседняя карточка прайса
     тянется за ним и получает пустоту в пол-экрана — композиция рассыпается.
     Раньше здесь было исключение для телефона (max-height:none) — снято. Проблему,
     ради которой его вводили (обрезанная посередине строка выглядела как оборванный
     список), решает затухание ниже, а не отключение скролла. */
  .cart-list-wrap {
    position: relative;
  }

  .cart-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    /* 300px вместо 180px: форму собрали компактнее (телефон+имя в строку, чаты иконками
       в одну строку с подписью, комментарий с авторостом, файл одной строкой) — примерно
       сто освободившихся пикселей отданы сюда, ради чего компоновку и переделывали.
       Отдать их можно было только после того, как карточка прайса перестала тянуться за
       высотой формы: до этого рост формы означал дыру в соседней карточке. */
    max-height: 300px;
    overflow-y: auto;
  }

  /* Затухание у нижнего края — только когда строки реально не влезли (класс ставит
     renderCart). Строки разной высоты: длинное имя переносится на две, поэтому «ровная»
     обрезка по границе строки невозможна в принципе — вместо этого делаем полустроку
     осмысленной: видно, что список продолжается. */
  .cart-list-wrap.is-scrollable::after {
    content: '';
    position: absolute;
    left: 0;
    right: 12px;
    bottom: 0;
    height: 28px;
    background: linear-gradient(to bottom, transparent, var(--surface-flat, #fff));
    pointer-events: none;
  }

  /* Шкала до минимального заказа. Красная, пока не набрано, синяя — когда набрано.
     Зелёный тут был моей вольностью и пользователь его убрал: в палитре сайта его нет,
     а красный и синий — и есть фирменный акцент, они же и читаются как два состояния.
     Не вводить сюда «сигнальные» цвета (зелёный/жёлтый) под предлогом статуса. */
  .min-progress {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 4px;
  }

  /* Свой display перебивает браузерный [hidden], поэтому скрытие нужно писать явно.
     Пока это ни на что не влияло — при пустой корзине скрыт весь блок .cart, — но стоит
     ему когда-нибудь стать видимым, шкала «осталось 5 000 ₽» вылезла бы на пустой заявке. */
  .min-progress[hidden] {
    display: none;
  }

  .min-bar {
    height: 6px;
    border-radius: 3px;
    background: var(--color-panel-line);
    overflow: hidden;
  }

  .min-fill {
    display: block;
    height: 100%;
    width: 0;
    border-radius: 3px;
    background: var(--color-red);
    transition: width 0.35s ease, background-color 0.35s ease;
  }

  .min-progress[data-done='1'] .min-fill {
    background: var(--color-blue-dark);
  }

  .min-text {
    margin: 0;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-red);
  }

  .min-progress[data-done='1'] .min-text {
    color: var(--color-blue-dark);
  }

  @media (prefers-reduced-motion: reduce) {
    .min-fill {
      transition: none;
    }
  }

  .cart-total {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-red);
    border-top: 1px solid var(--color-panel-line);
    padding-top: 8px;
  }

  /* Итог стоит НАД полосой и по смыслу — часть той же шкалы, поэтому цвет состояния
     держит вместе с ней: красный, пока не набрано, синий — когда набрано. Оба комбинатора
     прямые (`>`), чтобы правило не проваливалось вглубь при росте вложенности корзины. */
  .cart:has(> .min-progress[data-done='1']) > .cart-total {
    color: var(--color-blue-dark);
  }

  /* .cart-warning убран: разметки с таким классом в компоненте нет — предупреждение о
     минимальном заказе теперь несёт .min-text внутри шкалы. Правило осталось от прежней
     версии и красило пустоту (замечание куратора курса как раз про такой мёртвый CSS). */

  .contact-warning {
    margin: -6px 0 0;
    font-size: 0.82rem;
    color: var(--color-red);
  }
</style>

<!--
  Отдельный is:global блок: строки корзины (.cart-item и всё внутри) создаются в script'е
  через document.createElement, а не в разметке компонента — Astro не может проскоупить
  их атрибутом data-astro-cid, поэтому обычный <style> здесь их бы просто не находил.
-->
<style is:global>
  .cart-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.88rem;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-panel-line);
  }

  .cart-item:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .cart-item-name {
    color: var(--color-ink);
  }

  .cart-item-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .cart-item-price {
    flex: none;
    min-width: 0;
    color: #5c5049;
    white-space: nowrap;
  }

  .cart-item-qty {
    flex: none;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .cart-item-sq-btn {
    width: 24px;
    height: 24px;
    box-sizing: border-box;
    border-radius: 6px;
    border: 1px solid var(--color-panel-line);
    background: #fff;
    color: var(--color-ink);
    font-size: 0.8rem;
    line-height: 1;
    cursor: pointer;
    padding: 0;
    box-shadow: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cart-item-sq-btn:hover {
    background: var(--color-surface-pink);
    filter: none;
  }

  .cart-item-sq-btn.cart-item-remove {
    color: var(--color-red);
    border-color: var(--color-red);
  }

  .cart-item-sq-btn.cart-item-remove:hover {
    background: var(--color-red);
    color: #fff;
  }

  .cart-item-qty-input {
    width: 24px;
    min-width: 24px;
    height: 24px;
    box-sizing: border-box;
    text-align: center;
    font: inherit;
    font-size: 0.85rem;
    border: 1px solid var(--color-panel-line);
    border-radius: 6px;
    padding: 0 2px;
    color: var(--color-ink);
    background: #fff;
    -moz-appearance: textfield;
  }

  .cart-item-qty-input::-webkit-outer-spin-button,
  .cart-item-qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
</style>

<script>
  import { MIN_ORDER_TOTAL } from '../lib/order-rules';

  const MAX_FILE_BYTES = 4 * 1024 * 1024;
  // Условие «Минимальный заказ 5 000 ₽» и так было написано в .order-note, но сумма корзины
  // реально не проверялась — можно было отправить заявку хоть пустой (реальный случай,
  // 2026-08-31: заявка пришла с именем и телефоном, без единого товара). Само число теперь
  // живёт в src/lib/order-rules.ts — его же читает полоса прогресса в шапке каталога и на
  // страницах статей. Осталось одно ручное место: текст «5 000 ₽» в .order-note выше по файлу.

  // Сумма без копеечного хвоста и с пробелом между тысячами: «осталось 1 470 ₽» читается
  // с одного взгляда, а «1470.00 ₽» приходится разбирать. Округляем ВВЕРХ — иначе при
  // остатке 0,4 ₽ показали бы «осталось 0 ₽», а кнопка всё ещё была бы заблокирована.
  function formatMoney(value: number): string {
    return Math.ceil(value).toLocaleString('ru-RU');
  }

  const form = document.getElementById('order-form-el') as HTMLFormElement | null;
  const statusEl = form?.querySelector('.status') as HTMLElement | null;
  const button = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;
  const nameInput = form?.querySelector<HTMLInputElement>('input[name="name"]');
  const contactInput = form?.querySelector<HTMLInputElement>('input[name="contact"]');
  const minProgressEl = document.getElementById('min-progress') as HTMLElement | null;
  const minFillEl = document.getElementById('min-fill') as HTMLElement | null;
  const minTextEl = document.getElementById('min-text') as HTMLElement | null;
  const contactWarningEl = document.getElementById('contact-warning') as HTMLElement | null;

  // Реальный случай (2026-09-02): в поле «Телефон» пришло «Трубина» (фамилия) — заявку
  // физически не с кем связаться. Поле само по себе принимало любой текст без проверки.
  // Считаем цифры, а не парсим формат целиком — так проходит любой реальный номер
  // (с +7/8, пробелами, скобками, дефисами), но не проходит текст без единой цифры.
  function looksLikePhone(value: string): boolean {
    return (value.match(/\d/g) ?? []).length >= 10;
  }

  // Метка времени рендера формы — сервер сверяет её с моментом отправки (см. api/order.ts):
  // отправка быстрее пары секунд после загрузки страницы человеку физически не под силу.
  const renderedAtInput = form?.querySelector<HTMLInputElement>('input[name="form_rendered_at"]');
  if (renderedAtInput) renderedAtInput.value = String(Date.now());

  // Кнопка серая/неактивна, пока не заполнены обязательные поля или сумма корзины меньше
  // минимального заказа — тот же приём, что у «Добавить в заявку» в прайсе.
  function updateSubmitState() {
    if (!button) return;
    const contactValue = contactInput?.value.trim() ?? '';
    const hasName = !!nameInput?.value.trim();
    const contactValid = !!contactValue && looksLikePhone(contactValue);
    const total = readCartItems().reduce((s, it) => s + it.price * it.qty, 0);
    const meetsMin = total >= MIN_ORDER_TOTAL;
    button.disabled = !(hasName && contactValid && meetsMin);

    if (contactWarningEl) {
      contactWarningEl.hidden = !contactValue || contactValid;
    }

    // Шкала показывается, как только в заявке появился хотя бы один товар: до этого
    // говорить «осталось 5 000 ₽» бессмысленно, там ещё нечего измерять.
    if (minProgressEl && minFillEl && minTextEl) {
      minProgressEl.hidden = total <= 0;
      const pct = Math.max(0, Math.min(100, (total / MIN_ORDER_TOTAL) * 100));
      minFillEl.style.width = `${pct}%`;
      minProgressEl.dataset.done = meetsMin ? '1' : '0';
      minTextEl.textContent = meetsMin
        ? 'Минимальный заказ набран — можно отправлять'
        : `До минимального заказа осталось ${formatMoney(MIN_ORDER_TOTAL - total)} ₽`;
    }
  }

  interface CartItem {
    name: string;
    price: number;
    qty: number;
    brand: string;
    promo: boolean;
  }

  // Корзина — список товаров, отмеченных в окнах Каталог/Акции (PriceChecklist.astro пишет их
  // в items_json и шлёт событие zilma:cart-updated, сюда же — сам виджет заявки, это последний
  // шаг оформления, тут и должно быть видно, что именно заказывается, с возможностью убрать позицию.
  const itemsInput = form?.querySelector<HTMLInputElement>('input[name="items_json"]');
  const cartEl = document.getElementById('order-cart') as HTMLElement | null;
  const cartList = document.getElementById('cart-list') as HTMLElement | null;
  const cartTotal = document.getElementById('cart-total') as HTMLElement | null;

  // Название товара в 1С обычно заканчивается артикулом (одним числом или парой через "/") —
  // в узкой карточке заявки это слипается с ценой в нечитаемую кашу из цифр, поэтому в корзине
  // показываем название без него. В items_json и в самой заявке артикул остаётся как есть.
  function stripArticle(name: string): string {
    return name.replace(/\s+\d{3,8}(?:\/\d{3,8})?\.?$/, '').trim();
  }

  // Поле кол-ва по умолчанию — тот же квадрат 24×24, что у соседних кнопок, расширяется
  // только когда цифр становится больше, чем помещается в квадрат (2-3 цифры).
  function sizeQtyInput(input: HTMLInputElement) {
    const len = String(input.value).length;
    input.style.width = len <= 1 ? '24px' : `${len + 1}ch`;
  }

  // Корзина живёт в localStorage (window.zilmaCart, см. CartStore.astro) — переживает переход
  // между страницами (напр. клик по образцу оттенка в статье, потом заявка на главной).
  // Скрытое поле items_json здесь остаётся только как источник данных для самой отправки формы —
  // синхронизируется из хранилища при каждом изменении, но больше не источник правды само по себе.
  function readCartItems(): CartItem[] {
    return (window as any).zilmaCart?.get() ?? [];
  }

  function writeCartItems(items: CartItem[]) {
    (window as any).zilmaCart?.set(items);
  }

  function syncHiddenInputFromStore() {
    const items = readCartItems();
    if (itemsInput) itemsInput.value = items.length ? JSON.stringify(items) : '';
  }

  function renderCart() {
    if (!cartEl || !cartList || !cartTotal) return;
    const items = readCartItems();
    if (!items.length) {
      cartEl.hidden = true;
      cartList.replaceChildren();
      // Снимаем затухание вместе со строками: иначе класс переживает опустошение корзины
      // и вернётся уже неуместным, когда блок покажут снова с одной позицией.
      cartList.parentElement?.classList.remove('is-scrollable');
      return;
    }
    cartEl.hidden = false;
    cartList.replaceChildren(
      ...items.map((it, i) => {
        const displayName = stripArticle(it.name);
        const li = document.createElement('li');
        li.className = 'cart-item';
        const nameEl = document.createElement('span');
        nameEl.className = 'cart-item-name';
        nameEl.textContent = displayName;
        const priceEl = document.createElement('span');
        priceEl.className = 'cart-item-price';
        priceEl.textContent = `${it.price.toFixed(2)} ₽`;

        const qtyBox = document.createElement('div');
        qtyBox.className = 'cart-item-qty';
        const qtyInput = document.createElement('input');
        qtyInput.type = 'number';
        qtyInput.className = 'cart-item-qty-input';
        qtyInput.min = '1';
        qtyInput.max = '999';
        qtyInput.inputMode = 'numeric';
        qtyInput.value = String(it.qty);
        qtyInput.dataset.index = String(i);
        qtyInput.setAttribute('aria-label', `Количество «${displayName}»`);
        sizeQtyInput(qtyInput);
        qtyInput.addEventListener('input', () => sizeQtyInput(qtyInput));

        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'cart-item-sq-btn cart-item-remove';
        removeBtn.dataset.index = String(i);
        removeBtn.setAttribute('aria-label', `Убрать «${displayName}»`);
        removeBtn.textContent = '✕';

        const plusBtn = document.createElement('button');
        plusBtn.type = 'button';
        plusBtn.className = 'cart-item-sq-btn';
        plusBtn.dataset.index = String(i);
        plusBtn.dataset.dir = '1';
        plusBtn.setAttribute('aria-label', 'Больше');
        plusBtn.textContent = '+';

        const minusBtn = document.createElement('button');
        minusBtn.type = 'button';
        minusBtn.className = 'cart-item-sq-btn';
        minusBtn.dataset.index = String(i);
        minusBtn.dataset.dir = '-1';
        minusBtn.setAttribute('aria-label', 'Меньше');
        minusBtn.textContent = '−';

        qtyBox.append(qtyInput, removeBtn, plusBtn, minusBtn);

        const controlsRow = document.createElement('div');
        controlsRow.className = 'cart-item-controls';
        controlsRow.append(priceEl, qtyBox);

        li.append(nameEl, controlsRow);
        return li;
      })
    );
    const total = items.reduce((s, it) => s + it.price * it.qty, 0);
    cartTotal.textContent = `Выбрано товаров: ${items.length}, на сумму ${total.toFixed(2)} ₽`;

    // Затухание у нижнего края — только когда список реально не влез. Считаем ПОСЛЕ
    // вставки строк и в следующем кадре: до отрисовки scrollHeight ещё равен clientHeight,
    // и подсказка не появилась бы там, где она как раз нужна.
    requestAnimationFrame(() => {
      const wrap = cartList.parentElement;
      if (!wrap) return;
      wrap.classList.toggle('is-scrollable', cartList.scrollHeight > cartList.clientHeight + 2);
    });
  }

  function setQty(idx: number, qty: number) {
    const items = readCartItems();
    if (!items[idx]) return;
    items[idx].qty = Math.max(1, Math.min(999, Math.round(qty) || 1));
    writeCartItems(items);
  }

  cartList?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const removeBtn = target.closest<HTMLButtonElement>('.cart-item-remove');
    if (removeBtn) {
      const idx = Number(removeBtn.dataset.index);
      const items = readCartItems();
      items.splice(idx, 1);
      writeCartItems(items);
      return;
    }
    const qtyBtn = target.closest<HTMLButtonElement>('.cart-item-sq-btn:not(.cart-item-remove)');
    if (qtyBtn) {
      const idx = Number(qtyBtn.dataset.index);
      const dir = Number(qtyBtn.dataset.dir) || 0;
      const items = readCartItems();
      setQty(idx, (items[idx]?.qty ?? 1) + dir);
    }
  });

  cartList?.addEventListener('change', (e) => {
    const input = (e.target as HTMLElement).closest<HTMLInputElement>('.cart-item-qty-input');
    if (!input) return;
    setQty(Number(input.dataset.index), parseInt(input.value, 10));
  });

  document.addEventListener('zilma:cart-updated', () => {
    syncHiddenInputFromStore();
    renderCart();
    updateSubmitState();
  });
  // Хранилище могло быть заполнено ещё до загрузки этой страницы (напр. добавили товар
  // на странице статьи) — синхронизируем сразу при открытии, не дожидаясь события.
  syncHiddenInputFromStore();
  renderCart();
  nameInput?.addEventListener('input', updateSubmitState);
  contactInput?.addEventListener('input', updateSubmitState);
  updateSubmitState();

  // Комментарий начинается с одной строки и растёт под текст. Порядок важен: сначала
  // сбросить height, иначе scrollHeight вернёт прежнюю (уже растянутую) высоту и поле
  // будет только расти, никогда не сжимаясь при удалении текста.
  function initCommentAutogrow() {
    const ta = document.querySelector<HTMLTextAreaElement>('textarea[name="comment"]');
    if (!ta) return;
    const fit = () => {
      ta.style.height = 'auto';
      ta.style.height = `${ta.scrollHeight}px`;
    };
    ta.addEventListener('input', fit);
    fit();
  }
  initCommentAutogrow();

  // Чипы мессенджера — необязательный одиночный выбор, повторный клик по активному снимает выбор.
  const messengerChips = document.getElementById('messenger-chips');
  const messengerInput = form?.querySelector<HTMLInputElement>('input[name="messenger"]');
  messengerChips?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.chip');
    if (!btn || !messengerInput) return;
    const alreadyActive = btn.classList.contains('active');
    messengerChips.querySelectorAll('.chip').forEach((c) => c.classList.remove('active'));
    if (alreadyActive) {
      messengerInput.value = '';
    } else {
      btn.classList.add('active');
      messengerInput.value = btn.dataset.messenger ?? '';
    }
  });
  const dropzone = document.getElementById('file-drop') as HTMLLabelElement | null;
  const fileInput = document.getElementById('attachment-input') as HTMLInputElement | null;
  const fileHint = document.getElementById('file-hint') as HTMLElement | null;
  const filePicked = document.getElementById('file-picked') as HTMLElement | null;
  const filePickedName = document.getElementById('file-picked-name') as HTMLElement | null;
  const fileRemoveBtn = document.getElementById('file-remove') as HTMLButtonElement | null;

  function refreshFileUi() {
    const f = fileInput?.files?.[0];
    if (f && fileHint && filePicked && filePickedName) {
      fileHint.hidden = true;
      filePicked.hidden = false;
      filePickedName.textContent = `${f.name} (${(f.size / 1024 / 1024).toFixed(1)} МБ)`;
    } else if (fileHint && filePicked) {
      fileHint.hidden = false;
      filePicked.hidden = true;
    }
  }

  function setFile(f: File | null) {
    if (!fileInput) return;
    const dt = new DataTransfer();
    if (f) dt.items.add(f);
    fileInput.files = dt.files;
    refreshFileUi();
  }

  fileInput?.addEventListener('change', refreshFileUi);

  fileRemoveBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    setFile(null);
  });

  ['dragover', 'dragenter'].forEach((evt) =>
    dropzone?.addEventListener(evt, (e) => {
      e.preventDefault();
      dropzone.classList.add('drag-over');
    })
  );
  ['dragleave', 'drop'].forEach((evt) =>
    dropzone?.addEventListener(evt, (e) => {
      e.preventDefault();
      dropzone.classList.remove('drag-over');
    })
  );
  dropzone?.addEventListener('drop', (e) => {
    const f = (e as DragEvent).dataTransfer?.files?.[0];
    if (f) setFile(f);
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!statusEl || !button) return;

    const f = fileInput?.files?.[0];
    if (f && f.size > MAX_FILE_BYTES) {
      statusEl.textContent = 'Файл слишком большой — максимум 4 МБ.';
      statusEl.className = 'status err';
      return;
    }

    button.disabled = true;
    statusEl.textContent = 'Отправляю…';
    statusEl.className = 'status';

    const errorMessages: Record<string, string> = {
      missing_fields: 'Заполните имя и контакт.',
      too_long: 'Имя или контакт слишком длинные.',
      file_too_large: 'Файл слишком большой — максимум 4 МБ.',
      file_type_invalid: 'Этот файл не похож на фото, PDF или документ Word/Excel — прикрепите другой.',
      server_not_configured: 'Форма временно не работает — напишите в Telegram/WhatsApp напрямую.',
      telegram_failed: 'Не получилось отправить — напишите в Telegram/WhatsApp напрямую.',
      rate_limited: 'Слишком много попыток отправки — подождите немного и попробуйте снова.',
    };

    try {
      const res = await fetch('/api/order', {
        method: 'POST',
        body: new FormData(form),
      });
      if (!res.ok) {
        let code = '';
        try {
          code = (await res.json())?.error ?? '';
        } catch {}
        throw new Error(errorMessages[code] ?? 'Не получилось отправить — напишите в Telegram/WhatsApp напрямую.');
      }
      statusEl.textContent = 'Заявка отправлена, спасибо!';
      statusEl.className = 'status ok';
      form.reset();
      setFile(null);
      messengerChips?.querySelectorAll('.chip').forEach((c) => c.classList.remove('active'));
      (window as any).zilmaCart?.set([]);
    } catch (err) {
      statusEl.textContent = err instanceof Error ? err.message : 'Не получилось отправить — напишите в Telegram/WhatsApp напрямую.';
      statusEl.className = 'status err';
    } finally {
      updateSubmitState();
    }
  });
</script>
