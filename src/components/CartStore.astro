---
// Общее хранилище корзины — localStorage вместо скрытого поля формы, чтобы заявка,
// собранная на любой странице (напр. клик по образцу оттенка в статье), не терялась
// при переходе на главную. Подключается в BaseLayout.astro ДО остального контента
// страницы (важно: другие скрипты на этой же странице читают window.zilmaCart при
// загрузке, модульные скрипты выполняются по порядку появления в HTML).
// Все места, что раньше писали/читали items_json напрямую (OrderForm.astro,
// PriceChecklist.astro, MobileNavBar.astro, ShadeSwatchGrid.astro), теперь ходят
// через window.zilmaCart.get()/.set() — единственный источник правды.
//
// Корзина живёт ограниченное время (TTL), а не бессрочно — иначе клиент, который
// один раз что-то выбрал (напр. потыкал палитру), а потом зашёл на сайт заново через
// день/неделю оформлять СОВСЕМ ДРУГОЙ заказ, рискует не заметить старые позиции в
// заявке и отправить лишнее (реальный кейс, поймано пользователем 2026-08-27).
---
<script is:inline>
  (function () {
    var KEY = 'zilma-cart';
    /* Корзина БОЛЬШЕ НЕ СТИРАЕТСЯ через 6 часов — изменено 12.09.2026 по реальному случаю.
       Клиентка собирала заказ вечером, вернулась утром и получила пустую заявку: «Всё
       слетело!!!». Бросила сайт и прислала заказ текстом в Telegram. Шесть часов не
       переживают одну ночь, а собрать заказ за два захода — обычное дело.

       Исходная задача никуда не делась: клиент, вернувшийся через неделю за СОВСЕМ другим
       заказом, не должен молча отправить забытые позиции. Но решается она предупреждением,
       а не удалением чужой работы. Старая корзина возвращается как есть, а форма заявки
       показывает, когда она собрана, и просит проверить состав (см. age() ниже). */
    var MAX_AGE_MS = 30 * 24 * 60 * 60 * 1000; // месяц — дальше это уже не «тот же заказ»
    var STALE_MS = 6 * 60 * 60 * 1000;         // старше — показываем предупреждение

    function read() {
      try {
        var raw = localStorage.getItem(KEY);
        if (!raw) return null;
        var parsed = JSON.parse(raw);
        if (!parsed || !Array.isArray(parsed.items)) return null;
        var age = Date.now() - (parsed.updatedAt || 0);
        if (age > MAX_AGE_MS) {
          localStorage.removeItem(KEY);
          return null;
        }
        return { items: parsed.items, updatedAt: parsed.updatedAt || 0, age: age };
      } catch (e) {
        return null;
      }
    }

    function get() {
      var r = read();
      return r ? r.items : [];
    }

    /* Возраст корзины — для предупреждения в форме заявки. null, если корзина пуста. */
    function age() {
      var r = read();
      if (!r || !r.items.length) return null;
      return { updatedAt: r.updatedAt, ms: r.age, stale: r.age > STALE_MS };
    }

    function set(items) {
      try {
        localStorage.setItem(KEY, JSON.stringify({ items: items || [], updatedAt: Date.now() }));
      } catch (e) {}
      document.dispatchEvent(new CustomEvent('zilma:cart-updated'));
    }

    window.zilmaCart = { get: get, set: set, age: age };

    // История отправленных заявок — для строки «Повторить прошлый заказ» (в каталоге и в
    // форме заявки). Отдельный ключ и намного больший срок жизни, чем у корзины: корзина
    // живёт 6 часов, потому что забытая корзина превращается в случайный лишний заказ;
    // история сама ничего не заказывает — её нужно нажать, поэтому пусть переживёт
    // месяц-другой между закупками.
    //
    // Хранится РОВНО ОДНА, последняя заявка — решение пользователя 2026-09-07. Список
    // прошлых заказов — это уже личный кабинет, а на телефоне он ещё и занимал бы экран
    // строкой на каждый заказ. Показывается всё равно только последняя, поэтому и хранить
    // остальные незачем.
    var HKEY = 'zilma-orders';
    var HISTORY_TTL_MS = 180 * 24 * 60 * 60 * 1000; // полгода
    var HISTORY_MAX = 1;

    function historyList() {
      try {
        var raw = localStorage.getItem(HKEY);
        if (!raw) return [];
        var parsed = JSON.parse(raw);
        if (!Array.isArray(parsed)) return [];
        var now = Date.now();
        return parsed.filter(function (o) {
          return o && Array.isArray(o.items) && o.items.length && now - (o.at || 0) < HISTORY_TTL_MS;
        });
      } catch (e) {
        return [];
      }
    }

    function remember(items) {
      if (!items || !items.length) return;
      try {
        var list = historyList();
        list.unshift({ at: Date.now(), items: items });
        localStorage.setItem(HKEY, JSON.stringify(list.slice(0, HISTORY_MAX)));
      } catch (e) {}
    }

    window.zilmaOrders = { list: historyList, remember: remember };
  })();
</script>
