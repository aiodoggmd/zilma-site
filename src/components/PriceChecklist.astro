---
interface Item {
  id: number;
  brand: string | null;
  line: string | null;
  name: string;
  price: number;
  promo: boolean;
  oldPrice?: number;
  discountPct?: number;
  isNew?: boolean;
}

interface Props {
  items: Item[];
  instanceId: string;
  heading: string;
  // 'discount' — верхний уровень группировки не бренд, а ступень скидки (15%/7%),
  // бренд становится вложенным уровнем внутри. Только для окна «Акции».
  groupBy?: 'brand' | 'discount';
}

const { items, instanceId, heading, groupBy = 'brand' } = Astro.props;
const dialogId = `${instanceId}-dialog`;

// Сортировка: сначала латиница (A-Z), потом кириллица (А-Я), внутри каждой — по алфавиту.
function scriptRank(s: string): number {
  const ch = s.trim().charAt(0);
  if (/[A-Za-z]/.test(ch)) return 0;
  if (/[А-Яа-яЁё]/.test(ch)) return 1;
  return 2;
}
function alphaCompare(a: string, b: string): number {
  const ra = scriptRank(a);
  const rb = scriptRank(b);
  if (ra !== rb) return ra - rb;
  return a.localeCompare(b, ra === 0 ? 'en' : 'ru', { sensitivity: 'base' });
}

// Двухуровневая группировка: бренд (напр. WELLA) -> линейка внутри бренда (напр. EIMI) -> товары.
// Пустой ключ '' — товары без линейки, показываются плоским списком прямо под брендом.
const brandMap = new Map<string, Map<string, Item[]>>();
for (const it of items) {
  const b = it.brand ?? 'Другое';
  const l = it.line ?? '';
  if (!brandMap.has(b)) brandMap.set(b, new Map());
  const lineMap = brandMap.get(b)!;
  if (!lineMap.has(l)) lineMap.set(l, []);
  lineMap.get(l)!.push(it);
}

const byName = (a: Item, b: Item) => alphaCompare(a.name, b.name);

const brandEntries = [...brandMap.entries()]
  .sort((a, b) => alphaCompare(a[0], b[0]))
  .map(([brand, lineMap]) => {
    const flat = [...(lineMap.get('') ?? [])].sort(byName);
    const lineEntries = [...lineMap.entries()]
      .filter(([l]) => l !== '')
      .sort((a, b) => alphaCompare(a[0], b[0]))
      .map(([line, list]) => [line, [...list].sort(byName)] as [string, Item[]]);
    const total = [...lineMap.values()].reduce((s, arr) => s + arr.length, 0);
    return { brand, total, flat, lineEntries };
  });

function pluralItems(n: number): string {
  const mod10 = n % 10;
  const mod100 = n % 100;
  if (mod100 >= 11 && mod100 <= 14) return 'товаров';
  if (mod10 === 1) return 'товар';
  if (mod10 >= 2 && mod10 <= 4) return 'товара';
  return 'товаров';
}

// «Популярные бренды» — не топ-4 по количеству позиций (так туда попадал бы, например, OLLIN
// просто за счёт объёма прайса), а флагманские бренды Zilma — те же, что в подзаголовке хиро
// на главной («Wella · Londa · Schwarzkopf · Matrix · Lebel»). Показываем, только если брендов
// реально много (иначе блок-ярлык на 4 из 5 бессмысленен).
const PREFERRED_POPULAR_BRANDS = ['WELLA', 'LONDA', 'SCHWARZKOPF', 'MATRIX'];
const brandByName = new Map(brandEntries.map((b) => [b.brand, b]));
const popularBrands = groupBy === 'brand' && brandEntries.length > 5
  ? PREFERRED_POPULAR_BRANDS.map((name) => brandByName.get(name)).filter((b): b is (typeof brandEntries)[number] => Boolean(b))
  : [];

// Группировка по ступени скидки (15%/7%) -> бренд -> товары — только для окна «Акции».
// Ступени идут в фиксированном порядке (большая скидка первой), а не по алфавиту.
const DISCOUNT_TIER_ORDER = [15, 7];
function discountTierLabel(pct: number | undefined): string {
  return pct != null ? `Скидка ${pct}%` : 'Акция';
}

let discountEntries: { tier: string; total: number; brandEntries: [string, Item[]][] }[] = [];
if (groupBy === 'discount') {
  const tierMap = new Map<string, Map<string, Item[]>>();
  for (const it of items) {
    const tier = discountTierLabel(it.discountPct);
    const b = it.brand ?? 'Другое';
    if (!tierMap.has(tier)) tierMap.set(tier, new Map());
    const bMap = tierMap.get(tier)!;
    if (!bMap.has(b)) bMap.set(b, []);
    bMap.get(b)!.push(it);
  }
  discountEntries = [...tierMap.entries()]
    .sort((a, b) => {
      const ia = DISCOUNT_TIER_ORDER.indexOf(parseInt(a[0].replace(/\D/g, ''), 10));
      const ib = DISCOUNT_TIER_ORDER.indexOf(parseInt(b[0].replace(/\D/g, ''), 10));
      if (ia !== -1 || ib !== -1) return (ia === -1 ? 999 : ia) - (ib === -1 ? 999 : ib);
      return alphaCompare(a[0], b[0]);
    })
    .map(([tier, bMap]) => {
      const total = [...bMap.values()].reduce((s, arr) => s + arr.length, 0);
      const brandEntriesForTier = [...bMap.entries()]
        .sort((a, b) => alphaCompare(a[0], b[0]))
        .map(([brand, list]) => [brand, [...list].sort(byName)] as [string, Item[]]);
      return { tier, total, brandEntries: brandEntriesForTier };
    });
}
---
<dialog class="price-checklist" data-checklist data-group-by={groupBy} id={dialogId}>
  <div class="pc-header">
    <h3 class="pc-header-logo">{heading}</h3>
    <a href="/order/#order" class="pc-cart-link" data-cart-link aria-label="Перейти в заявку">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 8V6a3 3 0 0 1 6 0v2" />
        <path d="M6 8h12l1.3 12.2a2 2 0 0 1-2 2.3H6.7a2 2 0 0 1-2-2.3L6 8Z" />
      </svg>
      <span class="pc-cart-badge" data-cart-badge hidden>0</span>
    </a>
  </div>
  <div class="pc-controls">
    <button type="button" class="pc-back" data-back-to-folders aria-label="Назад к списку папок">←</button>
    <div class="pc-search-wrap">
      <svg class="pc-search-icon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7" />
        <line x1="21" y1="21" x2="16.65" y2="16.65" />
      </svg>
      <input type="search" class="pc-search" placeholder="Поиск по товару, бренду или линейке…" aria-label="Поиск по прайсу" />
    </div>
    <span class="pc-count" data-count></span>
  </div>
  <p class="pc-search-hint">Например: Koleston 7/0, Londa, шампунь…</p>
  <div class="pc-groups">
    {popularBrands.length > 0 && (
      <div class="pc-popular">
        <p class="pc-popular-title">Популярные</p>
        <div class="pc-popular-grid">
          {popularBrands.map(({ brand, total }) => (
            <button type="button" class="pc-popular-card" data-jump-to-brand={brand}>
              <span class="pc-popular-name">{brand}</span>
              <span class="pc-popular-count">{total} {pluralItems(total)}</span>
            </button>
          ))}
        </div>
        <a href="/#open-promo" class="pc-promo-banner" data-open-promo-from-catalog>
          <span class="pc-promo-banner-title">Больше выгодных предложений</span>
          <span class="pc-promo-banner-sub">Специальные скидки при заказе через сайт</span>
          <span class="pc-promo-banner-arrow" aria-hidden="true">→</span>
        </a>
        <p class="pc-all-title">Все бренды</p>
      </div>
    )}
    {groupBy === 'brand' && brandEntries.map(({ brand, total, flat, lineEntries }) => (
      <details class="pc-group pc-group-brand" data-brand={brand}>
        <summary>{brand} <span class="pc-group-count">{total} {pluralItems(total)}</span></summary>
        <div class="pc-group-body">
          {flat.length > 0 && (
            <ul>
              {flat.map((it) => (
                <li class:list={['pc-item', { 'pc-promo': it.promo }]} data-name={it.name.toLowerCase()} data-brand={brand.toLowerCase()} data-line="">
                  <label>
                    <input type="checkbox" class="pc-check" data-name={it.name} data-price={it.price} data-brand-label={brand} data-promo={it.promo ? '1' : ''} />
                    <span class="pc-item-name">{it.name}</span>
                    <span class="pc-item-price">
                      {it.promo && it.oldPrice != null && <span class="pc-old-price">{it.oldPrice} ₽</span>}
                      <b class="pc-price-now">{it.price} ₽</b>
                      {(it.promo || it.isNew) && (
                        <span class="pc-badges">
                          {it.promo && <span class="pc-badge">Акция</span>}
                          {it.isNew && <span class="pc-badge pc-badge-new">Нов</span>}
                        </span>
                      )}
                    </span>
                  </label>
                  <div class="pc-qty">
                    <button type="button" class="pc-qty-btn" data-qty-dir="-1" aria-label="Меньше">−</button>
                    <input type="number" class="pc-qty-input" value="1" min="1" max="999" inputmode="numeric" aria-label="Количество" />
                    <button type="button" class="pc-qty-btn" data-qty-dir="1" aria-label="Больше">+</button>
                  </div>
                </li>
              ))}
            </ul>
          )}
          {lineEntries.map(([line, list]) => (
            <details class="pc-group pc-group-line">
              <summary>{line} <span class="pc-group-count">{list.length} {pluralItems(list.length)}</span></summary>
              <ul>
                {list.map((it) => (
                  <li class:list={['pc-item', { 'pc-promo': it.promo }]} data-name={it.name.toLowerCase()} data-brand={brand.toLowerCase()} data-line={line.toLowerCase()}>
                    <label>
                      <input type="checkbox" class="pc-check" data-name={it.name} data-price={it.price} data-brand-label={brand} data-promo={it.promo ? '1' : ''} />
                      <span class="pc-item-name">{it.name}</span>
                      <span class="pc-item-price">
                        {it.promo && it.oldPrice != null && <span class="pc-old-price">{it.oldPrice} ₽</span>}
                        <b class="pc-price-now">{it.price} ₽</b>
                        {(it.promo || it.isNew) && (
                          <span class="pc-badges">
                            {it.promo && <span class="pc-badge">Акция</span>}
                            {it.isNew && <span class="pc-badge pc-badge-new">Нов</span>}
                          </span>
                        )}
                      </span>
                    </label>
                    <div class="pc-qty">
                      <button type="button" class="pc-qty-btn" data-qty-dir="-1" aria-label="Меньше">−</button>
                      <input type="number" class="pc-qty-input" value="1" min="1" max="999" inputmode="numeric" aria-label="Количество" />
                      <button type="button" class="pc-qty-btn" data-qty-dir="1" aria-label="Больше">+</button>
                    </div>
                  </li>
                ))}
              </ul>
            </details>
          ))}
        </div>
      </details>
    ))}
    {groupBy === 'discount' && discountEntries.map(({ tier, total, brandEntries: tierBrandEntries }) => (
      <details class:list={['pc-group', 'pc-group-brand', { 'pc-tier-15': tier === 'Скидка 15%', 'pc-tier-7': tier === 'Скидка 7%' }]}>
        <summary>{tier} <span class="pc-group-count">{total} {pluralItems(total)}</span></summary>
        <div class="pc-group-body">
          {tierBrandEntries.map(([brand, list]) => (
            <details class="pc-group pc-group-line">
              <summary>{brand} <span class="pc-group-count">{list.length} {pluralItems(list.length)}</span></summary>
              <ul>
                {list.map((it) => (
                  <li class:list={['pc-item', { 'pc-promo': it.promo }]} data-name={it.name.toLowerCase()} data-brand={brand.toLowerCase()} data-line="">
                    <label>
                      <input type="checkbox" class="pc-check" data-name={it.name} data-price={it.price} data-brand-label={brand} data-promo={it.promo ? '1' : ''} />
                      <span class="pc-item-name">{it.name}</span>
                      <span class="pc-item-price">
                        {it.promo && it.oldPrice != null && <span class="pc-old-price">{it.oldPrice} ₽</span>}
                        <b class="pc-price-now">{it.price} ₽</b>
                        {(it.promo || it.isNew) && (
                          <span class="pc-badges">
                            {it.promo && <span class="pc-badge">Акция</span>}
                            {it.isNew && <span class="pc-badge pc-badge-new">Нов</span>}
                          </span>
                        )}
                      </span>
                    </label>
                    <div class="pc-qty">
                      <button type="button" class="pc-qty-btn" data-qty-dir="-1" aria-label="Меньше">−</button>
                      <input type="number" class="pc-qty-input" value="1" min="1" max="999" inputmode="numeric" aria-label="Количество" />
                      <button type="button" class="pc-qty-btn" data-qty-dir="1" aria-label="Больше">+</button>
                    </div>
                  </li>
                ))}
              </ul>
            </details>
          ))}
        </div>
      </details>
    ))}
    <p class="pc-no-results" hidden>Ничего не найдено — попробуйте другой запрос.</p>
  </div>
</dialog>

<style>
  .price-checklist:not([open]) {
    display: none;
  }

  .price-checklist {
    position: fixed;
    inset: 0;
    margin: auto;
    z-index: 140;
    padding: 0;
    border: none;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card-hover);
    width: 92vw;
    max-width: 720px;
    height: 84vh;
    max-height: 84vh;
    display: flex;
    flex-direction: column;
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .price-checklist::backdrop {
    background: rgba(43, 32, 28, 0.55);
  }

  .pc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 18px;
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-panel-line);
    flex: none;
  }

  .pc-header h3 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.15rem;
    margin: 0;
    color: var(--color-ink);
  }

  /* Заголовок-заглушка по умолчанию — логотип-надпись «ZILMA» по центру шапки (тот же дух,
     что настоящий лого-файл, но текстом и в красном под белый фон каталога). Как только
     открыт конкретный бренд, JS убирает этот класс и подставляет обычное тёмное имя бренда. */
  .pc-header h3.pc-header-logo {
    flex: 1;
    text-align: center;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.14em;
    color: var(--color-red);
  }

  .pc-cart-link {
    position: relative;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: transparent;
    color: var(--color-ink);
  }

  .pc-cart-link:hover {
    color: var(--color-blue-dark);
  }

  .pc-cart-badge {
    position: absolute;
    top: -2px;
    right: -2px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 999px;
    background: var(--color-red);
    color: #fff;
    font-size: 0.62rem;
    font-weight: 700;
    line-height: 16px;
    text-align: center;
    box-shadow: 0 0 0 2px var(--color-paper);
  }

  .pc-cart-badge[hidden] {
    display: none;
  }

  .pc-controls {
    flex: none;
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-panel-line);
    padding: 14px 18px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .pc-back {
    flex: none;
    font: inherit;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-ink);
    background: var(--color-paper);
    border: 1px solid #d7d5de;
    box-shadow: var(--shadow-sm);
    border-radius: 50%;
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    white-space: nowrap;
  }

  .pc-back:hover {
    color: var(--color-blue-dark);
  }

  .pc-search-wrap {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
  }

  .pc-search-icon {
    position: absolute;
    left: 14px;
    color: var(--color-meta);
    pointer-events: none;
  }

  .pc-search {
    width: 100%;
    font: inherit;
    font-size: 0.85rem;
    padding: 10px 14px 10px 38px;
    border: 1px solid #d7d5de;
    border-radius: 999px;
    background: var(--color-paper);
    color: var(--color-ink);
    box-shadow: var(--shadow-sm);
  }

  .pc-search::placeholder {
    color: var(--color-meta);
    opacity: 1;
  }

  .pc-search:focus {
    outline: 2px solid var(--color-blue-dark);
    outline-offset: 1px;
  }

  .pc-count {
    font-size: 0.85rem;
    color: #5c5049;
    white-space: nowrap;
  }

  .pc-search-hint {
    margin: 0;
    padding: 0 18px 10px;
    font-size: 0.76rem;
    color: #8a7f7a;
    flex: none;
    background: var(--color-paper);
  }

  /* Во время поиска подсказка-пример становится лишней (сама строка ввода уже занята). */
  .price-checklist:has(.pc-search:not(:placeholder-shown)) .pc-search-hint {
    display: none;
  }

  .pc-groups {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 12px 14px 14px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    align-content: start;
  }

  /* Пока идёт поиск — обычный список в один столбец (могут совпасть сразу
     несколько папок/линеек, карточная сетка с "прячем не открытое" сюда не подходит). */
  .price-checklist:has(.pc-search:not(:placeholder-shown)) .pc-groups {
    display: block;
  }

  .pc-group-brand {
    background: var(--color-blue-dark);
    border: 1px solid var(--color-blue-dark);
    border-radius: 10px;
  }

  /* Плоский список товаров прямо в открытой карточке бренда (без вложенных линеек) —
     свой белый "лист", иначе тёмный текст товаров потеряется на синем/красном фоне карточки. */
  .pc-group-brand > .pc-group-body > ul {
    background: var(--color-paper);
    border: 1px solid var(--color-panel-line);
    border-radius: 8px;
  }

  .price-checklist:has(.pc-search:not(:placeholder-shown)) .pc-group-brand {
    margin-bottom: 8px;
  }

  .pc-group-brand[open] {
    grid-column: 1 / -1;
    background: var(--color-paper);
    border-color: var(--color-paper);
  }

  .pc-group-brand[open] > summary {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    gap: 6px;
    color: #fff;
    background: var(--color-blue-dark);
    border-radius: 999px;
    padding: 8px 16px;
    margin: 14px 0 0 16px;
    box-shadow: var(--shadow-sm);
  }

  .pc-group-brand[open] > summary .pc-group-count {
    color: rgba(255, 255, 255, 0.75);
  }

  /* Пока список папок листается (не идёт поиск) — открытая папка/линейка разворачивается
     во всю ширину, а остальные закрытые карточки на этом уровне прячутся, чтобы не мешать. */
  .price-checklist:has(.pc-search:placeholder-shown) .pc-groups:has(.pc-group-brand[open]) .pc-group-brand:not([open]) {
    display: none;
  }

  .price-checklist:has(.pc-search:placeholder-shown) .pc-group-body:has(.pc-group-line[open]) .pc-group-line:not([open]) {
    display: none;
  }

  .pc-group[hidden] {
    display: none;
  }

  .pc-group-brand > summary {
    padding: 14px 16px;
  }

  .pc-group-line > summary {
    padding: 12px 14px;
  }

  .pc-group summary {
    cursor: pointer;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 0.98rem;
    color: var(--color-ink);
    list-style: none;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
  }

  .pc-group-brand > summary {
    color: #fff;
  }

  .pc-group-brand > summary .pc-group-count {
    color: var(--color-panel);
  }

  .pc-group-line > summary {
    font-size: 0.9rem;
  }

  .pc-group summary::-webkit-details-marker { display: none; }

  .pc-group-count {
    font-family: var(--font-sans);
    font-weight: 400;
    color: #8a7f7a;
    font-size: 0.8rem;
  }

  /* Подкатегории «Акции» по ступени скидки — своя сплошная заливка карточки
     (не просто полоса), чтобы 15%/7% различались с первого взгляда, в тон
     блоку "Почему заказывают у Zilma" на главной (красный) и каталогу (синий). */
  .pc-tier-15 {
    background: var(--color-red);
    border-color: var(--color-red);
  }

  .pc-tier-15 > summary .pc-group-count {
    color: rgba(255, 255, 255, 0.72);
  }

  .pc-tier-7 {
    background: var(--color-blue-dark);
    border-color: var(--color-blue-dark);
  }

  .pc-group-body {
    padding-bottom: 4px;
  }

  /* Имя бренда уже показано в заголовке диалога (см. JS toggle-обработчик ниже) — дублирующая
     плашка-заголовок открытой карточки в самом списке лишняя, прячем её визуально. Сам <summary>
     остаётся в DOM (нужен для нативного открытия/закрытия <details>), сворачивание уже есть
     через кнопку «Назад» и повторный тап по «Каталогу»/«Акциям». */
  .pc-group-brand[open] > summary {
