  @media (max-width: 640px) {
    .price-checklist {
      /* Открывается через .show() (не .showModal()), см. скрипт ниже — иначе нативный modal-режим
         делает всё остальное содержимое страницы inert (невзаимодействуемым), включая MobileNavBar,
         даже там, где сам диалог физически её не перекрывает. Без modal-режима ::backdrop браузер
         не рисует — сам диалог достаточно непрозрачен, чтобы не растеряться без затемнения фона. */
      top: 0;
      left: 0;
      right: 0;
      bottom: auto;
      margin: 0;
      width: 100vw;
      max-width: 100vw;
      /* Не на всю высоту — оставляем внизу зазор под плавающую MobileNavBar (см. её же отступ снизу).
         100vh на мобильном Chrome/Android считается по "большому" виду (когда адресная строка
         скрыта) — пока она видна (обычный случай сразу после открытия диалога), реальный видимый
         экран меньше, и нижний кусок диалога (хвост списка папок в .pc-groups) рендерится ниже
         фактически видимой области — список выглядит "застрявшим", хотя технически докрутить
         некуда (реальный баг, найден пользователем 2026-08-27). 100dvh считается по ФАКТИЧЕСКИ
         видимой области и сам подстраивается под появление/скрытие адресной строки — оставляем
         100vh первой строкой как запасной вариант для браузеров без поддержки dvh. */
      height: calc(100vh - 90px);
      height: calc(100dvh - 90px);
      max-height: calc(100vh - 90px);
      max-height: calc(100dvh - 90px);
      border-radius: 0;
    }

  }
</style>

<script>
  // Открытие модалок по клику на любую кнопку с data-open-modal="<id диалога>" (см. PriceBlock.astro).
  // Простой overflow:hidden не спасает: showModal() сам фокусирует кнопку закрытия и браузер асинхронно
  // (уже после нашего кода) скроллит страницу, чтобы она попала в область видимости — window.scrollTo()
  // сразу после showModal() не успевает это перебить. Поэтому используем стандартный приём scroll-lock:
  // body переводится в position:fixed на время открытой модалки — тогда фон физически не может сдвинуться
  // ни от фокуса, ни от колеса/тача внутри диалога, а при закрытии позиция скролла восстанавливается.
  let lockedScrollY = 0;
  // Токен для отмены "reassert"-цикла ниже — когда после закрытия диалога нужно уйти к другому
  // месту страницы (напр. к #info по клику на плашке), а не вернуться туда, где было до открытия.
  let reassertToken = 0;
  // Когда true — unlockPageScroll полностью пропускает свою работу при следующем срабатывании
  // (см. closeDialogAndScrollTo: мы уже разлочили страницу сами и уводим её в другое место).
  let skipNextUnlock = false;
  function lockPageScroll() {
    lockedScrollY = window.scrollY;
    document.body.style.position = 'fixed';
    document.body.style.top = `-${lockedScrollY}px`;
    document.body.style.left = '0';
    document.body.style.right = '0';
  }
  function resetBodyLockStyles() {
    document.body.style.position = '';
    document.body.style.top = '';
    document.body.style.left = '';
    document.body.style.right = '';
  }
  function unlockPageScroll() {
    if (skipNextUnlock) {
      skipNextUnlock = false;
      return;
    }
    resetBodyLockStyles();
    window.scrollTo(0, lockedScrollY);
    // close() у <dialog> возвращает фокус на элемент-триггер с задержкой в несколько кадров (замерено
    // ~28мс в Chromium) — этот возврат фокуса сам скроллит страницу уже ПОСЛЕ того как мы её восстановили.
    // Подтверждаем правильную позицию ещё десяток кадров вперёд, чтобы перебить этот запоздалый скачок.
    const myToken = ++reassertToken;
    let ticks = 0;
    function reassert() {
      if (myToken !== reassertToken) return; // отменено — страница уже уводится в другое место
      if (window.scrollY !== lockedScrollY) window.scrollTo(0, lockedScrollY);
      ticks++;
      if (ticks < 15) requestAnimationFrame(reassert);
    }
    requestAnimationFrame(reassert);
  }

  // dialog.close() сам возвращает фокус на элемент-триггер и скроллит к нему страницу и (для диалога,
  // открытого через .show(), см. openDialog) снимает блокировку скролла НЕ синхронно, а с небольшой
  // задержкой — если убрать фокус из диалога непосредственно перед close() (когда активный элемент
  // больше не потомок диалога), браузер видит, что восстанавливать нечего, и лишнего скролла не будет.
  function closeDialog(root: HTMLDialogElement) {
    (document.activeElement as HTMLElement | null)?.blur();
    root.close();
  }

  // Закрывает диалог и сразу уводит взгляд в другое место страницы (якорь с плашки, форма заявки
  // после "Добавить в заявку") — а не туда, где был скролл до открытия диалога. Раз close() снимает
  // блокировку скролла асинхронно (см. выше), обычный scrollIntoView сразу после close() бьётся об
  // ещё зафиксированный body. Поэтому разлочиваем сами тут же, глушим отложенный автоматический
  // unlockPageScroll флагом (иначе он позже откатит скролл туда, где было до открытия) и держим
  // целевую позицию несколько кадров — на случай запоздалого скролла от возврата фокуса (см. выше).
  function closeDialogAndScrollTo(dialog: HTMLDialogElement, target: Element | null) {
    skipNextUnlock = true;
    closeDialog(dialog);
    resetBodyLockStyles();
    if (!target) return;
    const myToken = ++reassertToken;
    let ticks = 0;
    const holdScroll = () => {
      if (myToken !== reassertToken) return;
      target.scrollIntoView({ behavior: 'auto', block: 'start' });
      ticks++;
      if (ticks < 12) requestAnimationFrame(holdScroll);
    };
    holdScroll();
  }

  // Страховка от «мёртвого» сайта после сворачивания с открытым диалогом (реальный кейс,
  // пользователь 2026-08-27: свернул телефон на Каталоге, вернулся — страница не реагирует,
  // помогало только убить вкладку/приложение из памяти). Похоже на то, что мобильный
  // браузер иногда закрывает/теряет синхронизацию с открытым <dialog> при заморозке вкладки
  // в фоне, не давая отработать нашему 'close'-слушателю (см. unlockPageScroll выше) — тогда
  // body остаётся в position:fixed навсегда, и страница выглядит открытой, но не скроллится
  // и не реагирует на тапы. При возврате видимости страницы проверяем: лок стоит, а реально
  // открытого диалога нет — значит лок «осиротел», снимаем его сами.
  function healStuckScrollLock() {
    const anyOpenDialog = document.querySelector('dialog[open]');
    if (!anyOpenDialog && document.body.style.position === 'fixed') {
      resetBodyLockStyles();
      window.scrollTo(0, lockedScrollY || window.scrollY);
    }
  }
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') healStuckScrollLock();
  });
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) healStuckScrollLock();
  });

  function isMobileNav() {
    return window.matchMedia('(max-width: 640px)').matches;
  }

  interface CommittedItem {
    name: string;
    price: number;
    qty: number;
    brand: string;
    promo: boolean;
  }

  // Отметка чекбокса СРАЗУ добавляет/убирает товар из корзины (window.zilmaCart, см. CartStore.astro) —
  // по прямой просьбе пользователя (2026-09-03): отдельная кнопка «Добавить в заявку» лишний шаг,
  // как в обычном интернет-магазине отметка = товар уже в корзине. Мёрджим/убираем по названию,
  // не плодим дублирующие строки (тот же принцип, что раньше был в commitSelection — реальный
  // случай 2026-08-31, "Socolor 505M" дважды разными строками при повторном открытии).
  function syncItemToCart(check: HTMLInputElement, qtyInput: HTMLInputElement | null) {
    const cart: CommittedItem[] = (window as any).zilmaCart?.get() ?? [];
    const name = check.dataset.name ?? '';
    const idx = cart.findIndex((it) => it.name === name);
    if (check.checked) {
      const qty = Math.max(1, parseInt(qtyInput?.value ?? '1', 10) || 1);
      if (idx >= 0) {
        cart[idx].qty = qty;
      } else {
        cart.push({
          name,
          price: parseFloat(check.dataset.price ?? '0') || 0,
          qty,
          brand: check.dataset.brandLabel ?? '',
          promo: check.dataset.promo === '1',
        });
      }
    } else if (idx >= 0) {
      cart.splice(idx, 1);
    }
    (window as any).zilmaCart?.set(cart);
  }

  // На мобильном открываем через .show() (не .showModal()): нативный modal-режим делает ВЕСЬ остальной
  // документ inert (невзаимодействуемым) — это выключило бы MobileNavBar.astro даже в зазоре снизу, где
  // диалог её физически не перекрывает (см. mobile-медиа-запрос выше). На десктопе плашки нет — там
  // поведение остаётся прежним, showModal() с фокус-ловушкой и затемнением фона.
  // Повторный клик по той же кнопке ("Каталог"), пока список уже открыт и клиент залистался внутрь
  // раскрытой папки (бренд/линейка с длинным списком товаров) — сворачивает обратно к списку папок,
  // чтобы не листать наверх вручную. Отмеченные чекбоксы не трогает — только .open у <details> и скролл.
  function collapseToFolderList(dialog: HTMLDialogElement) {
    dialog.querySelectorAll<HTMLDetailsElement>('.pc-group').forEach((d) => {
      d.open = false;
    });
    const search = dialog.querySelector<HTMLInputElement>('.pc-search');
    if (search && search.value) {
      search.value = '';
      search.dispatchEvent(new Event('input', { bubbles: true }));
    }
    // Реальный баг на Android (найден пользователем 2026-08-27): резкое схлопывание сразу многих
    // <details> меняет высоту списка одним синхронным рывком, и если тут же скроллить новым
    // scrollTo() — мобильный Chrome иногда не успевает пересчитать границы скролла и дальше не
    // даёт пролистать список до конца (застревает на середине). Помогает: ждать кадр отрисовки
    // (браузер успевает переразметить укороченный список) и сбрасывать позицию простым свойством
    // scrollTop, а не новым scrollTo() API — так надёжнее на этом классе устройств.
    const scrollEl = dialog.querySelector<HTMLElement>('.pc-groups');
    if (scrollEl) {
      requestAnimationFrame(() => {
        scrollEl.scrollTop = 0;
      });
    }
  }

  function openDialog(dialog: HTMLDialogElement) {
    // Если переключаемся между Каталогом и Акциями (клик по плашке, когда одно окно уже открыто) —
    // просто закрываем его: отмеченное уже в корзине (см. syncItemToCart — коммитить отдельно
    // больше не нужно, каждая отметка уже сразу применена).
    document.querySelectorAll<HTMLDialogElement>('[data-checklist]').forEach((d) => {
      if (d !== dialog && d.open) {
        closeDialog(d);
      }
    });
    if (dialog.open) {
      collapseToFolderList(dialog);
      return;
    }
    lockPageScroll();
    if (isMobileNav()) {
      dialog.show();
    } else {
      dialog.showModal();
    }
    document.dispatchEvent(new CustomEvent('zilma:nav-show'));
  }

  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest('[data-open-modal]') as HTMLElement | null;
    if (!trigger) return;
    const id = trigger.getAttribute('data-open-modal');
    const dialog = id && document.getElementById(id);
    if (dialog instanceof HTMLDialogElement) openDialog(dialog);
  });

  // Автооткрытие по хэшу-команде из плашки быстрой навигации (MobileNavBar.astro), которая всегда
  // ссылается на главную (единственная страница, где гарантированно есть обе модалки).
  // hashchange — на случай клика, когда мы уже на главной (полной перезагрузки страницы не будет),
  // и когда переключаемся между уже открытыми Каталогом/Акциями прямо с плашки.
  const HASH_TO_DIALOG: Record<string, string> = {
    '#open-catalog': 'checklist-current-dialog',
    '#open-promo': 'checklist-promo-dialog',
  };
  function openFromHash() {
    const hash = location.hash;
    const targetId = HASH_TO_DIALOG[hash];
    if (targetId) {
      const dialog = document.getElementById(targetId);
      if (dialog instanceof HTMLDialogElement) openDialog(dialog);
      history.replaceState(null, '', location.pathname + location.search);
      return;
    }

    // Хэш не команда открытия окна (например, "#info" по клику на плашку). Если сейчас открыт
    // Каталог/Акции — страница физически не может проскроллиться к цели, пока не разлочена
    // (см. closeDialogAndScrollTo); иначе кнопка выглядит "неживой": и сама не закрывается, и
    // никуда не ведёт.
    const openDlg = document.querySelector<HTMLDialogElement>('[data-checklist][open]');
    const target = hash.length > 1 ? document.getElementById(hash.slice(1)) : null;
    if (openDlg) {
      closeDialogAndScrollTo(openDlg, target);
    } else {
      target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    history.replaceState(null, '', location.pathname + location.search);
  }
  openFromHash();
  window.addEventListener('hashchange', openFromHash);

  document.querySelectorAll<HTMLDialogElement>('[data-checklist]').forEach((dialog) => {
    dialog.addEventListener('close', unlockPageScroll);
    dialog.addEventListener('close', () => document.dispatchEvent(new CustomEvent('zilma:nav-show')));

    // Автоскрытие MobileNavBar при скролле списка внутри диалога: листаем дальше вниз по списку —
    // плашка уезжает, чтобы не мешать; возвращаемся к началу — плашка появляется снова.
    const scrollArea = dialog.querySelector<HTMLElement>('.pc-groups');
    let lastTop = 0;
    scrollArea?.addEventListener(
      'scroll',
      () => {
        const top = scrollArea.scrollTop;
        const delta = top - lastTop;
        if (Math.abs(delta) > 6) {
          document.dispatchEvent(new CustomEvent(delta > 0 ? 'zilma:nav-hide' : 'zilma:nav-show'));
          lastTop = top;
        }
      },
      { passive: true }
    );
  });

  // Точку/запятую в номере оттенка приравниваем к слэшу — "wella 1.9" должно находить
  // товар с "1/9" в названии, люди печатают код оттенка кто как привык.
  function normalizeSearch(s: string): string {
    return s.toLowerCase().replace(/[.,]/g, '/');
  }

  // Часть товаров в прайсе названа латиницей (бренды/линии/английские слова) — мастер,
  // печатающий кириллицей ("иллюмина", "шварцкопф"), иначе ничего не найдёт. Побуквенная
  // транслитерация не подходит — реальное произношение часто расходится с ней (Shinefinity
  // читается "шайнфинити", а не "шинефинити"), поэтому вместо алгоритма — словарь реальных
  // известных пар для всех значимых латинских слов из priceItems.json (бренды, линии,
  // частые английские слова в названиях — не служебные аббревиатуры вроде CT/KP/LC, их
  // никто не произносит по-русски). Значения — уже нормализованные (нижний регистр).
  const CYRILLIC_ALIASES: Record<string, string> = {
    матрикс: 'matrix', велла: 'wella', оллин: 'ollin', лонда: 'londa',
    шварцкопф: 'schwarzkopf', лебель: 'lebel', лебел: 'lebel', капус: 'kapous',
    концепт: 'concept', диксон: 'dikson', эстель: 'estel', карепрост: 'careprost',
    левиссим: 'levissime', лореаль: "l'oreal", лореал: "l'oreal", искартес: 'iskartes',
    игора: 'igora', блондми: 'blondme', иллюмина: 'illumina', шайнфинити: 'shinefinity',
    эйми: 'eimi', инвиго: 'invigo', соколор: 'socolor', синк: 'sync', ладор: 'la`dor',
    озис: 'osis', осис: 'osis', силуэт: 'silhouette',
    тач: 'touch', колор: 'color', кэр: 'care', кеа: 'care', софт: 'soft', блонд: 'blond',
    нью: 'new', тотал: 'total', силк: 'silk', ойл: 'oil', вельвет: 'velvet',
    перфект: 'perfect', бриллианс: 'brilliance', профи: 'profy',
  };

  // Разные бренды называют один и тот же тип товара разными словами — осветляющий
  // порошок у Wella зовётся "Блондор", у Londa "Блондоран", у Ollin/Matrix "Супра",
  // а мастер может искать и общим словом "порошок"/"пудра"/"осветляющий". Это не
  // фонетическая пара (как в CYRILLIC_ALIASES выше), а группа взаимозаменяемых слов —
  // если запрос совпал с одним словом из группы, ищем товар по ЛЮБОМУ слову из той же
  // группы. "освет" без окончания — так ловится и "осветляющий", и опечатка в прайсе
  // "осветяющий" (без "л"), и "освет." (сокращение).
  const SYNONYM_GROUPS: string[][] = [
    ['супра', 'блондор', 'блондоран', 'порошок', 'пудра', 'освет'],
  ];

  function matchToken(token: string, entry: { name: string; brand: string; line: string }): boolean {
    if (entry.name.includes(token) || entry.brand.includes(token) || entry.line.includes(token)) return true;
    const alias = CYRILLIC_ALIASES[token];
    if (alias && (entry.name.includes(alias) || entry.brand.includes(alias) || entry.line.includes(alias))) return true;
    const group = SYNONYM_GROUPS.find((g) => g.some((w) => token.includes(w) || w.includes(token)));
    return !!group && group.some((w) => entry.name.includes(w) || entry.brand.includes(w) || entry.line.includes(w));
  }

  document.querySelectorAll<HTMLDialogElement>('[data-checklist]').forEach((root) => {
    const search = root.querySelector<HTMLInputElement>('.pc-search');
    const items = [...root.querySelectorAll<HTMLLIElement>('.pc-item')];
    const groups = [...root.querySelectorAll<HTMLDetailsElement>('.pc-group')];
    const checks = [...root.querySelectorAll<HTMLInputElement>('.pc-check')];
    // Индекс на каждый товар — считаем один раз, не при каждом нажатии клавиши.
    const searchIndex = new Map<HTMLLIElement, { name: string; brand: string; line: string }>(
      items.map((li) => [
        li,
        {
          name: normalizeSearch(li.dataset.name ?? ''),
          brand: normalizeSearch(li.dataset.brand ?? ''),
          line: normalizeSearch(li.dataset.line ?? ''),
        },
      ])
    );
    const countEl = root.querySelector<HTMLElement>('[data-count]');
    const noResults = root.querySelector<HTMLElement>('.pc-no-results');

    // Отдельной кнопки «✕ Закрыть» больше нет (пользователь справедливо заметил: рядом с «←»
    // и всегда доступной нижней плашкой навигации она лишняя). Стрелка «←» теперь «умная»:
    // внутри открытого бренда — сворачивает к списку папок (как раньше), а на самом верхнем
    // уровне (папки уже свёрнуты) — закрывает диалог целиком, как обычная кнопка «Назад».
    root.querySelector('[data-back-to-folders]')?.addEventListener('click', () => {
      const anyOpen = groups.some((g) => g.open);
      if (anyOpen) {
        collapseToFolderList(root);
      } else {
        closeDialog(root);
      }
    });

    // Открытая карточка бренда ведёт себя как отдельный «экран»: заголовок и подсказка
    // поиска меняются на имя бренда, пока эта карточка открыта — визуально не просто
    // раскрытый аккордеон в общем списке, а переход внутрь бренда. Только для обычного
    // каталога (data-group-by="brand") — в «Акциях» группировка другая (по ступени скидки),
    // там имя бренда как заголовок экрана было бы не к месту.
    const headerTitle = root.querySelector<HTMLElement>('.pc-header h3');
    const originalHeading = headerTitle?.textContent ?? '';
    const defaultSearchPlaceholder = search?.placeholder ?? '';
    if (root.dataset.groupBy === 'brand') {
      root.querySelectorAll<HTMLDetailsElement>('.pc-group-brand').forEach((brandEl) => {
        brandEl.addEventListener('toggle', () => {
          const brandName = brandEl.dataset.brand;
          if (brandEl.open && brandName) {
            if (headerTitle) {
              headerTitle.textContent = brandName;
              headerTitle.classList.remove('pc-header-logo');
            }
            if (search) search.placeholder = `Поиск по ${brandName}…`;
          } else if (!brandEl.open) {
            if (headerTitle) {
              headerTitle.textContent = originalHeading;
              headerTitle.classList.add('pc-header-logo');
            }
            if (search) search.placeholder = defaultSearchPlaceholder;
          }
        });
      });
    }

    // Корзинка-счётчик в шапке — тот же приём, что у пункта «Заявка» нижней плашки
    // (MobileNavBar.astro): на главной ведёт мгновенным якорем, с других страниц — на
    // отдельную лёгкую страницу /order/ (без херо), бейдж читает общее хранилище корзины.
    const cartLink = root.querySelector<HTMLAnchorElement>('[data-cart-link]');
    if (cartLink && location.pathname === '/') cartLink.href = '/#order';
    const cartBadge = root.querySelector<HTMLElement>('[data-cart-badge]');
    function updateCartBadge() {
      if (!cartBadge) return;
      const cart = (window as any).zilmaCart?.get() ?? [];
      const count = Array.isArray(cart) ? cart.length : 0;
      cartBadge.textContent = String(count);
      cartBadge.hidden = count === 0;
    }
    document.addEventListener('zilma:cart-updated', updateCartBadge);
    updateCartBadge();

    // Карточка «Популярные» — ярлык на нужный бренд в общем алфавитном списке ниже,
    // не отдельный дублирующий рендер товаров.
    root.querySelectorAll<HTMLButtonElement>('[data-jump-to-brand]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const name = btn.dataset.jumpToBrand ?? '';
        groups.forEach((g) => {
          if (g.classList.contains('pc-group-brand')) g.open = false;
        });
        const target = root.querySelector<HTMLDetailsElement>(`.pc-group-brand[data-brand="${CSS.escape(name)}"]`);
        if (target) {
          target.open = true;
          target.scrollIntoView({ block: 'start', behavior: 'smooth' });
        }
      });
    });
    // Клик по подложке (::backdrop) — событие всплывает с target === сам dialog, а не его содержимое.
    root.addEventListener('click', (e) => {
      if (e.target === root) closeDialog(root);
    });

    function updateCount() {
      const n = checks.filter((c) => c.checked).length;
      if (countEl) countEl.textContent = n ? `${n} в заявке` : '';
    }

    // Отмеченное здесь может измениться СНАРУЖИ (товар убрали в корзине на странице заявки,
    // истёк TTL и т.п.) — держим чекбоксы синхронными с реальным содержимым корзины, а не
    // только со своими собственными кликами.
    function syncCheckedFromCart() {
      const cart: CommittedItem[] = (window as any).zilmaCart?.get() ?? [];
      const byName = new Map(cart.map((it) => [it.name, it]));
      checks.forEach((c) => {
        const entry = byName.get(c.dataset.name ?? '');
        const qtyInput = c.closest('.pc-item')?.querySelector<HTMLInputElement>('.pc-qty-input');
        c.checked = !!entry;
        if (qtyInput) qtyInput.value = entry ? String(entry.qty) : '1';
      });
      updateCount();
    }
    syncCheckedFromCart();
    document.addEventListener('zilma:cart-updated', syncCheckedFromCart);

    // Степпер количества: +/- меняют значение и, если товар ещё не отмечен, отмечают его.
    // Любое изменение (отметка, снятие отметки, +/-, ручной ввод количества) сразу применяется
    // к корзине через syncItemToCart — отдельного шага «подтвердить» больше нет.
    root.querySelectorAll<HTMLElement>('.pc-item').forEach((li) => {
      const check = li.querySelector<HTMLInputElement>('.pc-check');
      const qtyInput = li.querySelector<HTMLInputElement>('.pc-qty-input');
      if (!check || !qtyInput) return;

      function clamp() {
        const n = Math.max(1, Math.min(999, parseInt(qtyInput!.value, 10) || 1));
        qtyInput!.value = String(n);
        return n;
      }

      li.querySelectorAll<HTMLButtonElement>('.pc-qty-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const dir = Number(btn.dataset.qtyDir) || 0;
          const n = Math.max(1, Math.min(999, (parseInt(qtyInput.value, 10) || 1) + dir));
          qtyInput.value = String(n);
          if (!check.checked) {
            check.checked = true;
            check.dispatchEvent(new Event('change'));
          } else {
            syncItemToCart(check, qtyInput);
          }
        });
      });

      qtyInput.addEventListener('change', () => {
        clamp();
        if (check.checked) syncItemToCart(check, qtyInput);
      });
      qtyInput.addEventListener('input', () => {
        if (qtyInput.value && !check.checked) {
          check.checked = true;
          check.dispatchEvent(new Event('change'));
        } else if (check.checked) {
          syncItemToCart(check, qtyInput);
        }
      });

      check.addEventListener('change', () => {
        if (!check.checked) qtyInput.value = '1';
        updateCount();
        syncItemToCart(check, qtyInput);
      });
    });

    search?.addEventListener('input', () => {
      // Каждое слово запроса ищем по отдельности (не всю строку целиком) — так "wella 1.9"
      // находит товар, у которого "wella" в бренде, а "1/9" (точка = слэш) — в названии,
      // даже если это не идёт подряд как в запросе.
      const tokens = normalizeSearch(search.value.trim()).split(/\s+/).filter(Boolean);
      // Если уже открыт конкретный бренд («экран бренда») — поиск ищет только внутри него,
      // не по всему прайсу: набирая "7/0" внутри LONDA, не хочется внезапно улететь в WELLA.
      // Сам заголовок открытого бренда не трогаем (не прячем, не сворачиваем) — это текущий
      // экран, а не результат поиска среди прочих.
      const openBrand = groups.find((g) => g.classList.contains('pc-group-brand') && g.open);
      let anyVisibleTotal = false;
      groups.forEach((g) => {
        // Другой (не текущий) бренд верхнего уровня, пока мы внутри «экрана» одного бренда —
        // всегда прячем, не полагаясь на CSS-трюк для пустого поиска (он работает только
        // пока :placeholder-shown, а тут уже что-то введено).
        if (openBrand && g.classList.contains('pc-group-brand') && g !== openBrand) {
          g.hidden = true;
          return;
        }
        const groupItems = [...g.querySelectorAll<HTMLLIElement>('.pc-item')];
        let anyVisible = false;
        groupItems.forEach((li) => {
          const entry = searchIndex.get(li);
          const match = tokens.length === 0 || !entry || tokens.every((t) => matchToken(t, entry));
          li.hidden = !match;
          if (match) anyVisible = true;
        });
        if (g === openBrand) {
          g.hidden = false; // текущий экран бренда всегда виден, поиск лишь фильтрует товары внутри
        } else {
          g.hidden = !anyVisible;
          g.open = tokens.length > 0 && anyVisible;
        }
        if (anyVisible) anyVisibleTotal = true;
      });
      if (noResults) noResults.hidden = anyVisibleTotal || items.length === 0;
    });
  });
</script>
