  /* Пока идёт поиск или уже открыт конкретный бренд — блок «Популярные»/«Все бренды» лишний. */
  .price-checklist:has(.pc-search:not(:placeholder-shown)) .pc-popular {
    display: none;
  }

  .pc-groups:has(.pc-group-brand[open]) .pc-popular {
    display: none;
  }

  .pc-item[hidden] {
    display: none;
  }

  .pc-item {
