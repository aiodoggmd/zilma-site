---
interface Item {
  id: number;
  brand: string | null;
  line: string | null;
  name: string;
  price: number;
  promo: boolean;
  oldPrice?: number;
  discountPct?: number;
  isNew?: boolean;
  stock?: number;
  category?: string;
}

interface Props {
  items: Item[];
  instanceId: string;
  heading: string;
  // 'discount' — верхний уровень группировки не бренд, а ступень скидки (15%/7%),
  // бренд становится вложенным уровнем внутри. Только для окна «Акции».
  groupBy?: 'brand' | 'discount';
}

const { items, instanceId, heading, groupBy = 'brand' } = Astro.props;
const dialogId = `${instanceId}-dialog`;

// Сортировка: сначала латиница (A-Z), потом кириллица (А-Я), внутри каждой — по алфавиту.
function scriptRank(s: string): number {
  const ch = s.trim().charAt(0);
  if (/[A-Za-z]/.test(ch)) return 0;
  if (/[А-Яа-яЁё]/.test(ch)) return 1;
  return 2;
}
function alphaCompare(a: string, b: string): number {
  const ra = scriptRank(a);
  const rb = scriptRank(b);
  if (ra !== rb) return ra - rb;
  return a.localeCompare(b, ra === 0 ? 'en' : 'ru', { sensitivity: 'base' });
}

// Двухуровневая группировка: бренд (напр. WELLA) -> линейка внутри бренда (напр. EIMI) -> товары.
// Пустой ключ '' — товары без линейки, показываются плоским списком прямо под брендом.
const brandMap = new Map<string, Map<string, Item[]>>();
for (const it of items) {
  const b = it.brand ?? 'Другое';
  const l = it.line ?? '';
  if (!brandMap.has(b)) brandMap.set(b, new Map());
  const lineMap = brandMap.get(b)!;
  if (!lineMap.has(l)) lineMap.set(l, []);
  lineMap.get(l)!.push(it);
}

const byName = (a: Item, b: Item) => alphaCompare(a.name, b.name);

const brandEntries = [...brandMap.entries()]
  .sort((a, b) => alphaCompare(a[0], b[0]))
  .map(([brand, lineMap]) => {
    const flat = [...(lineMap.get('') ?? [])].sort(byName);
    const lineEntries = [...lineMap.entries()]
      .filter(([l]) => l !== '')
      .sort((a, b) => alphaCompare(a[0], b[0]))
      .map(([line, list]) => [line, [...list].sort(byName)] as [string, Item[]]);
    const total = [...lineMap.values()].reduce((s, arr) => s + arr.length, 0);
    return { brand, total, flat, lineEntries };
  });

function pluralItems(n: number): string {
  const mod10 = n % 10;
  const mod100 = n % 100;
  if (mod100 >= 11 && mod100 <= 14) return 'товаров';
  if (mod10 === 1) return 'товар';
  if (mod10 >= 2 && mod10 <= 4) return 'товара';
  return 'товаров';
}

// «Популярные бренды» — не топ-4 по количеству позиций (так туда попадал бы, например, OLLIN
// просто за счёт объёма прайса), а флагманские бренды Zilma — те же, что в подзаголовке хиро
// на главной («Wella · Londa · Schwarzkopf · Matrix · Lebel»). Показываем, только если брендов
// реально много (иначе блок-ярлык на 4 из 5 бессмысленен).
const PREFERRED_POPULAR_BRANDS = ['WELLA', 'LONDA', 'SCHWARZKOPF', 'MATRIX'];
const brandByName = new Map(brandEntries.map((b) => [b.brand, b]));
const popularBrands = groupBy === 'brand' && brandEntries.length > 5
  ? PREFERRED_POPULAR_BRANDS.map((name) => brandByName.get(name)).filter((b): b is (typeof brandEntries)[number] => Boolean(b))
  : [];

// «Категории» — реальные, проставлены пользователем вручную в прайсе (колонка F,
// price-current.xlsx, номер 1-17), см. src/data/price-categories.json и
// scripts/xlsx-to-price-items.py. Порядок — как в списке пользователя, не алфавитный.
// Товары без категории (единичные нехайрушные позиции вроде бальзама для губ) просто не
// попадают ни в одну группу — не нужны в категориях, остаются доступны через «По бренду».
const CATEGORY_ORDER = [
  'Аммиачные красители', 'Безаммиачные красители', 'Окислители и осветляющие средства',
  'Технические средства', 'Химия волос', 'Ампулы/концентраты', 'Брови и ресницы',
  'Шампуни', 'Кондиционеры', 'Маски', 'Несмываемый уход', 'Термозащита', 'Лаки',
  'Спреи', 'Пенки', 'Крема и гели для укладки', 'Расходные материалы',
] as const;
function categorize(it: Item): string | null {
  return it.category ?? null;
}
const categoryCounts = groupBy === 'brand'
  ? CATEGORY_ORDER.map((cat) => ({ cat, total: items.filter((it) => categorize(it) === cat).length })).filter((c) => c.total > 0)
  : [];

// Группировка по ступени скидки (15%/7%) -> бренд -> товары — только для окна «Акции».
// Ступени идут в фиксированном порядке (большая скидка первой), а не по алфавиту.
const DISCOUNT_TIER_ORDER = [15, 7];
function discountTierLabel(pct: number | undefined): string {
  return pct != null ? `Скидка ${pct}%` : 'Акция';
}

let discountEntries: { tier: string; total: number; brandEntries: [string, Item[]][] }[] = [];
if (groupBy === 'discount') {
  const tierMap = new Map<string, Map<string, Item[]>>();
  for (const it of items) {
    const tier = discountTierLabel(it.discountPct);
    const b = it.brand ?? 'Другое';
    if (!tierMap.has(tier)) tierMap.set(tier, new Map());
    const bMap = tierMap.get(tier)!;
    if (!bMap.has(b)) bMap.set(b, []);
    bMap.get(b)!.push(it);
  }
  discountEntries = [...tierMap.entries()]
    .sort((a, b) => {
      const ia = DISCOUNT_TIER_ORDER.indexOf(parseInt(a[0].replace(/\D/g, ''), 10));
      const ib = DISCOUNT_TIER_ORDER.indexOf(parseInt(b[0].replace(/\D/g, ''), 10));
      if (ia !== -1 || ib !== -1) return (ia === -1 ? 999 : ia) - (ib === -1 ? 999 : ib);
      return alphaCompare(a[0], b[0]);
    })
    .map(([tier, bMap]) => {
      const total = [...bMap.values()].reduce((s, arr) => s + arr.length, 0);
      const brandEntriesForTier = [...bMap.entries()]
        .sort((a, b) => alphaCompare(a[0], b[0]))
        .map(([brand, list]) => [brand, [...list].sort(byName)] as [string, Item[]]);
      return { tier, total, brandEntries: brandEntriesForTier };
    });
}

// «Лучшая скидка» — честная витрина без придуманного таймера/дедлайна (в прайсе нет реальных
// time-limited кампаний, скидка — постоянный флаг до следующего обновления прайса).
// Критерий отбора — ПО ПРЯМОЙ ПРОСЬБЕ ПОЛЬЗОВАЛЬНОГО (2026-09-04): не самая большая скидка
// в рублях (её и так видно по бейджу — рекламировать очевидное бессмысленно), а наибольший
// реальный остаток на складе (src/data/priceItems.json, поле stock — из Price/Остатки_*.xlsx,
// см. scripts/xlsx-to-price-items.py). Смысл — не украшательство, а реальная бизнес-задача:
// быстрее продать то, чего скопилось больше всего. Товары без известного остатка (поле stock
// отсутствует — артикул оказался неоднозначным при сопоставлении) в отбор не попадают, не
// придумываем цифру. По одному лучшему (по остатку) товару от каждого бренда — топ-5.
const bestDeals = groupBy === 'discount'
  ? (() => {
      const bestPerBrand = new Map<string, Item>();
      for (const it of items) {
        if (!it.promo || it.oldPrice == null || it.stock == null) continue;
        if (it.name.toLowerCase().includes('дозатор')) continue; // расходник/аксессуар, не полноценный товар
        if (it.brand === 'ОДНОРАЗОВАЯ ПРОДУКЦИЯ') continue; // тоже расходник, не товар для рекламы акции
        const brand = it.brand ?? 'Другое';
        const current = bestPerBrand.get(brand);
        if (!current || it.stock > (current.stock ?? 0)) {
          bestPerBrand.set(brand, it);
        }
      }
      return [...bestPerBrand.values()]
        .sort((a, b) => (b.stock ?? 0) - (a.stock ?? 0))
        .slice(0, 5);
    })()
  : [];
---
<dialog class="price-checklist" data-checklist data-group-by={groupBy} id={dialogId}>
  <div class="pc-header">
    <div class="pc-header-brand">
      <h3 class:list={[groupBy === 'discount' ? 'pc-header-tier' : 'pc-header-logo']}>{heading}</h3>
      {heading === 'ZILMA' && <p class="pc-header-tagline">Профессиональная косметика</p>}
      {groupBy === 'discount' && (
        <p class="pc-header-tagline pc-header-promo-tagline">Количество некоторых позиций ограничено!<br />Успейте купить!</p>
      )}
    </div>
    <a href="/order/#order" class="pc-cart-link" data-cart-link aria-label="Перейти в заявку">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 8V6a3 3 0 0 1 6 0v2" />
        <path d="M6 8h12l1.3 12.2a2 2 0 0 1-2 2.3H6.7a2 2 0 0 1-2-2.3L6 8Z" />
      </svg>
      <span class="pc-cart-badge" data-cart-badge hidden>0</span>
    </a>
  </div>
  {categoryCounts.length > 0 && (
    <div class="pc-mode-tabs">
      <button type="button" class="pc-mode-tab" data-mode-tab="brand">По бренду</button>
      <button type="button" class="pc-mode-tab" data-mode-tab="category">По категории</button>
    </div>
  )}
  <div class="pc-controls">
    <button type="button" class="pc-back" data-back-to-folders aria-label="Назад к списку папок">←</button>
    <div class="pc-search-wrap">
      <svg class="pc-search-icon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7" />
        <line x1="21" y1="21" x2="16.65" y2="16.65" />
      </svg>
      <input type="search" class="pc-search" placeholder="Поиск по товару, бренду или линейке…" aria-label="Поиск по прайсу" />
    </div>
  </div>
  <p class="pc-search-hint">Например: Koleston 7/0, Londa, шампунь…</p>
  <div class="pc-groups">
    {categoryCounts.length > 0 && (
      <div class="pc-category-screen" data-category-screen>
        <div class="pc-popular-grid">
          {categoryCounts.map(({ cat, total }) => (
            <button type="button" class="pc-popular-card" data-filter-category={cat}>
              <span class="pc-popular-name">{cat}</span>
              <span class="pc-popular-count">{total} {pluralItems(total)}</span>
            </button>
          ))}
        </div>
      </div>
    )}
    <div class="pc-brand-panel" data-brand-panel hidden>
    {popularBrands.length > 0 && (
      <div class="pc-popular">
        <p class="pc-popular-title">Популярные</p>
        <div class="pc-popular-grid">
          {popularBrands.map(({ brand, total }) => (
            <button type="button" class="pc-popular-card" data-jump-to-brand={brand}>
              <span class="pc-popular-name">{brand}</span>
              <span class="pc-popular-count">{total} {pluralItems(total)}</span>
            </button>
          ))}
        </div>
        <a href="/#open-promo" class="pc-promo-banner" data-open-promo-from-catalog>
          <span class="pc-promo-banner-title">Больше выгодных предложений</span>
          <span class="pc-promo-banner-sub">Специальные скидки при заказе через сайт</span>
          <span class="pc-promo-banner-arrow" aria-hidden="true">→</span>
        </a>
        <p class="pc-all-title">Все бренды</p>
      </div>
    )}
    {groupBy === 'brand' && brandEntries.map(({ brand, total, flat, lineEntries }) => (
      <details class="pc-group pc-group-brand" data-brand={brand} data-has-lines={lineEntries.length > 0 ? '1' : '0'}>
        <summary>
          <svg class="pc-row-chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg>
          <span class="pc-row-name">{brand}</span>
          <span class="pc-row-actions">
            <span class="pc-group-count">{total} {pluralItems(total)}</span>
            <button type="button" class="pc-row-search-btn" data-focus-search aria-label={`Искать в ${brand}`}>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
            </button>
          </span>
        </summary>
        <div class="pc-group-body">
          {flat.length > 0 && (
            <ul>
              {flat.map((it) => (
                <li class:list={['pc-item', { 'pc-promo': it.promo }]} data-name={it.name.toLowerCase()} data-brand={brand.toLowerCase()} data-line="" data-category={categorize(it) ?? ''}>
                  <label>
                    <input type="checkbox" class="pc-check" data-name={it.name} data-price={it.price} data-brand-label={brand} data-promo={it.promo ? '1' : ''} />
                    <span class="pc-item-name">{it.name}</span>
                    <span class="pc-item-price">
                      <b class="pc-price-now">{it.price} ₽</b>
                      {it.promo && it.oldPrice != null && <span class="pc-old-price">{it.oldPrice} ₽</span>}
                      {(it.promo || it.isNew) && (
                        <span class="pc-badges">
                          {it.promo && <span class="pc-badge">{it.discountPct ? `-${it.discountPct}%` : 'Акция'}</span>}
                          {it.isNew && <span class="pc-badge pc-badge-new">Н</span>}
                        </span>
                      )}
                    </span>
                  </label>
                  <div class="pc-qty">
                    <button type="button" class="pc-qty-btn" data-qty-dir="-1" aria-label="Меньше">−</button>
                    <input type="number" class="pc-qty-input" value="0" min="0" max="999" inputmode="numeric" aria-label="Количество" />
                    <button type="button" class="pc-qty-btn" data-qty-dir="1" aria-label="Больше">+</button>
                  </div>
                </li>
              ))}
            </ul>
          )}
          {lineEntries.map(([line, list]) => (
            <details class="pc-group pc-group-line">
              <summary>
                <svg class="pc-row-chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg>
                <span class="pc-row-name">{line}</span>
                <span class="pc-row-actions">
                  <span class="pc-group-count">{list.length} {pluralItems(list.length)}</span>
                  <button type="button" class="pc-row-search-btn" data-focus-search aria-label={`Искать в ${line}`}>
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                  </button>
                </span>
              </summary>
              <ul>
                {list.map((it) => (
                  <li class:list={['pc-item', { 'pc-promo': it.promo }]} data-name={it.name.toLowerCase()} data-brand={brand.toLowerCase()} data-line={line.toLowerCase()} data-category={categorize(it) ?? ''}>
                    <label>
                      <input type="checkbox" class="pc-check" data-name={it.name} data-price={it.price} data-brand-label={brand} data-promo={it.promo ? '1' : ''} />
                      <span class="pc-item-name">{it.name}</span>
                      <span class="pc-item-price">
                        <b class="pc-price-now">{it.price} ₽</b>
                        {it.promo && it.oldPrice != null && <span class="pc-old-price">{it.oldPrice} ₽</span>}
                        {(it.promo || it.isNew) && (
                          <span class="pc-badges">
                            {it.promo && <span class="pc-badge">{it.discountPct ? `-${it.discountPct}%` : 'Акция'}</span>}
                            {it.isNew && <span class="pc-badge pc-badge-new">Н</span>}
                          </span>
                        )}
                      </span>
                    </label>
                    <div class="pc-qty">
                      <button type="button" class="pc-qty-btn" data-qty-dir="-1" aria-label="Меньше">−</button>
                      <input type="number" class="pc-qty-input" value="0" min="0" max="999" inputmode="numeric" aria-label="Количество" />
                      <button type="button" class="pc-qty-btn" data-qty-dir="1" aria-label="Больше">+</button>
                    </div>
                  </li>
                ))}
              </ul>
            </details>
          ))}
        </div>
      </details>
    ))}
    </div>
    {bestDeals.length > 0 && (
      <div class="pc-best-deal">
        <p class="pc-best-deal-label">Лучшая скидка</p>
        <ul class="pc-best-deal-list">
          {bestDeals.map((deal) => (
            <li class:list={['pc-item', { 'pc-promo': deal.promo }]} data-name={deal.name.toLowerCase()} data-brand={(deal.brand ?? '').toLowerCase()} data-line="" data-category={categorize(deal) ?? ''}>
              <label>
                <input type="checkbox" class="pc-check" data-name={deal.name} data-price={deal.price} data-brand-label={deal.brand ?? ''} data-promo={deal.promo ? '1' : ''} />
                <span class="pc-item-name">
                  <span class="pc-best-deal-brand">{deal.brand}</span>
                  {deal.name}
                </span>
                <span class="pc-item-price">
                  <b class="pc-price-now">{deal.price} ₽</b>
                  {deal.oldPrice != null && <span class="pc-old-price">{deal.oldPrice} ₽</span>}
                  <span class="pc-badges">
                    <span class="pc-badge">{deal.discountPct ? `-${deal.discountPct}%` : 'Акция'}</span>
                  </span>
                </span>
              </label>
              <div class="pc-qty">
                <button type="button" class="pc-qty-btn" data-qty-dir="-1" aria-label="Меньше">−</button>
                <input type="number" class="pc-qty-input" value="0" min="0" max="999" inputmode="numeric" aria-label="Количество" />
                <button type="button" class="pc-qty-btn" data-qty-dir="1" aria-label="Больше">+</button>
              </div>
            </li>
          ))}
        </ul>
      </div>
    )}
    {groupBy === 'discount' && discountEntries.map(({ tier, total, brandEntries: tierBrandEntries }) => (
      <details class:list={['pc-group', 'pc-group-brand', { 'pc-tier-15': tier === 'Скидка 15%', 'pc-tier-7': tier === 'Скидка 7%' }]} data-brand={tier}>
        <summary>{tier} <span class="pc-group-count">{total} {pluralItems(total)}</span></summary>
        <div class="pc-group-body">
          {tierBrandEntries.map(([brand, list]) => (
            <details class="pc-group pc-group-line">
              <summary>{brand} <span class="pc-group-count">{list.length} {pluralItems(list.length)}</span></summary>
              <ul>
                {list.map((it) => (
                  <li class:list={['pc-item', { 'pc-promo': it.promo }]} data-name={it.name.toLowerCase()} data-brand={brand.toLowerCase()} data-line="" data-category={categorize(it) ?? ''}>
                    <label>
                      <input type="checkbox" class="pc-check" data-name={it.name} data-price={it.price} data-brand-label={brand} data-promo={it.promo ? '1' : ''} />
                      <span class="pc-item-name">{it.name}</span>
                      <span class="pc-item-price">
                        <b class="pc-price-now">{it.price} ₽</b>
                        {it.promo && it.oldPrice != null && <span class="pc-old-price">{it.oldPrice} ₽</span>}
                        {(it.promo || it.isNew) && (
                          <span class="pc-badges">
                            {it.promo && <span class="pc-badge">{it.discountPct ? `-${it.discountPct}%` : 'Акция'}</span>}
                            {it.isNew && <span class="pc-badge pc-badge-new">Н</span>}
                          </span>
                        )}
                      </span>
                    </label>
                    <div class="pc-qty">
                      <button type="button" class="pc-qty-btn" data-qty-dir="-1" aria-label="Меньше">−</button>
                      <input type="number" class="pc-qty-input" value="0" min="0" max="999" inputmode="numeric" aria-label="Количество" />
                      <button type="button" class="pc-qty-btn" data-qty-dir="1" aria-label="Больше">+</button>
                    </div>
                  </li>
                ))}
              </ul>
            </details>
          ))}
        </div>
      </details>
    ))}
    <p class="pc-no-results" hidden>Ничего не найдено — попробуйте другой запрос.</p>
  </div>
</dialog>

<style>
  .price-checklist:not([open]) {
    display: none;
  }

  .price-checklist {
    position: fixed;
    inset: 0;
    margin: auto;
    z-index: 140;
    padding: 0;
    border: none;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card-hover);
    width: 92vw;
    max-width: 720px;
    height: 84vh;
    max-height: 84vh;
    display: flex;
    flex-direction: column;
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .price-checklist::backdrop {
    background: rgba(43, 32, 28, 0.55);
  }

  .pc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 18px;
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-panel-line);
    flex: none;
  }

  .pc-header h3 {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.15rem;
    margin: 0;
    color: var(--color-ink);
  }

  .pc-header-brand {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    min-width: 0;
  }

  /* Заголовок-заглушка по умолчанию — логотип-надпись «ZILMA» по центру шапки (тот же дух,
     что настоящий лого-файл: серифный, красный), плюс подпись бренда под ней. Как только
     открыт конкретный бренд, JS убирает этот класс и подставляет обычное тёмное имя бренда —
     подпись скрывается сама (см. правило на .pc-header-tagline ниже). */
  .pc-header h3.pc-header-logo {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 2.4rem;
    letter-spacing: 0.1em;
    color: var(--color-red);
    text-transform: uppercase;
  }

  /* Заголовок ступени скидки («Скидка 15%/7%») при заходе внутрь — тот же шрифт/размер,
     что у обычного имени бренда (.pc-header h3 без модификаторов), но красным и прописными. */
  .pc-header h3.pc-header-tier {
    color: var(--color-red);
    text-transform: uppercase;
  }

  .pc-header-tagline {
    display: none;
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.46rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #8a7f7a;
  }

  .pc-header-logo + .pc-header-tagline {
    display: block;
  }

  /* Подпись под «Акции»/«Скидка N%» — видна ВСЕГДА в этом диалоге (не только на верхнем
     уровне, как подпись бренда у ZILMA), поэтому не завязана на .pc-header-logo рядом. */
  .pc-header-promo-tagline {
    display: block;
    text-align: center;
    line-height: 1.35;
  }

  .pc-cart-link {
    position: relative;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: transparent;
    color: var(--color-ink);
  }

  .pc-cart-link:hover {
    color: var(--color-blue-dark);
  }

  .pc-cart-badge {
    position: absolute;
    top: -2px;
    right: -2px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 999px;
    background: var(--color-red);
    color: #fff;
    font-size: 0.62rem;
    font-weight: 700;
    line-height: 16px;
    text-align: center;
    box-shadow: 0 0 0 2px var(--color-paper);
  }

  .pc-cart-badge[hidden] {
    display: none;
  }

  /* Две вкладки навигации — «По категории» / «По бренду», равноправные (2026-09-04).
     Стиль сверен с FilterTabs.astro (фильтры под статьями): белый фон, острые углы,
     заливка цветом только в активном состоянии - не бежевая панель, как было раньше. */
  .pc-mode-tabs {
    flex: none;
    display: flex;
    gap: 6px;
    padding: 12px 14px 0;
    background: var(--color-paper);
  }

  .pc-mode-tab {
    flex: 1;
    font: inherit;
    font-family: var(--font-sans);
    text-align: center;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 9px 4px;
    border-radius: 8px;
    background: var(--color-paper);
    color: var(--color-ink);
    border: 1.5px solid var(--color-panel-line);
    cursor: pointer;
  }

  .pc-mode-tab.active {
    background: var(--color-red);
    border-color: var(--color-red);
    color: #fff;
  }

  .pc-mode-tab:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .pc-brand-panel[hidden],
  .pc-category-screen[hidden] {
    display: none;
  }

  .pc-controls {
    flex: none;
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-panel-line);
    padding: 14px 18px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .pc-back {
    flex: none;
    font: inherit;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-ink);
    background: var(--color-paper);
    border: 1px solid #d7d5de;
    box-shadow: var(--shadow-sm);
    border-radius: 50%;
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    white-space: nowrap;
  }

  .pc-back:hover {
    color: var(--color-blue-dark);
  }

  .pc-search-wrap {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
  }

  .pc-search-icon {
    position: absolute;
    left: 14px;
    color: var(--color-meta);
    pointer-events: none;
  }

  .pc-search {
    width: 100%;
    font: inherit;
    font-size: 0.85rem;
    padding: 10px 14px 10px 38px;
    border: 1px solid #d7d5de;
    border-radius: 999px;
    background: var(--color-paper);
    color: var(--color-ink);
    box-shadow: var(--shadow-sm);
  }

  .pc-search::placeholder {
    color: var(--color-meta);
    opacity: 1;
  }

  .pc-search:focus {
    outline: 2px solid var(--color-blue-dark);
    outline-offset: 1px;
  }


  .pc-search-hint {
    margin: 0;
    padding: 10px 18px 14px;
    font-size: 0.76rem;
    color: #8a7f7a;
    flex: none;
    background: var(--color-paper);
  }

  /* Во время поиска подсказка-пример становится лишней (сама строка ввода уже занята). */
  .price-checklist:has(.pc-search:not(:placeholder-shown)) .pc-search-hint {
    display: none;
  }

  .pc-groups {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 12px 14px 14px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    align-content: start;
  }

  /* Пока идёт поиск — обычный список в один столбец (могут совпасть сразу
     несколько папок/линеек, карточная сетка с "прячем не открытое" сюда не подходит). */
  .price-checklist:has(.pc-search:not(:placeholder-shown)) .pc-groups {
    display: block;
  }

  .pc-group-brand {
    background: var(--color-blue-dark);
    border: 1px solid var(--color-blue-dark);
    border-radius: 10px;
  }

  /* Плоский список товаров прямо в открытой карточке бренда (без вложенных линеек) —
     свой белый "лист", иначе тёмный текст товаров потеряется на синем/красном фоне карточки. */
  .pc-group-brand > .pc-group-body > ul {
    background: var(--color-paper);
  }

  .price-checklist:has(.pc-search:not(:placeholder-shown)) .pc-group-brand {
    margin-bottom: 8px;
  }

  .pc-group-brand[open] {
    grid-column: 1 / -1;
    background: var(--color-paper);
    border-color: var(--color-paper);
  }

  .pc-group-brand[open] > summary {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    gap: 6px;
    color: #fff;
    background: var(--color-blue-dark);
    border-radius: 999px;
    padding: 8px 16px;
    margin: 14px 0 0 16px;
    box-shadow: var(--shadow-sm);
  }

  /* Плоский бренд (без линеек, data-has-lines="0") в открытом виде - не синяя "пилюля", а
     обычная белая строка: имя убрано целиком (оно и так уже в заголовке диалога, см. JS
     toggle-обработчик), остаются только шеврон/счётчик/лупа - по прямой просьбе пользователя
     2026-09-04 ("делай на белом фоне без названия... убери синеву"). У брендов С линейками эта
     синяя пилюля остаётся как была - там summary видна ТОЛЬКО в режиме категорий (см. правило
     выше), где название реально нужно (одновременно открыто много брендов, не один). */
  .pc-group-brand[data-has-lines="0"][open] > summary {
    display: flex;
    color: var(--color-ink);
    background: var(--color-paper);
    border: none;
    border-bottom: 1px solid var(--color-panel-line);
    border-radius: 0; /* иначе наследуется 999px от синей пилюли (.pc-group-brand[open] > summary
                          выше) - нижняя линия закруглялась по краям вместо прямой, реальная
                          жалоба пользователя, скриншот "линия-тень изогнутая" */
    padding: 12px 14px;
    margin: 0;
    box-shadow: none;
  }

  .pc-group-brand[data-has-lines="0"][open] > summary .pc-row-name {
    display: none;
  }

  .pc-group-brand[data-has-lines="0"][open] > summary .pc-group-count {
    color: #8a7f7a;
  }

  .pc-group-brand[data-has-lines="0"][open] > summary .pc-row-chevron {
    color: var(--color-blue-dark);
  }

  .pc-group-brand[data-has-lines="0"][open] > summary .pc-row-search-btn {
    border-color: var(--color-panel-line);
    color: var(--color-meta);
    background: var(--color-paper);
  }

  .pc-group-brand[data-has-lines="0"][open] > summary .pc-row-search-btn:hover {
    border-color: var(--color-blue-dark);
    color: var(--color-blue-dark);
  }

  .pc-group-brand[open] > summary .pc-group-count {
    color: rgba(255, 255, 255, 0.75);
  }

  /* Пока список папок листается (не идёт поиск) — открытая папка/линейка разворачивается
     во всю ширину, а остальные закрытые карточки на этом уровне прячутся, чтобы не мешать. */
  .price-checklist:has(.pc-search:placeholder-shown) .pc-groups:has(.pc-group-brand[open]) .pc-group-brand:not([open]) {
    display: none;
  }

  .price-checklist:has(.pc-search:placeholder-shown) .pc-group-body:has(.pc-group-line[open]) .pc-group-line:not([open]) {
    display: none;
  }

  .pc-group[hidden] {
    display: none;
  }

  .pc-group-brand > summary {
    padding: 14px 16px;
  }

  .pc-group-line > summary {
    padding: 12px 14px;
  }

  .pc-group summary {
    cursor: pointer;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.98rem;
    color: var(--color-ink);
    list-style: none;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
  }

  /* Порядок в строке: шеврон в начале (перед названием), лупа+счётчик - в самом конце. По
     прямой просьбе пользователя (2026-09-04): изначально оба элемента были справа вместе,
     не читалось однозначно "это переключатель, а это поиск". Имя - flex:1, забирает всё
     свободное место между шевроном и правым блоком, поэтому именно оно "растягивает" строку.
     (flex:none у самого шеврона задан ниже, вместе с остальными его стилями.) */
  .pc-row-name {
    flex: 1 1 auto;
    min-width: 0;
  }

  .pc-group-brand > summary {
    color: #fff;
  }

  .pc-group-brand > summary .pc-group-count {
    color: var(--color-panel);
  }

  .pc-group-line > summary {
    font-size: 0.9rem;
  }

  .pc-group summary::-webkit-details-marker { display: none; }

  .pc-group-count {
    font-family: var(--font-sans);
    font-weight: 400;
    color: #8a7f7a;
    font-size: 0.8rem;
  }

  /* Подкатегории «Акции» по ступени скидки — раньше были сплошной цветной заливкой
     («сухие плашки», по отзыву пользователя 2026-09-04) — теперь белая карточка
     с акцентной полосой слева и цветным текстом, 15%/7% всё ещё различимы с
     первого взгляда, но не выглядят голым цветным блоком. */
  .pc-tier-15,
  .pc-tier-7 {
    background: var(--color-paper);
    border: none;
    border-left: 4px solid var(--color-panel-line);
    box-shadow: var(--shadow-card);
  }

  .pc-tier-15 {
    border-left-color: var(--color-red);
  }

  .pc-tier-15 > summary {
    color: var(--color-red);
  }

  .pc-tier-15 > summary .pc-group-count {
    color: var(--color-red);
    opacity: 0.75;
  }

  .pc-tier-7 {
    border-left-color: var(--color-red);
  }

  .pc-tier-7 > summary {
    color: var(--color-red);
  }

  .pc-tier-7 > summary .pc-group-count {
    color: var(--color-red);
    opacity: 0.75;
  }

  .pc-group-body {
    padding-bottom: 4px;
  }

  /* При обычном пролистывании открыт ОДИН бренд за раз - его имя уже показано в заголовке
     диалога (см. JS toggle-обработчик ниже), дублирующая плашка-заголовок в самом списке
     лишняя, прячем её визуально. Сам <summary> остаётся в DOM (нужен для нативного
     открытия/закрытия <details>), сворачивание уже есть через кнопку «Назад» и повторный
     тап по «Каталогу»/«Акциям». В режиме «По категории» (см. JS, root.dataset.categoryMode)
     открывается сразу МНОГО брендов одновременно, а заголовок диалога показывает название
     категории, не бренда - тут плашку-пилюлю наоборот нужно оставить видимой, иначе список
     превращается в товары одной портянкой без подписи бренда (реальная жалоба пользователя,
     2026-09-03: "не могу разобраться какого бренда товар").
     ТОЛЬКО для брендов С линейками (data-has-lines="1") - у них открытые линии сами дают
     видимую навигацию (свой шеврон+лупа на каждой). У брендов БЕЗ линеек (плоский список
     товаров сразу) прятать нечем заменить - весь шеврон+лупа полностью исчезали бы у ЛЮБОГО
     такого бренда после открытия (реальная жалоба пользователя, 2026-09-04: "в брендах что
     без подпапках нет стрелки и лупы") - для них summary остаётся видимой и открытой. */
  .price-checklist:not([data-category-mode="1"]) .pc-group-brand[data-has-lines="1"][open] > summary {
    display: none;
  }

  .pc-group-brand > .pc-group-body {
    display: block;
    padding: 14px 4px 8px;
  }

  .pc-group-brand > .pc-group-body > ul {
    padding: 4px 10px;
    margin: 4px 0;
  }

  /* Линейки внутри бренда — те же тонкие строки-списки, что и сами бренды в общем
     каталоге (см. .pc-group-brand:not([open]) выше), а не закрашенные синие плитки. */
  .pc-group-line:not([open]) {
    background: var(--color-paper);
    border: none;
    border-bottom: 1px solid var(--color-panel-line);
    border-radius: 0;
  }

  .pc-group-line:not([open]) > summary {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    /* Правый паддинг больше левого - компенсирует то, что линейка вложена в .pc-group-body
       (у него своё меньшее правое поле) - без этого лупа/шеврон линейки сидели на 10px ближе
       к краю экрана, чем те же элементы у бренда, и сетка "не собиралась" (реальная жалоба
       пользователя 2026-09-04: "выравни лупы по сетке"). Значение подобрано по фактическому
       замеру getBoundingClientRect, не на глаз. */
    padding: 12px 24px 12px 14px;
  }

  /* Длинное название линейки переносится на 2+ строки — счётчик не должен переноситься следом
     (иначе "97" и "товаров" расходятся по разным строкам, а стрелка ещё на третью). */
  .pc-group-line:not([open]) > summary .pc-group-count,
  .price-checklist[data-group-by='brand'] .pc-group-brand:not([open]) > summary .pc-group-count {
    flex: none;
    white-space: nowrap;
    text-align: right;
  }

  .pc-group-line > summary {
    color: var(--color-ink);
  }

  .pc-group-line > summary .pc-group-count {
    color: #8a7f7a;
  }

  /* Лупа + счётчик идут одним флекс-блоком справа от названия папки - клик по лупе не должен
     переключать саму папку (см. JS: preventDefault+stopPropagation), поэтому это НАСТОЯЩАЯ
     кнопка, а не просто иконка. По прямой просьбе пользователя (2026-09-04): рядом с каждой
     папкой (бренд/линейка) должна быть подсказка "тут можно искать" - клик по лупе открывает
     папку и переводит фокус в общий поиск (см. data-focus-search в скрипте ниже). */
  .pc-row-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: none;
  }

  /* Кнопка увеличена с первой версии (26px, реальная жалоба пользователя 2026-09-04: слишком
     мелкая — промах пальцем по ней срабатывал как нажатие и уводил фокус в поиск, ощущалось
     как случайный переход "куда-то в бренды"). 34px — уже приличная площадь попадания на
     телефоне, ещё не раздувает компактную строку списка. */
  .pc-row-search-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1.5px solid var(--color-panel-line);
    border-radius: 50%;
    background: var(--color-paper);
    color: var(--color-meta);
    cursor: pointer;
    box-shadow: none;
    flex: none;
  }

  .pc-row-search-btn:hover {
    border-color: var(--color-blue-dark);
    color: var(--color-blue-dark);
    filter: none;
  }

  .pc-group-brand[open] > summary .pc-row-search-btn {
    border-color: rgba(255, 255, 255, 0.5);
    color: #fff;
    background: transparent;
  }

  .pc-group-brand[open] > summary .pc-row-search-btn:hover {
    border-color: #fff;
  }

  /* Шеврон — настоящий SVG, не ::after на мелком тексте счётчика (был еле виден, реальная
     жалоба пользователя). Поворот на 180° при [open] - тот же элемент, не смена символа. */
  .pc-row-chevron {
    flex: none;
    color: var(--color-blue-dark);
    transition: transform 0.2s ease;
  }

  details[open] > summary .pc-row-chevron {
    transform: rotate(180deg);
  }

  .pc-group-brand[open] > summary .pc-row-chevron {
    color: #fff;
  }

  /* Счётчик линейки (`.pc-group-line`) — это total ПО ВСЕМУ прайсу, посчитан один раз при
     сборке страницы, никогда не учитывает текущий фильтр. В обычном пролистывании по бренду
     это правильное число ("сколько всего в этой линейке"). В режиме "По категории" список под
     линейкой уже отфильтрован по конкретной категории и показывает МЕНЬШЕ товаров, чем этот
     total - цифра рядом с названием линейки становится враньём (реальная жалоба пользователя
     2026-09-03, скриншот: "Total Results New 14 товаров" рядом со списком из 5 отфильтрованных
     шампуней). Пересчитывать её на лету не с чем (JS не хранит категорию каждого товара в
     отдельном учёте по линейкам) - проще и честнее просто скрыть цифру в этом режиме. */
  .price-checklist[data-category-mode='1'] .pc-group-line > summary .pc-group-count {
    display: none;
  }

  .pc-group-line ul {
    list-style: none;
    background: var(--color-paper);
    border-radius: 6px;
    margin: 0 0 10px;
    padding: 4px 8px;
  }

  /* Список брендов каталога («Полный прайс») — компактные строки-списки, не крупные закрашенные
     плитки: у Dikson 2 товара, у Londa 170 — плиткой одинакового размера оба выглядели одинаково
     «тяжело», строкой разница видна сразу по подписи. «Акции» (data-group-by="discount") эта
     правка не касается — там ступени скидки остаются акцентными цветными карточками, как были. */
  .price-checklist[data-group-by='brand'] .pc-groups {
    display: block;
  }

  .price-checklist[data-group-by='brand'] .pc-group-brand:not([open]) {
    background: var(--color-paper);
    border: none;
    border-bottom: 1px solid var(--color-panel-line);
