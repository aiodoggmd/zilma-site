    font-size: 0.85rem;
    color: var(--color-red);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 2px 4px 8px;
  }

  /* Строка в том же стиле, что и список брендов (тонкая линия-разделитель, без рамки/фона-
     карточки) — не отдельный визуально «тяжёлый» блок. */
  .pc-best-deal-list {
    list-style: none;
    margin: 0;
    padding: 0 4px;
    border-top: 1px solid var(--color-panel-line);
    border-bottom: 1px solid var(--color-panel-line);
  }

  .pc-best-deal-list .pc-item-name {
    font-weight: 700;
  }

  .pc-best-deal-brand {
    display: block;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink);
    margin-bottom: 1px;
  }

  /* Топ-5 рендерится всегда (сервер не знает ширину экрана) — на мобильном показываем
     только первые 3, чтобы блок не занимал слишком много места над ступенями скидки. */
  @media (max-width: 640px) {
    .pc-best-deal-list .pc-item:nth-child(n + 4) {
      display: none;
    }
  }

  /* Без явного чекбокса везде по каталогу (по просьбе пользователя, 2026-09-04) — активность
     решает количество: 0 = товара нет в заявке, степпер «+» переводит на 1 и сразу добавляет.
     Чекбокс остаётся в DOM (источник состояния для syncItemToCart/поиска), просто скрыт. */
  .pc-check {
    display: none;
  }

  .price-checklist:has(.pc-search:not(:placeholder-shown)) .pc-best-deal {
    display: none;
  }

  /* Пока идёт поиск или уже открыт конкретный бренд — блок «Популярные»/«Все бренды» лишний. */
  .price-checklist:has(.pc-search:not(:placeholder-shown)) .pc-popular {
    display: none;
  }

  .pc-groups:has(.pc-group-brand[open]) .pc-popular {
    display: none;
  }

  /* Открыта конкретная ступень скидки — «Лучшая скидка» вверху списка Акций лишняя, это
     свой отдельный «экран», а не аккордеон рядом с общей витриной. */
  .pc-groups:has(.pc-group-brand[open]) .pc-best-deal {
    display: none;
  }

  .pc-item[hidden] {
    display: none;
  }

  .pc-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 0;
    border-top: 1px solid var(--color-panel-line);
  }

  .pc-item:first-child {
    border-top: none;
  }

  .pc-item label {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    flex: 1;
    min-width: 0;
    cursor: pointer;
  }

  .pc-qty {
    flex: none;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .pc-qty-btn {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1px solid var(--color-panel-line);
    background: #fff;
    color: var(--color-ink);
    font-size: 0.85rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pc-qty-btn:hover {
    background: var(--color-panel);
  }

  .pc-qty-input {
    width: 32px;
    text-align: center;
    font: inherit;
    font-size: 0.85rem;
    border: 1px solid var(--color-panel-line);
    border-radius: 6px;
    padding: 3px 0;
    color: var(--color-ink);
    background: #fff;
    -moz-appearance: textfield;
  }

  .pc-qty-input::-webkit-outer-spin-button,
  .pc-qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .pc-item:not(:has(.pc-check:checked)) .pc-qty {
    opacity: 0.4;
  }

  .pc-item-name {
    flex: 1;
    font-size: 0.9rem;
    color: var(--color-ink);
  }

  .pc-promo .pc-item-name {
    color: var(--color-red);
  }

  .pc-item-price {
    font-size: 0.88rem;
    color: #5c5049;
    white-space: nowrap;
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
  }

  .pc-promo .pc-item-price {
    color: var(--color-red-dark);
  }

  .pc-price-now {
    font-weight: 600;
  }

  .pc-old-price {
    display: block;
    font-size: 0.78rem;
    font-weight: 400;
    color: #8a7f7a;
    text-decoration: line-through;
  }

  .pc-badges {
    display: flex;
    gap: 4px;
  }

  .pc-badge {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    background: var(--color-red);
    color: #fff;
    padding: 2px 6px;
    border-radius: 999px;
  }

  .pc-badge-new {
    background: var(--color-blue-dark);
  }

  .pc-no-results {
    padding: 24px 18px;
    text-align: center;
    color: #8a7f7a;
    font-size: 0.9rem;
  }


  @media (max-width: 640px) {
    .price-checklist {
      /* Открывается через .show() (не .showModal()), см. скрипт ниже — иначе нативный modal-режим
         делает всё остальное содержимое страницы inert (невзаимодействуемым), включая MobileNavBar,
         даже там, где сам диалог физически её не перекрывает. Без modal-режима ::backdrop браузер
         не рисует — сам диалог достаточно непрозрачен, чтобы не растеряться без затемнения фона. */
      top: 0;
      left: 0;
      right: 0;
      bottom: auto;
      margin: 0;
      width: 100vw;
      max-width: 100vw;
      /* На всю высоту экрана (не оставляем зазор снизу) — раньше зазор был нужен под плавающую
         MobileNavBar, но сквозь него было видно реальную страницу позади (реальный случай,
         2026-09-04: сквозь зазор просвечивала красная кнопка «Акции — выбрать и заказать» с
         главной страницы, выглядело как рудимент). Плашка навигации теперь просто лежит ПОВЕРХ
         диалога (z-index у неё выше, см. MobileNavBar.astro) — сам диалог полностью непрозрачен,
         сквозь него ничего не видно. Место для плашки внизу списка — через padding-bottom на
         .pc-groups (см. ниже), а не через дырку в самом диалоге.
         100vh первой строкой — запасной вариант для браузеров без поддержки dvh (100dvh считается
         по фактически видимой области, сам подстраивается под появление/скрытие адресной строки —
         см. реальный баг с "застрявшим" списком, 2026-08-27, актуален и здесь). */
      height: 100vh;
      height: 100dvh;
      max-height: 100vh;
      max-height: 100dvh;
      border-radius: 0;
    }

    .pc-groups {
      padding-bottom: 90px;
    }
  }
</style>

<script>
  // Открытие модалок по клику на любую кнопку с data-open-modal="<id диалога>" (см. PriceBlock.astro).
  // Простой overflow:hidden не спасает: showModal() сам фокусирует кнопку закрытия и браузер асинхронно
  // (уже после нашего кода) скроллит страницу, чтобы она попала в область видимости — window.scrollTo()
  // сразу после showModal() не успевает это перебить. Поэтому используем стандартный приём scroll-lock:
  // body переводится в position:fixed на время открытой модалки — тогда фон физически не может сдвинуться
  // ни от фокуса, ни от колеса/тача внутри диалога, а при закрытии позиция скролла восстанавливается.
  // Переход по баннеру «Больше выгодных предложений» из Каталога в Акции закрывает Каталог
  // (см. openDialog ниже — при открытии одного диалога любой другой открытый закрывается) —
  // без этого флага «Назад» из Акций на верхнем уровне просто закрывал бы всё, высаживая
  // человека на голой странице (реальная жалоба пользователя, 2026-09-04: "ведёт на херо, а
  // не обратно в каталог"). Флаг ставится кликом по баннеру и потребляется/сбрасывается ровно
  // один раз — в обработчике «←» диалога Акций, либо при любом ином закрытии Акций (см. ниже).
  let cameFromCatalogToPromo = false;
  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-open-promo-from-catalog]')) {
      cameFromCatalogToPromo = true;
    }
  });

  let lockedScrollY = 0;
  // Токен для отмены "reassert"-цикла ниже — когда после закрытия диалога нужно уйти к другому
  // месту страницы (напр. к #info по клику на плашке), а не вернуться туда, где было до открытия.
  let reassertToken = 0;
  // Когда true — unlockPageScroll полностью пропускает свою работу при следующем срабатывании
  // (см. closeDialogAndScrollTo: мы уже разлочили страницу сами и уводим её в другое место).
  let skipNextUnlock = false;
  function lockPageScroll() {
    lockedScrollY = window.scrollY;
    document.body.style.position = 'fixed';
    document.body.style.top = `-${lockedScrollY}px`;
    document.body.style.left = '0';
    document.body.style.right = '0';
  }
  function resetBodyLockStyles() {
    document.body.style.position = '';
    document.body.style.top = '';
    document.body.style.left = '';
    document.body.style.right = '';
  }
  function unlockPageScroll() {
    if (skipNextUnlock) {
      skipNextUnlock = false;
      return;
    }
    resetBodyLockStyles();
    window.scrollTo(0, lockedScrollY);
    // close() у <dialog> возвращает фокус на элемент-триггер с задержкой в несколько кадров (замерено
    // ~28мс в Chromium) — этот возврат фокуса сам скроллит страницу уже ПОСЛЕ того как мы её восстановили.
    // Подтверждаем правильную позицию ещё десяток кадров вперёд, чтобы перебить этот запоздалый скачок.
    const myToken = ++reassertToken;
    let ticks = 0;
    function reassert() {
      if (myToken !== reassertToken) return; // отменено — страница уже уводится в другое место
      if (window.scrollY !== lockedScrollY) window.scrollTo(0, lockedScrollY);
      ticks++;
      if (ticks < 15) requestAnimationFrame(reassert);
    }
    requestAnimationFrame(reassert);
  }

  // dialog.close() сам возвращает фокус на элемент-триггер и скроллит к нему страницу и (для диалога,
  // открытого через .show(), см. openDialog) снимает блокировку скролла НЕ синхронно, а с небольшой
  // задержкой — если убрать фокус из диалога непосредственно перед close() (когда активный элемент
  // больше не потомок диалога), браузер видит, что восстанавливать нечего, и лишнего скролла не будет.
  function closeDialog(root: HTMLDialogElement) {
    (document.activeElement as HTMLElement | null)?.blur();
    root.close();
  }

  // Закрывает диалог и сразу уводит взгляд в другое место страницы (якорь с плашки, форма заявки
  // после "Добавить в заявку") — а не туда, где был скролл до открытия диалога. Раз close() снимает
  // блокировку скролла асинхронно (см. выше), обычный scrollIntoView сразу после close() бьётся об
  // ещё зафиксированный body. Поэтому разлочиваем сами тут же, глушим отложенный автоматический
  // unlockPageScroll флагом (иначе он позже откатит скролл туда, где было до открытия) и держим
  // целевую позицию несколько кадров — на случай запоздалого скролла от возврата фокуса (см. выше).
  function closeDialogAndScrollTo(dialog: HTMLDialogElement, target: Element | null) {
    skipNextUnlock = true;
    closeDialog(dialog);
    resetBodyLockStyles();
    if (!target) return;
    const myToken = ++reassertToken;
    let ticks = 0;
    const holdScroll = () => {
      if (myToken !== reassertToken) return;
      target.scrollIntoView({ behavior: 'auto', block: 'start' });
      ticks++;
      if (ticks < 12) requestAnimationFrame(holdScroll);
    };
    holdScroll();
  }

  // Страховка от «мёртвого» сайта после сворачивания с открытым диалогом (реальный кейс,
  // пользователь 2026-08-27: свернул телефон на Каталоге, вернулся — страница не реагирует,
  // помогало только убить вкладку/приложение из памяти). Похоже на то, что мобильный
  // браузер иногда закрывает/теряет синхронизацию с открытым <dialog> при заморозке вкладки
  // в фоне, не давая отработать нашему 'close'-слушателю (см. unlockPageScroll выше) — тогда
  // body остаётся в position:fixed навсегда, и страница выглядит открытой, но не скроллится
  // и не реагирует на тапы. При возврате видимости страницы проверяем: лок стоит, а реально
  // открытого диалога нет — значит лок «осиротел», снимаем его сами.
  function healStuckScrollLock() {
    const anyOpenDialog = document.querySelector('dialog[open]');
    if (!anyOpenDialog && document.body.style.position === 'fixed') {
      resetBodyLockStyles();
      window.scrollTo(0, lockedScrollY || window.scrollY);
    }
  }
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') healStuckScrollLock();
  });
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) healStuckScrollLock();
  });

  function isMobileNav() {
    return window.matchMedia('(max-width: 640px)').matches;
  }

  interface CommittedItem {
    name: string;
    price: number;
    qty: number;
    brand: string;
    promo: boolean;
  }

  // Отметка чекбокса СРАЗУ добавляет/убирает товар из корзины (window.zilmaCart, см. CartStore.astro) —
  // по прямой просьбе пользователя (2026-09-03): отдельная кнопка «Добавить в заявку» лишний шаг,
  // как в обычном интернет-магазине отметка = товар уже в корзине. Мёрджим/убираем по названию,
  // не плодим дублирующие строки (тот же принцип, что раньше был в commitSelection — реальный
  // случай 2026-08-31, "Socolor 505M" дважды разными строками при повторном открытии).
  function syncItemToCart(check: HTMLInputElement, qtyInput: HTMLInputElement | null) {
    const cart: CommittedItem[] = (window as any).zilmaCart?.get() ?? [];
    const name = check.dataset.name ?? '';
    const idx = cart.findIndex((it) => it.name === name);
    if (check.checked) {
      const qty = Math.max(1, parseInt(qtyInput?.value ?? '1', 10) || 1);
      if (idx >= 0) {
        cart[idx].qty = qty;
      } else {
        cart.push({
          name,
          price: parseFloat(check.dataset.price ?? '0') || 0,
          qty,
          brand: check.dataset.brandLabel ?? '',
          promo: check.dataset.promo === '1',
        });
      }
    } else if (idx >= 0) {
      cart.splice(idx, 1);
    }
    (window as any).zilmaCart?.set(cart);
  }

  // На мобильном открываем через .show() (не .showModal()): нативный modal-режим делает ВЕСЬ остальной
  // документ inert (невзаимодействуемым) — это выключило бы MobileNavBar.astro даже в зазоре снизу, где
  // диалог её физически не перекрывает (см. mobile-медиа-запрос выше). На десктопе плашки нет — там
  // поведение остаётся прежним, showModal() с фокус-ловушкой и затемнением фона.
  // Повторный клик по той же кнопке ("Каталог"), пока список уже открыт и клиент залистался внутрь
  // раскрытой папки (бренд/линейка с длинным списком товаров) — сворачивает обратно к списку папок,
  // чтобы не листать наверх вручную. Отмеченные чекбоксы не трогает — только .open у <details> и скролл.
  // Переключает активную вкладку каталога («По категории» / «По бренду») — общая функция,
  // нужна и из обработчиков кликов по вкладкам, и из collapseToFolderList (см. ниже), и из
  // выбора конкретной категории (переключает на «По бренду», чтобы показать результат).
  function setActiveTab(dialog: HTMLDialogElement, tab: 'category' | 'brand') {
    dialog.dataset.activeTab = tab;
    const categoryScreen = dialog.querySelector<HTMLElement>('[data-category-screen]');
    const brandPanel = dialog.querySelector<HTMLElement>('[data-brand-panel]');
    if (categoryScreen) categoryScreen.hidden = tab !== 'category';
    if (brandPanel) brandPanel.hidden = tab !== 'brand';
    dialog.querySelectorAll<HTMLButtonElement>('[data-mode-tab]').forEach((btn) => {
      btn.classList.toggle('active', btn.dataset.modeTab === tab);
    });
  }

  function collapseToFolderList(dialog: HTMLDialogElement) {
    // Если сворачиваем из фильтра по категории — возвращаемся именно на вкладку «По
    // категории» (туда, откуда пришли), а не оставляем «По бренду» с уже неактуальным
    // фильтром. Обычное сворачивание бренда (без категории) вкладку не трогает.
    const wasCategoryMode = dialog.dataset.categoryMode === '1';
    delete dialog.dataset.categoryMode;
    if (wasCategoryMode) setActiveTab(dialog, 'category');
    const headerTitle = dialog.querySelector<HTMLElement>('.pc-header h3');
    if (headerTitle && dialog.dataset.originalHeading != null) {
      headerTitle.textContent = dialog.dataset.originalHeading;
      const isTierDialog = dialog.dataset.groupBy === 'discount';
      headerTitle.classList.toggle('pc-header-logo', !isTierDialog);
      headerTitle.classList.toggle('pc-header-tier', isTierDialog);
    }
    dialog.querySelectorAll<HTMLDetailsElement>('.pc-group').forEach((d) => {
      d.open = false;
    });
    // Фильтр по категории (см. [data-filter-category]) прячет несовпавшие товары через
    // li.hidden напрямую, в обход обычного поиска — сбрасываем здесь же, иначе после выхода
    // из категории и захода в обычный бренд там могли остаться "залипшие" скрытые строки.
    dialog.querySelectorAll<HTMLLIElement>('.pc-item[hidden]').forEach((li) => {
      li.hidden = false;
    });
    const search = dialog.querySelector<HTMLInputElement>('.pc-search');
    if (search && search.value) {
      search.value = '';
      search.dispatchEvent(new Event('input', { bubbles: true }));
    }
    // Реальный баг на Android (найден пользователем 2026-08-27): резкое схлопывание сразу многих
    // <details> меняет высоту списка одним синхронным рывком, и если тут же скроллить новым
    // scrollTo() — мобильный Chrome иногда не успевает пересчитать границы скролла и дальше не
    // даёт пролистать список до конца (застревает на середине). Помогает: ждать кадр отрисовки
    // (браузер успевает переразметить укороченный список) и сбрасывать позицию простым свойством
    // scrollTop, а не новым scrollTo() API — так надёжнее на этом классе устройств.
    // При выходе ИМЕННО из фильтра по категории возвращаем скролл туда, где стояла карточка
    // категории до перехода (см. её сохранение в обработчике [data-filter-category] выше) -
    // иначе пользователь тапнувший категорию ближе к концу списка карточек попадал бы каждый
    // раз обратно на самый верх. Обычное сворачивание бренда (без категории) по-прежнему
    // сбрасывает наверх - там это ожидаемо, список брендов и так короткий и открывается заново.
    const savedScrollY = wasCategoryMode ? Number(dialog.dataset.categoryScrollY ?? 0) : 0;
    delete dialog.dataset.categoryScrollY;
    delete dialog.dataset.preSearchTab;
    delete dialog.dataset.categoryFilter;
    const scrollEl = dialog.querySelector<HTMLElement>('.pc-groups');
    if (scrollEl) {
      requestAnimationFrame(() => {
        scrollEl.scrollTop = savedScrollY;
      });
    }
  }

  function openDialog(dialog: HTMLDialogElement) {
    // Если переключаемся между Каталогом и Акциями (клик по плашке, когда одно окно уже открыто) —
    // просто закрываем его: отмеченное уже в корзине (см. syncItemToCart — коммитить отдельно
    // больше не нужно, каждая отметка уже сразу применена).
    document.querySelectorAll<HTMLDialogElement>('[data-checklist]').forEach((d) => {
      if (d !== dialog && d.open) {
        closeDialog(d);
      }
    });
    if (dialog.open) {
      collapseToFolderList(dialog);
      return;
    }
    lockPageScroll();
    if (isMobileNav()) {
      dialog.show();
    } else {
      dialog.showModal();
    }
    document.dispatchEvent(new CustomEvent('zilma:nav-show'));
  }

  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest('[data-open-modal]') as HTMLElement | null;
    if (!trigger) return;
    const id = trigger.getAttribute('data-open-modal');
    const dialog = id && document.getElementById(id);
    if (dialog instanceof HTMLDialogElement) openDialog(dialog);
  });

  // Автооткрытие по хэшу-команде из плашки быстрой навигации (MobileNavBar.astro), которая всегда
  // ссылается на главную (единственная страница, где гарантированно есть обе модалки).
  // hashchange — на случай клика, когда мы уже на главной (полной перезагрузки страницы не будет),
  // и когда переключаемся между уже открытыми Каталогом/Акциями прямо с плашки.
  const HASH_TO_DIALOG: Record<string, string> = {
    '#open-catalog': 'checklist-current-dialog',
    '#open-promo': 'checklist-promo-dialog',
  };
  function openFromHash() {
    const hash = location.hash;
    const targetId = HASH_TO_DIALOG[hash];
    if (targetId) {
      const dialog = document.getElementById(targetId);
      if (dialog instanceof HTMLDialogElement) openDialog(dialog);
      history.replaceState(null, '', location.pathname + location.search);
      return;
    }

    // Хэш не команда открытия окна (например, "#info" по клику на плашку). Если сейчас открыт
    // Каталог/Акции — страница физически не может проскроллиться к цели, пока не разлочена
    // (см. closeDialogAndScrollTo); иначе кнопка выглядит "неживой": и сама не закрывается, и
    // никуда не ведёт.
    const openDlg = document.querySelector<HTMLDialogElement>('[data-checklist][open]');
    const target = hash.length > 1 ? document.getElementById(hash.slice(1)) : null;
    if (openDlg) {
      closeDialogAndScrollTo(openDlg, target);
    } else {
      target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    history.replaceState(null, '', location.pathname + location.search);
  }
  openFromHash();
  window.addEventListener('hashchange', openFromHash);

  document.querySelectorAll<HTMLDialogElement>('[data-checklist]').forEach((dialog) => {
    dialog.addEventListener('close', unlockPageScroll);
    dialog.addEventListener('close', () => document.dispatchEvent(new CustomEvent('zilma:nav-show')));
    // Флаг «пришли из Каталога» нужен ровно на один следующий клик «←» в Акциях (см. выше) —
    // если Акции закрылись любым ДРУГИМ способом (клик по подложке, повторный тап по «Акции»
    // на плашке), флаг сбрасываем, чтобы он не «выстрелил» ошибочно в другой раз.
    if (dialog.id === 'checklist-promo-dialog') {
      dialog.addEventListener('close', () => {
        cameFromCatalogToPromo = false;
      });
    }

    // Автоскрытие MobileNavBar при скролле списка внутри диалога: листаем дальше вниз по списку —
    // плашка уезжает, чтобы не мешать; возвращаемся к началу — плашка появляется снова.
    const scrollArea = dialog.querySelector<HTMLElement>('.pc-groups');
    let lastTop = 0;
    scrollArea?.addEventListener(
      'scroll',
      () => {
        const top = scrollArea.scrollTop;
        const delta = top - lastTop;
        if (Math.abs(delta) > 6) {
          document.dispatchEvent(new CustomEvent(delta > 0 ? 'zilma:nav-hide' : 'zilma:nav-show'));
          lastTop = top;
        }
      },
      { passive: true }
    );
  });

  // Точку/запятую в номере оттенка приравниваем к слэшу — "wella 1.9" должно находить
  // товар с "1/9" в названии, люди печатают код оттенка кто как привык.
  function normalizeSearch(s: string): string {
    // Код оттенка разные бренды/люди пишут через точку/запятую/дефис - все приравниваем к
    // слэшу (применяется и к запросу, и к индексируемым названиям товаров одинаково, см.
    // searchIndex ниже - поэтому симметрично работает в обе стороны). Добавлен дефис
    // 2026-09-03: WELLA пишет код через дефис ("CT 10-81"), Londa через слэш ("10/81") -
    // без этого поиск "10/81" находил Londa, но не Color Touch, хотя это один и тот же код.
    return s.toLowerCase().replace(/[.,-]/g, '/');
  }

  // Часть товаров в прайсе названа латиницей (бренды/линии/английские слова) — мастер,
  // печатающий кириллицей ("иллюмина", "шварцкопф"), иначе ничего не найдёт. Побуквенная
  // транслитерация не подходит — реальное произношение часто расходится с ней (Shinefinity
  // читается "шайнфинити", а не "шинефинити"), поэтому вместо алгоритма — словарь реальных
  // известных пар для всех значимых латинских слов из priceItems.json (бренды, линии,
  // частые английские слова в названиях — не служебные аббревиатуры вроде CT/KP/LC, их
  // никто не произносит по-русски). Значения — уже нормализованные (нижний регистр).
  const CYRILLIC_ALIASES: Record<string, string> = {
    матрикс: 'matrix', велла: 'wella', оллин: 'ollin', лонда: 'londa',
    шварцкопф: 'schwarzkopf', лебель: 'lebel', лебел: 'lebel', капус: 'kapous',
    концепт: 'concept', диксон: 'dikson', эстель: 'estel', карепрост: 'careprost',
    левиссим: 'levissime', лореаль: "l'oreal", лореал: "l'oreal", искартес: 'iskartes',
    игора: 'igora', блондми: 'blondme', иллюмина: 'illumina', шайнфинити: 'shinefinity',
    колестон: 'koleston',
    эйми: 'eimi', инвиго: 'invigo', соколор: 'socolor', синк: 'sync', ладор: 'la`dor',
    озис: 'osis', осис: 'osis', силуэт: 'silhouette',
    тач: 'touch', колор: 'color', кэр: 'care', кеа: 'care', софт: 'soft', блонд: 'blond',
    нью: 'new', тотал: 'total', силк: 'silk', ойл: 'oil', вельвет: 'velvet',
    перфект: 'perfect', бриллианс: 'brilliance', профи: 'profy',
  };

  // Разные бренды называют один и тот же тип товара разными словами — осветляющий
  // порошок у Wella зовётся "Блондор", у Londa "Блондоран", у Ollin/Matrix "Супра",
  // а мастер может искать и общим словом "порошок"/"пудра"/"осветляющий". Это не
  // фонетическая пара (как в CYRILLIC_ALIASES выше), а группа взаимозаменяемых слов —
  // если запрос совпал с одним словом из группы, ищем товар по ЛЮБОМУ слову из той же
  // группы. "освет" без окончания — так ловится и "осветляющий", и опечатка в прайсе
  // "осветяющий" (без "л"), и "освет." (сокращение).
  const SYNONYM_GROUPS: string[][] = [
    ['супра', 'блондор', 'блондоран', 'порошок', 'пудра', 'освет'],
  ];

  // Расстояние Левенштейна (число правок буква→буква, чтобы получить одно слово из другого) —
  // основа терпимости к опечаткам ниже. Стандартная DP-реализация, ничего специфичного для
  // сайта. Слова тут короткие (до ~20 символов), полная матрица O(n*m) не создаёт проблем
  // даже при пересчёте на каждое нажатие клавиши.
  function levenshtein(a: string, b: string): number {
    const m = a.length;
    const n = b.length;
    if (m === 0) return n;
    if (n === 0) return m;
    let prev = Array.from({ length: n + 1 }, (_, j) => j);
    for (let i = 1; i <= m; i++) {
      const cur = [i];
      for (let j = 1; j <= n; j++) {
        cur[j] = a[i - 1] === b[j - 1]
          ? prev[j - 1]
          : 1 + Math.min(prev[j - 1], prev[j], cur[j - 1]);
      }
      prev = cur;
    }
    return prev[n];
  }

  // Сколько правок ещё считаем "опечаткой", а не другим словом — чем короче слово, тем
  // строже порог (иначе короткие слова/коды типа "лак" превращались бы друг в друга).
  function fuzzyThreshold(len: number): number {
    if (len <= 5) return 1;
    if (len <= 9) return 2;
    return 3;
  }

  // Для одного токена запроса собираем ВСЕ подстроки, которые считаем совпадением: сам токен,
  // алиас кириллица↔латиница (в обе стороны), синонимы (см. SYNONYM_GROUPS), и, если ничего
  // из этого не нашло точного слова в словаре каталога, ближайшее по опечатке настоящее слово
  // (напр. "калистон"/"kaliston"/"kolesto" → "колестон", т.к. в прайсе только эта кириллица).
  // Считается ОДИН РАЗ на токен перед проходом по всем товарам, не на каждый товар отдельно -
  // иначе Левенштейн против всего словаря на каждой строке списка (~1100 раз) был бы заметно
  // медленнее. Короткие токены (<4 симв., в т.ч. служебные коды CT/LC/KP) фаззи не трогает -
  // на таких словах опечатка неотличима от другого реального кода.
  function expandAliases(word: string, terms: Set<string>): void {
    const alias = CYRILLIC_ALIASES[word];
    if (alias) terms.add(alias);
    for (const cyr in CYRILLIC_ALIASES) {
      if (CYRILLIC_ALIASES[cyr] === word) terms.add(cyr);
    }
  }

  function resolveSearchTerms(token: string, vocabulary: Set<string>, fuzzyPool: Set<string>): string[] {
    const terms = new Set<string>([token]);
    expandAliases(token, terms);
    const group = SYNONYM_GROUPS.find((g) => g.some((w) => token.includes(w) || w.includes(token)));
    if (group) group.forEach((w) => terms.add(w));
    // Фаззи-сравнение идёт против ПОЛНОГО пула (словарь каталога + сами ключи/значения
    // CYRILLIC_ALIASES) — иначе опечатка в коротком алиасном слове ("иллюмина"/"колестон",
    // которых буквально НЕТ в тексте прайса как отдельное кириллическое слово, только как
    // ключ словаря) не находила бы вообще ничего для сравнения. Найденное исправление
    // дополнительно прогоняется через expandAliases - "kolesto" → "koleston" (фаззи) →
    // "колестон" (алиас), а не просто "koleston" сам по себе, которого в данных нет.
    if (token.length >= 4 && !vocabulary.has(token) && !fuzzyPool.has(token)) {
      const maxDist = fuzzyThreshold(token.length);
      let best: string | null = null;
      let bestDist = Infinity;
      for (const word of fuzzyPool) {
        if (Math.abs(word.length - token.length) > maxDist) continue; // дешёвая отсечка перед Левенштейном
        const d = levenshtein(token, word);
        if (d <= maxDist && d < bestDist) {
          bestDist = d;
          best = word;
        }
      }
      if (best) {
        terms.add(best);
        expandAliases(best, terms);
      }
    }
    return [...terms];
  }

  // Словарь реальных слов каталога для fuzzy-сравнения — берём из уже нормализованных
  // name/brand/line (не из сырых данных, чтобы регистр/разделители совпадали с тем, с чем
  // сравнивает Левенштейн). Разбивка по границам "не буква" (цифры, слэши, кавычки и т.п.) -
  // код оттенка вроде "10/81" никогда не попадёт в словарь как единое "слово", только текст.
  const WORD_SPLIT_RE = /[^a-zа-яё']+/i;
  function buildVocabulary(entries: Iterable<{ name: string; brand: string; line: string }>): Set<string> {
    const vocab = new Set<string>();
    for (const entry of entries) {
      for (const field of [entry.name, entry.brand, entry.line]) {
        for (const w of field.split(WORD_SPLIT_RE)) {
          if (w.length >= 4) vocab.add(w);
        }
      }
    }
    return vocab;
  }

  // Пул для фаззи-сравнения = словарь каталога + все ключи/значения CYRILLIC_ALIASES - иначе
  // опечатка в самом алиасном слове ("иллюмина", "колестон") не находила бы что исправлять,
  // ведь этих слов буквально нет в тексте прайса как отдельное слово (см. resolveSearchTerms).
  const FUZZY_POOL = new Set<string>([
    ...Object.keys(CYRILLIC_ALIASES),
    ...Object.values(CYRILLIC_ALIASES),
  ]);

  document.querySelectorAll<HTMLDialogElement>('[data-checklist]').forEach((root) => {
    const search = root.querySelector<HTMLInputElement>('.pc-search');
    const items = [...root.querySelectorAll<HTMLLIElement>('.pc-item')];
    const groups = [...root.querySelectorAll<HTMLDetailsElement>('.pc-group')];
    const checks = [...root.querySelectorAll<HTMLInputElement>('.pc-check')];
    // Схлопывание открытой линии/бренда резко меняет высоту списка - без явного восстановления
    // scrollTop браузер обрезает его под новую (меньшую) высоту, отбрасывая пользователя наверх
    // списка вместо того места, где он был. Общая функция (не только для кнопки "Назад" - см.
    // её использование там же, но и для НАТИВНОГО закрытия кликом по самой строке/шеврону,
    // см. toggle-слушатели ниже) - реальная жалоба пользователя 2026-09-04: "кнопка назад
    // работает хорошо..., а стрелка нет" - кнопка "Назад" явно вызывала восстановление, а клик
    // по строке/шеврону просто закрывал <details> нативно, без какого-либо восстановления.
    // Восстанавливаем именно ТУ позицию, что была в момент клика по строке (см. data-entry-
    // scroll-y, ставится при открытии), а не текущую - если пользователь успел долистать список
    // товаров внутри, откат должен быть к строке в общем списке, а не к месту чтения товаров.
    const scrollEl = root.querySelector<HTMLElement>('.pc-groups');
    const restoreEntryScroll = (groupEl: HTMLDetailsElement) => {
      const y = groupEl.dataset.entryScrollY;
      if (y === undefined || !scrollEl) return;
      const target = Number(y);
      requestAnimationFrame(() => {
        scrollEl.scrollTop = target;
      });
    };
    // Индекс на каждый товар — считаем один раз, не при каждом нажатии клавиши.
    const searchIndex = new Map<HTMLLIElement, { name: string; brand: string; line: string }>(
      items.map((li) => [
        li,
        {
          name: normalizeSearch(li.dataset.name ?? ''),
          brand: normalizeSearch(li.dataset.brand ?? ''),
          line: normalizeSearch(li.dataset.line ?? ''),
        },
      ])
    );
    // Тот же однократный расчёт, что и searchIndex выше - словарь для fuzzy-сравнения строится
    // из уже нормализованных полей, не пересчитывается на каждое нажатие клавиши.
    const vocabulary = buildVocabulary(searchIndex.values());
    const fuzzyPool = new Set<string>([...vocabulary, ...FUZZY_POOL]);
    const noResults = root.querySelector<HTMLElement>('.pc-no-results');

    // Отдельной кнопки «✕ Закрыть» больше нет (пользователь справедливо заметил: рядом с «←»
    // и всегда доступной нижней плашкой навигации она лишняя). Стрелка «←» теперь «умная»:
    // внутри открытого бренда — сворачивает к списку папок (как раньше), а на самом верхнем
    // уровне (папки уже свёрнуты) — закрывает диалог целиком, как обычная кнопка «Назад».

    // «←» — назад РОВНО на один экран, не сразу в самый верх (реальная жалоба пользователя:
    // из открытой линии внутри бренда один клик улетал сразу к списку папок, минуя список
    // линий этого бренда). Порядок шагов от самого глубокого к самому верхнему:
    // 1) активен фильтр категории (гамбургер) → снять целиком ПЕРВЫМ делом — это не цепочка
    //    вложенных экранов, а один оверлей, который сам открывает МНОГО линий/брендов сразу
    //    (по всем совпадениям); если проверять открытую линию раньше категории, «Назад»
    //    закрывал бы линии по одной вместо честного выхода из фильтра за один клик (реальный
    //    баг, найден пользователем 2026-09-04 — то же применимо и к «Акциям», где тиры/бренды
    //    устроены той же парой классов pc-group-brand/pc-group-line);
    // 2) открыта линия внутри бренда (обычное, не категориальное листание) → закрыть только её;
    // 3) идёт поиск → просто очистить поле;
    // 4) открыт бренд (или ступень скидки в «Акциях») → закрыть его;
    // 5) ничего не открыто и не активно → закрыть диалог целиком.
    root.querySelector('[data-back-to-folders]')?.addEventListener('click', () => {
      if (root.dataset.categoryMode === '1') {
        collapseToFolderList(root);
        return;
      }
      // Восстановление позиции - см. restoreEntryScroll(), объявлена выше вместе с groups (там
      // же общий комментарий) - используется и здесь, и в toggle-слушателях ниже (нативное
      // закрытие кликом по строке/шеврону, а не только кнопкой "Назад").
      const openLine = root.querySelector<HTMLDetailsElement>('.pc-group-line[open]');
      if (openLine) {
        restoreEntryScroll(openLine);
        openLine.open = false;
        return;
      }
      if (search && search.value) {
        search.value = '';
        search.dispatchEvent(new Event('input', { bubbles: true }));
        return;
      }
      const openBrand = root.querySelector<HTMLDetailsElement>('.pc-group-brand[open]');
      if (openBrand) {
        restoreEntryScroll(openBrand);
        openBrand.open = false;
        return;
      }
      // На самом верхнем уровне Акций, если сюда попали именно из Каталога (баннер) — «Назад»
      // должен вернуть в Каталог, а не просто закрыть всё на голую страницу.
      if (root.id === 'checklist-promo-dialog' && cameFromCatalogToPromo) {
        cameFromCatalogToPromo = false;
        closeDialog(root);
        const catalogDialog = document.getElementById('checklist-current-dialog');
        if (catalogDialog instanceof HTMLDialogElement) openDialog(catalogDialog);
        return;
      }
      closeDialog(root);
    });

    // Открытая карточка верхнего уровня (бренд в Каталоге, ступень скидки в Акциях) ведёт
    // себя как отдельный «экран»: заголовок и подсказка поиска меняются на её имя, пока она
    // открыта — визуально не просто раскрытый аккордеон в общем списке, а переход внутрь.
    // Работает для ОБОИХ groupBy — и .pc-group-brand[data-brand], и ступени скидки в Акциях
    // используют тот же атрибут data-brand (там это имя ступени "Скидка 15%"/"Скидка 7%").
    const headerTitle = root.querySelector<HTMLElement>('.pc-header h3');
    const originalHeading = headerTitle?.textContent ?? '';
    root.dataset.originalHeading = originalHeading;
    const defaultSearchPlaceholder = search?.placeholder ?? '';

    // Две вкладки-режима («По бренду»/«По категории») — «По бренду» активна по умолчанию
    // (реальная поправка пользователя, 2026-09-04: клиенты Zilma — мастера, которые уже
    // точно знают нужный бренд и щепетильны к замене между брендами даже при технической
    // взаимозаменяемости товара, см. оксиды/гид-статьи; категория — для меньшинства ещё не
    // определившихся, не для основной аудитории). Третья вкладка «По задаче» из этой же
    // идеи убрана насовсем (не просто отложена) — пользователь считает её лишней: мастера
    // сами знают тонкости замены товара лучше любого упрощённого фильтра «по задаче»
    // (пример: шампунь для окрашенных волос при отсутствии заменяем только на увлажняющий,
    // не любой другой — не раскрывает кутикулу и не смывает цвет; см. память проекта
    // feedback_zilma-brand-first-navigation).
    setActiveTab(root, 'brand');
    root.querySelectorAll<HTMLButtonElement>('[data-mode-tab]').forEach((btn) => {
      if (btn.disabled) return;
      btn.addEventListener('click', () => {
        const tab = btn.dataset.modeTab as 'category' | 'brand';
        // Явный ручной выбор вкладки отменяет любое отложенное "вернуть на категорию после
        // очистки поиска" (см. preSearchTab в обработчике .pc-search input) - иначе стартовав
        // новый поиск уже с вкладки «По бренду», можно было случайно улететь обратно в
        // категории при очистке поля, хотя пользователь сюда пришёл сам, не через поиск.
        delete root.dataset.preSearchTab;
        setActiveTab(root, tab);
      });
    });

    {
      root.querySelectorAll<HTMLDetailsElement>('.pc-group-brand').forEach((brandEl) => {
        // Настоящий клик по названию бренда - это ОСОЗНАННАЯ навигация ("зашёл в этот бренд
        // листать"), а не побочный эффект поиска (который тоже открывает подходящие бренды,
        // просто чтобы показать результат). Снимаем маркер openedBySearch (см. ниже, в
        // обработчике .pc-search input) - иначе следующий не связанный запрос ошибочно решил
        // бы, что мы "внутри экрана" этого бренда, и обрезал бы результаты только по нему
        // (реальный баг, найден 2026-09-03: поиск "wela" случайно открыл WELLA как
        // единственное совпадение, следующий поиск "шварцкоф" из-за этого вернул 0 вместо 106).
        brandEl.querySelector('summary')?.addEventListener('click', () => {
          delete brandEl.dataset.openedBySearch;
          // Запоминаем прокрутку списка РОВНО в момент захода (клик по ещё закрытой строке) -
          // восстановится и по кнопке "Назад" (см. [data-back-to-folders] выше), и при обычном
          // закрытии кликом по самой строке/шеврону (см. toggle ниже) - а не текущую на момент
          // выхода (которая может быть глубоко внутри списка товаров, если пользователь успел
          // долистать). Реальная жалоба пользователя 2026-09-04.
          if (!brandEl.open) {
            const scrollEl = root.querySelector<HTMLElement>('.pc-groups');
            if (scrollEl) brandEl.dataset.entryScrollY = String(scrollEl.scrollTop);
          }
          // Помечаем, что СЛЕДУЮЩИЙ toggle этого элемента вызван настоящим кликом пользователя,
          // а не поиском/категорией (те тоже программно меняют .open, но НЕ через клик по этой
          // summary) - только для настоящего клика нужно восстанавливать скролл при закрытии,
          // иначе случайное закрытие поиском откатывало бы прокрутку туда, где её не ждут.
          brandEl.dataset.userToggled = '1';
        });
        brandEl.addEventListener('toggle', () => {
          // Фильтр по категории открывает СРАЗУ много брендов — без этой проверки каждый
          // такой toggle (событие асинхронное, см. requestAnimationFrame в обработчике
          // категории) по очереди перезаписывал бы шапку СВОИМ именем бренда вместо
          // названия категории, последний открытый просто побеждал бы гонку.
          if (root.dataset.categoryMode === '1') return;
          // "Кнопка назад работает хорошо..., а стрелка нет" - реальная жалоба пользователя
          // 2026-09-04: клик по строке/шеврону просто закрывал <details> нативно, браузер сам
          // обрезал scrollTop под новую высоту без всякого восстановления (кнопка "Назад" уже
          // явно вызывала restoreEntryScroll, а это - нет). Только для НАСТОЯЩЕГО клика
          // (userToggled, см. summary click выше) - не для программных toggle от поиска/категорий.
          if (brandEl.dataset.userToggled === '1') {
            delete brandEl.dataset.userToggled;
            if (!brandEl.open) restoreEntryScroll(brandEl);
          }
          const brandName = brandEl.dataset.brand;
          // Ступень скидки (Акции) — тот же шрифт/размер, что у обычного имени бренда, но
          // красным и прописными (по прямой просьбе пользователя) — свой отдельный класс,
          // не .pc-header-logo (у него другой шрифт/размер, это именно логотип).
          const isTier = root.dataset.groupBy === 'discount';
          if (brandEl.open && brandName) {
            if (headerTitle) {
              headerTitle.textContent = brandName;
              headerTitle.classList.remove('pc-header-logo');
              headerTitle.classList.toggle('pc-header-tier', isTier);
            }
            if (search) search.placeholder = `Поиск по ${brandName}…`;
          } else if (!brandEl.open) {
            if (headerTitle) {
              headerTitle.textContent = originalHeading;
              headerTitle.classList.toggle('pc-header-logo', !isTier);
              headerTitle.classList.toggle('pc-header-tier', isTier);
            }
            if (search) search.placeholder = defaultSearchPlaceholder;
          }
        });
      });
      // Та же запись точки входа для линеек внутри бренда - "Назад" из открытой линии тоже
      // должен вернуть туда, где она была в списке, а не на верх списка линий. Плюс то же
      // различение "настоящий клик / программный toggle" (userToggled), что и у брендов выше -
      // иначе закрытие линии поиском тоже откатывало бы прокрутку.
      root.querySelectorAll<HTMLDetailsElement>('.pc-group-line').forEach((lineEl) => {
        lineEl.querySelector('summary')?.addEventListener('click', () => {
          if (!lineEl.open) {
            const scrollEl = root.querySelector<HTMLElement>('.pc-groups');
            if (scrollEl) lineEl.dataset.entryScrollY = String(scrollEl.scrollTop);
          }
          lineEl.dataset.userToggled = '1';
        });
        lineEl.addEventListener('toggle', () => {
          if (lineEl.dataset.userToggled === '1') {
            delete lineEl.dataset.userToggled;
            if (!lineEl.open) restoreEntryScroll(lineEl);
          }
        });
      });
    }

    // Корзинка-счётчик в шапке — тот же приём, что у пункта «Заявка» нижней плашки
    // (MobileNavBar.astro): на главной ведёт мгновенным якорем, с других страниц — на
    // отдельную лёгкую страницу /order/ (без херо), бейдж читает общее хранилище корзины.
    const cartLink = root.querySelector<HTMLAnchorElement>('[data-cart-link]');
    if (cartLink && location.pathname === '/') cartLink.href = '/#order';
    const cartBadge = root.querySelector<HTMLElement>('[data-cart-badge]');
    function updateCartBadge() {
      if (!cartBadge) return;
      const cart = (window as any).zilmaCart?.get() ?? [];
      const count = Array.isArray(cart) ? cart.length : 0;
      cartBadge.textContent = String(count);
      cartBadge.hidden = count === 0;
    }
    document.addEventListener('zilma:cart-updated', updateCartBadge);
    updateCartBadge();

    // Лупа рядом с названием папки (бренд/линейка) - подсказка "тут можно искать" + быстрый
    // переход в общий поиск. Кнопка лежит ВНУТРИ <summary> - обычный клик по ней сначала бы
    // сработал как нативный тоггл самой папки (клик по любому потомку summary всплывает и
    // запускает встроенное открытие/закрытие <details>), preventDefault останавливает именно
    // это, дальше папка открывается ЯВНО (а не переключается - двойного эффекта не будет,
    // даже если она уже была открыта), а фокус уходит в input.
    root.querySelectorAll<HTMLButtonElement>('.pc-row-search-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const details = btn.closest<HTMLDetailsElement>('details.pc-group');
        if (details) {
          // Клик по лупе гасится stopPropagation() выше - обработчик клика на самой summary
          // (см. ниже, записывает data-entry-scroll-y) до неё не долетает, точку входа нужно
          // сохранить прямо тут же, иначе "Назад" после открытия ЧЕРЕЗ ЛУПУ восстанавливать
          // нечего (реальный баг, найден пользователем 2026-09-04, скриншот "LONDA возвращается
          // сюда" - позиция была случайной, а не той, откуда реально заходили через лупу).
          if (!details.open) {
            const scrollEl = root.querySelector<HTMLElement>('.pc-groups');
            if (scrollEl) details.dataset.entryScrollY = String(scrollEl.scrollTop);
          }
          details.open = true;
          delete details.dataset.openedBySearch; // клик по лупе - осознанное действие, не побочный эффект поиска
        }
        search?.focus();
        search?.scrollIntoView({ block: 'nearest' });
      });
    });

    // Карточка «Популярные» — ярлык на нужный бренд в общем алфавитном списке ниже,
    // не отдельный дублирующий рендер товаров.
    root.querySelectorAll<HTMLButtonElement>('[data-jump-to-brand]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const name = btn.dataset.jumpToBrand ?? '';
        groups.forEach((g) => {
          if (g.classList.contains('pc-group-brand')) g.open = false;
        });
        const target = root.querySelector<HTMLDetailsElement>(`.pc-group-brand[data-brand="${CSS.escape(name)}"]`);
        if (target) {
          delete target.dataset.openedBySearch; // осознанный переход, не побочный эффект поиска
          target.open = true;
          target.scrollIntoView({ block: 'start', behavior: 'smooth' });
        }
      });
    });

    // Карточка «Категории» — фильтр по типу товара (эвристика по названию, см. frontmatter
    // компонента). В отличие от «Популярные» (ярлык на ОДИН бренд), категория обычно
    // встречается сразу во многих брендах — открываем ВСЕ бренды/линейки, где нашлось
    // совпадение, прячем остальные. Работает поверх той же CSS-логики "прячь неоткрытых
    // соседей" (:has(.pc-search:placeholder-shown) ...) — она уже реагирует на .open, ничего
    // отдельно для категорий дорабатывать не пришлось.
    root.querySelectorAll<HTMLButtonElement>('[data-filter-category]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.dataset.filterCategory ?? '';
        // Запоминаем, где именно в сетке карточек категорий (см. .pc-category-screen) стоял
        // скролл ДО перехода к отфильтрованному списку - collapseToFolderList() восстановит
        // именно эту позицию при выходе, а не всегда сбрасывает наверх (см. её же коммент).
        // Реальная жалоба пользователя 2026-09-03: тапнул категорию ближе к концу списка
        // карточек, а "Назад" возвращал на самый верх, а не туда, откуда заходил.
        const groupsEl = root.querySelector<HTMLElement>('.pc-groups');
        if (groupsEl) root.dataset.categoryScrollY = String(groupsEl.scrollTop);
        setActiveTab(root, 'brand');
        root.dataset.categoryMode = '1';
        // Запоминаем САМУ категорию (не только факт "режим категорий активен") - обработчик
        // поиска ниже использует это, чтобы искать ТОЛЬКО внутри выбранной категории, а не
        // сбрасывать фильтр при вводе текста (см. коммент у search input listener).
        root.dataset.categoryFilter = cat;
        let anyVisibleTotal = false;
        groups.forEach((g) => {
          const groupItems = [...g.querySelectorAll<HTMLLIElement>('.pc-item')];
          let anyVisible = false;
          groupItems.forEach((li) => {
            const match = li.dataset.category === cat;
            li.hidden = !match;
            if (match) anyVisible = true;
          });
          g.hidden = !anyVisible;
          // НЕ разворачиваем автоматически (было g.open = anyVisible) - по прямой просьбе
          // пользователя 2026-09-04: выбор категории раньше сразу открывал ВСЕ подходящие
          // бренды разом, список товаров превращался в одну длинную портянку без структуры.
          // Теперь показываем только список папок (бренд/линейка) со счётчиком и треугольником
          // ▾ - пользователь сам решает, какую открыть (та же логика, что в обычном «По
          // бренду», просто список короче за счёт фильтра по категории).
          g.open = false;
          if (anyVisible) anyVisibleTotal = true;
        });
        if (noResults) noResults.hidden = anyVisibleTotal;
        if (headerTitle) {
          headerTitle.textContent = cat;
          headerTitle.classList.remove('pc-header-logo');
        }
        root.querySelector('.pc-groups')?.scrollTo({ top: 0 });
      });
    });
    // Клик по подложке (::backdrop) — событие всплывает с target === сам dialog, а не его содержимое.
    root.addEventListener('click', (e) => {
      if (e.target === root) closeDialog(root);
    });

    // Отмеченное здесь может измениться СНАРУЖИ (товар убрали в корзине на странице заявки,
    // истёк TTL и т.п.) — держим чекбоксы синхронными с реальным содержимым корзины, а не
    // только со своими собственными кликами.
    function syncCheckedFromCart() {
      const cart: CommittedItem[] = (window as any).zilmaCart?.get() ?? [];
      const byName = new Map(cart.map((it) => [it.name, it]));
      checks.forEach((c) => {
        const entry = byName.get(c.dataset.name ?? '');
        const qtyInput = c.closest('.pc-item')?.querySelector<HTMLInputElement>('.pc-qty-input');
        c.checked = !!entry;
        if (qtyInput) qtyInput.value = entry ? String(entry.qty) : qtyInput.min || '1';
      });
    }
    syncCheckedFromCart();
    document.addEventListener('zilma:cart-updated', syncCheckedFromCart);

    // Степпер количества: +/- меняют значение и, если товар ещё не отмечен, отмечают его.
    // Любое изменение (отметка, снятие отметки, +/-, ручной ввод количества) сразу применяется
    // к корзине через syncItemToCart — отдельного шага «подтвердить» больше нет.
    root.querySelectorAll<HTMLElement>('.pc-item').forEach((li) => {
      const check = li.querySelector<HTMLInputElement>('.pc-check');
      const qtyInput = li.querySelector<HTMLInputElement>('.pc-qty-input');
      if (!check || !qtyInput) return;

      // Минимум количества берём из атрибута min самого поля (обычные товары — "1", у карточки
      // «Лучшая скидка» без видимого чекбокса — "0": количество 0 само по себе значит "не в
      // заявке", "+" от 0 до 1 добавляет, "−" обратно до 0 убирает — чекбокс скрыт, но остаётся
      // источником состояния для syncItemToCart/поиска, просто управляется только степпером).
      const floor = Number(qtyInput.min) || 0;

      function clamp() {
        const n = Math.max(floor, Math.min(999, parseInt(qtyInput!.value, 10) || floor));
        qtyInput!.value = String(n);
        return n;
      }

      li.querySelectorAll<HTMLButtonElement>('.pc-qty-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const dir = Number(btn.dataset.qtyDir) || 0;
          const n = Math.max(floor, Math.min(999, (parseInt(qtyInput.value, 10) || floor) + dir));
          qtyInput.value = String(n);
          if (n === 0) {
            if (check.checked) {
              check.checked = false;
              syncItemToCart(check, qtyInput);
            }
          } else if (!check.checked) {
            check.checked = true;
            check.dispatchEvent(new Event('change'));
          } else {
            syncItemToCart(check, qtyInput);
          }
        });
      });

      qtyInput.addEventListener('change', () => {
        const n = clamp();
        if (n === 0 && check.checked) {
          check.checked = false;
          syncItemToCart(check, qtyInput);
        } else if (check.checked) {
          syncItemToCart(check, qtyInput);
        }
      });
      qtyInput.addEventListener('input', () => {
        const n = parseInt(qtyInput.value, 10) || 0;
        if (n > 0 && !check.checked) {
          check.checked = true;
          check.dispatchEvent(new Event('change'));
        } else if (n === 0 && check.checked) {
          check.checked = false;
          syncItemToCart(check, qtyInput);
        } else if (check.checked) {
          syncItemToCart(check, qtyInput);
        }
      });

      check.addEventListener('change', () => {
        if (check.checked) {
          // Чекбокс скрыт, но по-прежнему переключается кликом по названию/цене (нативное
          // поведение <label>) — если это произошло при количестве 0, показываем честную
          // единицу (в корзину в любом случае уйдёт минимум 1, см. syncItemToCart).
          if ((parseInt(qtyInput.value, 10) || 0) < 1) qtyInput.value = '1';
        } else {
          qtyInput.value = qtyInput.min || '1';
        }
        syncItemToCart(check, qtyInput);
      });
    });

    search?.addEventListener('input', () => {
      // Каждое слово запроса ищем по отдельности (не всю строку целиком) — так "wella 1.9"
      // находит товар, у которого "wella" в бренде, а "1/9" (точка = слэш) — в названии,
      // даже если это не идёт подряд как в запросе.
      const tokens = normalizeSearch(search.value.trim()).split(/\s+/).filter(Boolean);
      // Термины на каждый токен считаем ОДИН раз здесь (алиасы + fuzzy-опечатка), не на каждый
      // товар в цикле ниже - Левенштейн против всего словаря один раз на нажатие клавиши, а не
      // ~1100 раз (см. resolveSearchTerms). Опечатки вроде "калистон"/"kaliston"/"ilumina"
      // резолвятся здесь в реальное слово каталога ("колестон"/"illumina"), дальше обычная
      // проверка "содержит подстроку" против уже найденного термина.
      const tokenTerms = tokens.map((t) => resolveSearchTerms(t, vocabulary, fuzzyPool));
      // Поиск ищет по товарам/брендам, а не по категориям — если ввели что-то, пока была
      // активна вкладка «По категории», переключаем на «По бренду», чтобы результат было видно.
      // Запоминаем, откуда переключили (`preSearchTab`) — реальная жалоба пользователя
      // 2026-09-03: стёр текст поиска и остался на «По бренду» плоским списком закрытых папок,
      // хотя начинал с экрана категорий; «Назад» после этого не возвращал на исходный экран,
      // просто чистил уже пустое поле. При очистке поиска возвращаем вкладку обратно.
      if (tokens.length > 0 && root.dataset.activeTab === 'category') {
        root.dataset.preSearchTab = 'category';
        setActiveTab(root, 'brand');
      } else if (tokens.length === 0 && root.dataset.preSearchTab === 'category') {
        delete root.dataset.preSearchTab;
        setActiveTab(root, 'category');
      }
      // В режиме "По категории" уже открыты МНОГО брендов одновременно (по всем совпадениям
      // фильтра) - "экран одного бренда" тут не действует, иначе поиск хватал бы первый
      // попавшийся открытый бренд и прятал все остальные (реальный баг, найден пользователем
      // 2026-09-03: искал Color Touch внутри категории "Безаммиачные красители", поиск
      // застрял на L'OREAL - первом открытом бренде по алфавиту - и WELLA/Color Touch вместе
      // со всеми остальными брендами просто исчезли из результатов).
      const activeCategory = root.dataset.categoryMode === '1' ? root.dataset.categoryFilter ?? '' : null;
      // Если уже открыт конкретный бренд («экран бренда», обычное пролистывание вне категорий) —
      // поиск ищет только внутри него, не по всему прайсу: набирая "7/0" внутри LONDA, не
      // хочется внезапно улететь в WELLA. Сам заголовок открытого бренда не трогаем (не прячем,
      // не сворачиваем) — это текущий экран, а не результат поиска среди прочих.
      // data-opened-by-search исключает бренды, открытые ПРЕДЫДУЩИМ поиском как побочный
      // эффект (см. summary click listener выше) - иначе следующий несвязанный запрос считал
      // бы, что мы всё ещё "внутри" случайно совпавшего бренда, и резал бы результаты только
      // по нему (реальный баг 2026-09-03: "wela" → открыл WELLA единственным совпадением →
      // следующий поиск "шварцкоф" вернул 0 вместо 106).
      const openBrand = activeCategory === null
        ? groups.find((g) => g.classList.contains('pc-group-brand') && g.open && g.dataset.openedBySearch !== '1')
        : undefined;
      let anyVisibleTotal = false;
      groups.forEach((g) => {
        // Другой (не текущий) бренд верхнего уровня, пока мы внутри «экрана» одного бренда —
        // всегда прячем, не полагаясь на CSS-трюк для пустого поиска (он работает только
        // пока :placeholder-shown, а тут уже что-то введено).
        if (openBrand && g.classList.contains('pc-group-brand') && g !== openBrand) {
          g.hidden = true;
          return;
        }
        const groupItems = [...g.querySelectorAll<HTMLLIElement>('.pc-item')];
        let anyVisible = false;
        groupItems.forEach((li) => {
          // В режиме категории товар обязан совпадать И с категорией, И с текстом поиска -
          // иначе ввод текста молча снимал бы фильтр категории и показывал вообще весь прайс.
          const categoryOk = activeCategory === null || li.dataset.category === activeCategory;
          const entry = searchIndex.get(li);
          const tokensOk = tokens.length === 0 || !entry || tokenTerms.every((terms) =>
            terms.some((term) => entry.name.includes(term) || entry.brand.includes(term) || entry.line.includes(term))
          );
          const match = categoryOk && tokensOk;
          li.hidden = !match;
          if (match) anyVisible = true;
        });
        if (g === openBrand) {
          g.hidden = false; // текущий экран бренда всегда виден, поиск лишь фильтрует товары внутри
        } else {
          g.hidden = !anyVisible;
          const shouldOpen = anyVisible && (tokens.length > 0 || activeCategory !== null);
          g.open = shouldOpen;
          // Помечаем ТОЛЬКО бренды верхнего уровня (не линейки внутри) - именно их состояние
          // читает openBrand-детекция выше. Маркер снимается кликом по summary (см. выше) -
          // это и есть граница между "открыто поиском" и "открыто пользователем вручную".
          if (g.classList.contains('pc-group-brand')) {
            if (shouldOpen) g.dataset.openedBySearch = '1';
            else delete g.dataset.openedBySearch;
          }
        }
        if (anyVisible) anyVisibleTotal = true;
      });
      if (noResults) noResults.hidden = anyVisibleTotal || items.length === 0;
    });
  });
</script>
