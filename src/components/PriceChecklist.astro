    transition: box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .pc-popular-card:hover {
    border-color: var(--color-blue-dark);
    box-shadow: var(--shadow-card-hover);
  }

  .pc-popular-name {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--color-ink);
  }

  .pc-popular-count {
    font-size: 0.78rem;
    color: #8a7f7a;
  }

  /* Баннер-приглашение в «Акции» прямо внутри каталога — по просьбе пользователя (2026-09-03),
     не отдельная невидимая кнопка, а часть обычного просмотра каталога. Красный (не синий, как
     на референсе) — на сайте красный уже устойчиво значит «акция/скидка» (бейдж «Акция»,
     ступень 15% и т.п.), синий тут был бы не к месту. */
  .pc-promo-banner {
    display: flex;
    flex-direction: column;
    gap: 3px;
    background: linear-gradient(135deg, var(--color-red-dark), var(--color-red));
    color: #fff;
    border-radius: 10px;
    padding: 14px 40px 14px 16px;
    margin-bottom: 18px;
