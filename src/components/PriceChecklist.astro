---
interface Item {
  id: number;
  brand: string | null;
  line: string | null;
  name: string;
  price: number;
  promo: boolean;
  oldPrice?: number;
  discountPct?: number;
  isNew?: boolean;
  stock?: number;
}

interface Props {
  items: Item[];
  instanceId: string;
  heading: string;
  // 'discount' — верхний уровень группировки не бренд, а ступень скидки (15%/7%),
  // бренд становится вложенным уровнем внутри. Только для окна «Акции».
  groupBy?: 'brand' | 'discount';
}

const { items, instanceId, heading, groupBy = 'brand' } = Astro.props;
const dialogId = `${instanceId}-dialog`;

// Сортировка: сначала латиница (A-Z), потом кириллица (А-Я), внутри каждой — по алфавиту.
function scriptRank(s: string): number {
  const ch = s.trim().charAt(0);
  if (/[A-Za-z]/.test(ch)) return 0;
  if (/[А-Яа-яЁё]/.test(ch)) return 1;
  return 2;
}
function alphaCompare(a: string, b: string): number {
  const ra = scriptRank(a);
  const rb = scriptRank(b);
  if (ra !== rb) return ra - rb;
  return a.localeCompare(b, ra === 0 ? 'en' : 'ru', { sensitivity: 'base' });
}

// Двухуровневая группировка: бренд (напр. WELLA) -> линейка внутри бренда (напр. EIMI) -> товары.
// Пустой ключ '' — товары без линейки, показываются плоским списком прямо под брендом.
const brandMap = new Map<string, Map<string, Item[]>>();
for (const it of items) {
  const b = it.brand ?? 'Другое';
  const l = it.line ?? '';
  if (!brandMap.has(b)) brandMap.set(b, new Map());
  const lineMap = brandMap.get(b)!;
  if (!lineMap.has(l)) lineMap.set(l, []);
  lineMap.get(l)!.push(it);
}

const byName = (a: Item, b: Item) => alphaCompare(a.name, b.name);

const brandEntries = [...brandMap.entries()]
  .sort((a, b) => alphaCompare(a[0], b[0]))
  .map(([brand, lineMap]) => {
    const flat = [...(lineMap.get('') ?? [])].sort(byName);
    const lineEntries = [...lineMap.entries()]
      .filter(([l]) => l !== '')
      .sort((a, b) => alphaCompare(a[0], b[0]))
      .map(([line, list]) => [line, [...list].sort(byName)] as [string, Item[]]);
    const total = [...lineMap.values()].reduce((s, arr) => s + arr.length, 0);
    return { brand, total, flat, lineEntries };
  });

function pluralItems(n: number): string {
  const mod10 = n % 10;
  const mod100 = n % 100;
  if (mod100 >= 11 && mod100 <= 14) return 'товаров';
  if (mod10 === 1) return 'товар';
  if (mod10 >= 2 && mod10 <= 4) return 'товара';
  return 'товаров';
}

// «Популярные бренды» — не топ-4 по количеству позиций (так туда попадал бы, например, OLLIN
// просто за счёт объёма прайса), а флагманские бренды Zilma — те же, что в подзаголовке хиро
// на главной («Wella · Londa · Schwarzkopf · Matrix · Lebel»). Показываем, только если брендов
// реально много (иначе блок-ярлык на 4 из 5 бессмысленен).
const PREFERRED_POPULAR_BRANDS = ['WELLA', 'LONDA', 'SCHWARZKOPF', 'MATRIX'];
const brandByName = new Map(brandEntries.map((b) => [b.brand, b]));
const popularBrands = groupBy === 'brand' && brandEntries.length > 5
  ? PREFERRED_POPULAR_BRANDS.map((name) => brandByName.get(name)).filter((b): b is (typeof brandEntries)[number] => Boolean(b))
  : [];

// «Категории» — в прайсе нет отдельного поля типа товара, поэтому категория определяется
// эвристикой по ключевым словам в названии. Неидеально (пограничные случаи возможны), но
// достаточно для навигации по каталогу — точная ручная разметка ~1150 позиций не нужна.
const CATEGORY_ORDER = ['Окрашивание', 'Уход', 'Стайлинг', 'Инструменты'] as const;
type Category = (typeof CATEGORY_ORDER)[number];
const CATEGORY_KEYWORDS: Record<Category, string[]> = {
  Окрашивание: [
    'краска', 'краситель', 'оттенок', 'оксид', 'окисл', 'welloxon', 'блондор',
    'блондоран', 'блонд', 'супра', 'осветл', 'осветя', 'тонир', 'мелиран',
    'пигмент', 'корректор цвета',
  ],
  Уход: [
    'шампунь', 'бальзам', 'маска', 'кондиционер', 'сыворотка', 'эссенция',
    'филлер', 'уход', 'крем для волос', 'флюид для волос',
  ],
  Стайлинг: [
    'лак для волос', 'лак ', 'мусс', 'гель', 'пенка', 'спрей', 'воск',
    'текстур', 'стайлинг', 'моделирующ',
  ],
  Инструменты: [
    'ножниц', 'расчёск', 'расческ', 'фен', 'зажим', 'фольга', 'перчатк',
    'кисть', 'пеньюар', 'полотенце', 'диффузор', 'утюжок', 'плойка',
    'накидк', 'пелерин', 'шапочк', 'одноразов',
  ],
};
function categorize(name: string): Category | null {
  const n = name.toLowerCase();
  for (const cat of CATEGORY_ORDER) {
    if (CATEGORY_KEYWORDS[cat].some((kw) => n.includes(kw))) return cat;
  }
  return null;
}
const categoryCounts = groupBy === 'brand'
  ? CATEGORY_ORDER.map((cat) => ({ cat, total: items.filter((it) => categorize(it.name) === cat).length })).filter((c) => c.total > 0)
  : [];

// Группировка по ступени скидки (15%/7%) -> бренд -> товары — только для окна «Акции».
// Ступени идут в фиксированном порядке (большая скидка первой), а не по алфавиту.
const DISCOUNT_TIER_ORDER = [15, 7];
function discountTierLabel(pct: number | undefined): string {
  return pct != null ? `Скидка ${pct}%` : 'Акция';
}

let discountEntries: { tier: string; total: number; brandEntries: [string, Item[]][] }[] = [];
if (groupBy === 'discount') {
  const tierMap = new Map<string, Map<string, Item[]>>();
  for (const it of items) {
    const tier = discountTierLabel(it.discountPct);
    const b = it.brand ?? 'Другое';
    if (!tierMap.has(tier)) tierMap.set(tier, new Map());
    const bMap = tierMap.get(tier)!;
    if (!bMap.has(b)) bMap.set(b, []);
    bMap.get(b)!.push(it);
  }
  discountEntries = [...tierMap.entries()]
    .sort((a, b) => {
      const ia = DISCOUNT_TIER_ORDER.indexOf(parseInt(a[0].replace(/\D/g, ''), 10));
      const ib = DISCOUNT_TIER_ORDER.indexOf(parseInt(b[0].replace(/\D/g, ''), 10));
      if (ia !== -1 || ib !== -1) return (ia === -1 ? 999 : ia) - (ib === -1 ? 999 : ib);
      return alphaCompare(a[0], b[0]);
    })
    .map(([tier, bMap]) => {
      const total = [...bMap.values()].reduce((s, arr) => s + arr.length, 0);
      const brandEntriesForTier = [...bMap.entries()]
        .sort((a, b) => alphaCompare(a[0], b[0]))
        .map(([brand, list]) => [brand, [...list].sort(byName)] as [string, Item[]]);
      return { tier, total, brandEntries: brandEntriesForTier };
    });
}

// «Лучшая скидка» — честная витрина без придуманного таймера/дедлайна (в прайсе нет реальных
// time-limited кампаний, скидка — постоянный флаг до следующего обновления прайса).
// Критерий отбора — ПО ПРЯМОЙ ПРОСЬБЕ ПОЛЬЗОВАЛЬНОГО (2026-09-04): не самая большая скидка
// в рублях (её и так видно по бейджу — рекламировать очевидное бессмысленно), а наибольший
// реальный остаток на складе (src/data/priceItems.json, поле stock — из Price/Остатки_*.xlsx,
// см. scripts/xlsx-to-price-items.py). Смысл — не украшательство, а реальная бизнес-задача:
// быстрее продать то, чего скопилось больше всего. Товары без известного остатка (поле stock
// отсутствует — артикул оказался неоднозначным при сопоставлении) в отбор не попадают, не
// придумываем цифру. По одному лучшему (по остатку) товару от каждого бренда — топ-5.
const bestDeals = groupBy === 'discount'
  ? (() => {
      const bestPerBrand = new Map<string, Item>();
      for (const it of items) {
        if (!it.promo || it.oldPrice == null || it.stock == null) continue;
        if (it.name.toLowerCase().includes('дозатор')) continue; // расходник/аксессуар, не полноценный товар
        const brand = it.brand ?? 'Другое';
        const current = bestPerBrand.get(brand);
        if (!current || it.stock > (current.stock ?? 0)) {
          bestPerBrand.set(brand, it);
        }
      }
      return [...bestPerBrand.values()]
        .sort((a, b) => (b.stock ?? 0) - (a.stock ?? 0))
        .slice(0, 3);
    })()
  : [];
---
<dialog class="price-checklist" data-checklist data-group-by={groupBy} id={dialogId}>
  <div class="pc-header">
    {categoryCounts.length > 0 && (
      <div class="pc-menu-wrap">
        <button type="button" class="pc-menu-btn" data-menu-toggle aria-expanded="false">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="18" x2="21" y2="18" />
          </svg>
          <span class="pc-menu-btn-label">Категории</span>
        </button>
        <div class="pc-menu-dropdown" data-menu-dropdown hidden>
          {categoryCounts.map(({ cat, total }) => (
            <button type="button" class="pc-menu-item" data-filter-category={cat}>
              <span>{cat}</span>
              <span class="pc-menu-item-count">{total}</span>
            </button>
          ))}
        </div>
      </div>
    )}
    <div class="pc-header-brand">
      <h3 class="pc-header-logo">{heading}</h3>
      {heading === 'ZILMA' && <p class="pc-header-tagline">Профессиональная косметика</p>}
    </div>
    <a href="/order/#order" class="pc-cart-link" data-cart-link aria-label="Перейти в заявку">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 8V6a3 3 0 0 1 6 0v2" />
        <path d="M6 8h12l1.3 12.2a2 2 0 0 1-2 2.3H6.7a2 2 0 0 1-2-2.3L6 8Z" />
      </svg>
      <span class="pc-cart-badge" data-cart-badge hidden>0</span>
    </a>
  </div>
  <div class="pc-controls">
    <button type="button" class="pc-back" data-back-to-folders aria-label="Назад к списку папок">←</button>
    <div class="pc-search-wrap">
      <svg class="pc-search-icon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7" />
        <line x1="21" y1="21" x2="16.65" y2="16.65" />
      </svg>
      <input type="search" class="pc-search" placeholder="Поиск по товару, бренду или линейке…" aria-label="Поиск по прайсу" />
    </div>
  </div>
  <p class="pc-search-hint">Например: Koleston 7/0, Londa, шампунь…</p>
  <div class="pc-groups">
    {popularBrands.length > 0 && (
      <div class="pc-popular">
        <p class="pc-popular-title">Популярные</p>
        <div class="pc-popular-grid">
          {popularBrands.map(({ brand, total }) => (
            <button type="button" class="pc-popular-card" data-jump-to-brand={brand}>
              <span class="pc-popular-name">{brand}</span>
              <span class="pc-popular-count">{total} {pluralItems(total)}</span>
            </button>
          ))}
        </div>
        <a href="/#open-promo" class="pc-promo-banner" data-open-promo-from-catalog>
          <span class="pc-promo-banner-title">Больше выгодных предложений</span>
          <span class="pc-promo-banner-sub">Специальные скидки при заказе через сайт</span>
          <span class="pc-promo-banner-arrow" aria-hidden="true">→</span>
        </a>
        <p class="pc-all-title">Все бренды</p>
      </div>
    )}
    {groupBy === 'brand' && brandEntries.map(({ brand, total, flat, lineEntries }) => (
      <details class="pc-group pc-group-brand" data-brand={brand}>
        <summary>{brand} <span class="pc-group-count">{total} {pluralItems(total)}</span></summary>
        <div class="pc-group-body">
          {flat.length > 0 && (
            <ul>
              {flat.map((it) => (
                <li class:list={['pc-item', { 'pc-promo': it.promo }]} data-name={it.name.toLowerCase()} data-brand={brand.toLowerCase()} data-line="" data-category={categorize(it.name) ?? ''}>
                  <label>
                    <input type="checkbox" class="pc-check" data-name={it.name} data-price={it.price} data-brand-label={brand} data-promo={it.promo ? '1' : ''} />
                    <span class="pc-item-name">{it.name}</span>
                    <span class="pc-item-price">
                      <b class="pc-price-now">{it.price} ₽</b>
                      {it.promo && it.oldPrice != null && <span class="pc-old-price">{it.oldPrice} ₽</span>}
                      {(it.promo || it.isNew) && (
                        <span class="pc-badges">
                          {it.promo && <span class="pc-badge">{it.discountPct ? `-${it.discountPct}%` : 'Акция'}</span>}
                          {it.isNew && <span class="pc-badge pc-badge-new">Н</span>}
                        </span>
                      )}
                    </span>
                  </label>
                  <div class="pc-qty">
                    <button type="button" class="pc-qty-btn" data-qty-dir="-1" aria-label="Меньше">−</button>
                    <input type="number" class="pc-qty-input" value="0" min="0" max="999" inputmode="numeric" aria-label="Количество" />
                    <button type="button" class="pc-qty-btn" data-qty-dir="1" aria-label="Больше">+</button>
                  </div>
                </li>
              ))}
            </ul>
          )}
          {lineEntries.map(([line, list]) => (
            <details class="pc-group pc-group-line">
              <summary>{line} <span class="pc-group-count">{list.length} {pluralItems(list.length)}</span></summary>
              <ul>
                {list.map((it) => (
                  <li class:list={['pc-item', { 'pc-promo': it.promo }]} data-name={it.name.toLowerCase()} data-brand={brand.toLowerCase()} data-line={line.toLowerCase()} data-category={categorize(it.name) ?? ''}>
                    <label>
                      <input type="checkbox" class="pc-check" data-name={it.name} data-price={it.price} data-brand-label={brand} data-promo={it.promo ? '1' : ''} />
                      <span class="pc-item-name">{it.name}</span>
                      <span class="pc-item-price">
                        <b class="pc-price-now">{it.price} ₽</b>
                        {it.promo && it.oldPrice != null && <span class="pc-old-price">{it.oldPrice} ₽</span>}
                        {(it.promo || it.isNew) && (
                          <span class="pc-badges">
                            {it.promo && <span class="pc-badge">{it.discountPct ? `-${it.discountPct}%` : 'Акция'}</span>}
                            {it.isNew && <span class="pc-badge pc-badge-new">Н</span>}
                          </span>
                        )}
                      </span>
                    </label>
                    <div class="pc-qty">
                      <button type="button" class="pc-qty-btn" data-qty-dir="-1" aria-label="Меньше">−</button>
                      <input type="number" class="pc-qty-input" value="0" min="0" max="999" inputmode="numeric" aria-label="Количество" />
                      <button type="button" class="pc-qty-btn" data-qty-dir="1" aria-label="Больше">+</button>
                    </div>
                  </li>
                ))}
              </ul>
            </details>
          ))}
        </div>
      </details>
    ))}
    {bestDeals.length > 0 && (
      <div class="pc-best-deal">
        <p class="pc-best-deal-label">Лучшая скидка</p>
        <ul class="pc-best-deal-list">
          {bestDeals.map((deal) => (
            <li class:list={['pc-item', { 'pc-promo': deal.promo }]} data-name={deal.name.toLowerCase()} data-brand={(deal.brand ?? '').toLowerCase()} data-line="" data-category={categorize(deal.name) ?? ''}>
              <label>
                <input type="checkbox" class="pc-check" data-name={deal.name} data-price={deal.price} data-brand-label={deal.brand ?? ''} data-promo={deal.promo ? '1' : ''} />
                <span class="pc-item-name">
                  <span class="pc-best-deal-brand">{deal.brand}</span>
                  {deal.name}
                </span>
                <span class="pc-item-price">
                  <b class="pc-price-now">{deal.price} ₽</b>
                  {deal.oldPrice != null && <span class="pc-old-price">{deal.oldPrice} ₽</span>}
                  <span class="pc-badges">
                    <span class="pc-badge">{deal.discountPct ? `-${deal.discountPct}%` : 'Акция'}</span>
                  </span>
                </span>
              </label>
              <div class="pc-qty">
                <button type="button" class="pc-qty-btn" data-qty-dir="-1" aria-label="Меньше">−</button>
                <input type="number" class="pc-qty-input" value="0" min="0" max="999" inputmode="numeric" aria-label="Количество" />
                <button type="button" class="pc-qty-btn" data-qty-dir="1" aria-label="Больше">+</button>
              </div>
            </li>
          ))}
        </ul>
      </div>
    )}
    {groupBy === 'discount' && discountEntries.map(({ tier, total, brandEntries: tierBrandEntries }) => (
      <details class:list={['pc-group', 'pc-group-brand', { 'pc-tier-15': tier === 'Скидка 15%', 'pc-tier-7': tier === 'Скидка 7%' }]} data-brand={tier}>
        <summary>{tier} <span class="pc-group-count">{total} {pluralItems(total)}</span></summary>
        <div class="pc-group-body">
          {tierBrandEntries.map(([brand, list]) => (
            <details class="pc-group pc-group-line">
              <summary>{brand} <span class="pc-group-count">{list.length} {pluralItems(list.length)}</span></summary>
              <ul>
                {list.map((it) => (
                  <li class:list={['pc-item', { 'pc-promo': it.promo }]} data-name={it.name.toLowerCase()} data-brand={brand.toLowerCase()} data-line="" data-category={categorize(it.name) ?? ''}>
                    <label>
                      <input type="checkbox" class="pc-check" data-name={it.name} data-price={it.price} data-brand-label={brand} data-promo={it.promo ? '1' : ''} />
                      <span class="pc-item-name">{it.name}</span>
                      <span class="pc-item-price">
                        <b class="pc-price-now">{it.price} ₽</b>
                        {it.promo && it.oldPrice != null && <span class="pc-old-price">{it.oldPrice} ₽</span>}
                        {(it.promo || it.isNew) && (
                          <span class="pc-badges">
                            {it.promo && <span class="pc-badge">{it.discountPct ? `-${it.discountPct}%` : 'Акция'}</span>}
                            {it.isNew && <span class="pc-badge pc-badge-new">Н</span>}
                          </span>
                        )}
                      </span>
                    </label>
                    <div class="pc-qty">
                      <button type="button" class="pc-qty-btn" data-qty-dir="-1" aria-label="Меньше">−</button>
                      <input type="number" class="pc-qty-input" value="0" min="0" max="999" inputmode="numeric" aria-label="Количество" />
                      <button type="button" class="pc-qty-btn" data-qty-dir="1" aria-label="Больше">+</button>
                    </div>
                  </li>
                ))}
              </ul>
            </details>
          ))}
        </div>
      </details>
    ))}
    <p class="pc-no-results" hidden>Ничего не найдено — попробуйте другой запрос.</p>
  </div>
</dialog>

<style>
  .price-checklist:not([open]) {
    display: none;
  }

  .price-checklist {
    position: fixed;
    inset: 0;
    margin: auto;
    z-index: 140;
    padding: 0;
    border: none;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card-hover);
    width: 92vw;
    max-width: 720px;
    height: 84vh;
    max-height: 84vh;
    display: flex;
    flex-direction: column;
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .price-checklist::backdrop {
    background: rgba(43, 32, 28, 0.55);
  }

  .pc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 18px;
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-panel-line);
    flex: none;
  }

  .pc-header h3 {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.15rem;
    margin: 0;
    color: var(--color-ink);
  }

  .pc-header-brand {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    min-width: 0;
  }

  .pc-menu-wrap {
    position: relative;
    flex: none;
  }

  .pc-menu-dropdown {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    z-index: 5;
    min-width: 280px;
    background: var(--color-paper);
    border: 1px solid var(--color-panel-line);
    border-radius: 14px;
    box-shadow: var(--shadow-card-hover);
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .pc-menu-dropdown[hidden] {
    display: none;
  }

  .pc-menu-item {
    font: inherit;
    text-align: left;
    background: none;
    border: none;
    border-radius: 8px;
    padding: 16px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    cursor: pointer;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.05rem;
  }

  .pc-menu-item:hover {
    background: var(--color-mist);
  }

  .pc-menu-item-count {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 0.85rem;
    color: #8a7f7a;
  }

  .pc-menu-btn {
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    width: auto;
    padding: 2px 4px;
    background: transparent;
    color: var(--color-ink);
    border: none;
    cursor: pointer;
  }

  .pc-menu-btn-label {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .pc-menu-btn:hover {
    color: var(--color-blue-dark);
  }

  /* Заголовок-заглушка по умолчанию — логотип-надпись «ZILMA» по центру шапки (тот же дух,
     что настоящий лого-файл: серифный, красный), плюс подпись бренда под ней. Как только
     открыт конкретный бренд, JS убирает этот класс и подставляет обычное тёмное имя бренда —
     подпись скрывается сама (см. правило на .pc-header-tagline ниже). */
  .pc-header h3.pc-header-logo {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 2.4rem;
    letter-spacing: 0.1em;
    color: var(--color-red);
    text-transform: uppercase;
  }

  /* Заголовок ступени скидки («Скидка 15%/7%») при заходе внутрь — тот же шрифт/размер,
     что у обычного имени бренда (.pc-header h3 без модификаторов), но красным и прописными. */
  .pc-header h3.pc-header-tier {
    color: var(--color-red);
    text-transform: uppercase;
  }

  .pc-header-tagline {
    display: none;
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.46rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #8a7f7a;
  }

  .pc-header-logo + .pc-header-tagline {
    display: block;
  }

  .pc-cart-link {
    position: relative;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: transparent;
    color: var(--color-ink);
  }

  .pc-cart-link:hover {
    color: var(--color-blue-dark);
  }

  .pc-cart-badge {
    position: absolute;
    top: -2px;
    right: -2px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 999px;
    background: var(--color-red);
    color: #fff;
    font-size: 0.62rem;
    font-weight: 700;
    line-height: 16px;
    text-align: center;
    box-shadow: 0 0 0 2px var(--color-paper);
  }

  .pc-cart-badge[hidden] {
    display: none;
  }

  .pc-controls {
    flex: none;
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-panel-line);
    padding: 14px 18px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .pc-back {
    flex: none;
    font: inherit;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-ink);
    background: var(--color-paper);
    border: 1px solid #d7d5de;
    box-shadow: var(--shadow-sm);
    border-radius: 50%;
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    white-space: nowrap;
  }

  .pc-back:hover {
    color: var(--color-blue-dark);
  }

  .pc-search-wrap {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
  }

  .pc-search-icon {
    position: absolute;
    left: 14px;
    color: var(--color-meta);
    pointer-events: none;
  }

  .pc-search {
    width: 100%;
    font: inherit;
    font-size: 0.85rem;
    padding: 10px 14px 10px 38px;
    border: 1px solid #d7d5de;
    border-radius: 999px;
    background: var(--color-paper);
    color: var(--color-ink);
    box-shadow: var(--shadow-sm);
  }

  .pc-search::placeholder {
    color: var(--color-meta);
    opacity: 1;
  }

  .pc-search:focus {
    outline: 2px solid var(--color-blue-dark);
    outline-offset: 1px;
  }


  .pc-search-hint {
    margin: 0;
    padding: 10px 18px 14px;
    font-size: 0.76rem;
    color: #8a7f7a;
    flex: none;
    background: var(--color-paper);
  }

  /* Во время поиска подсказка-пример становится лишней (сама строка ввода уже занята). */
  .price-checklist:has(.pc-search:not(:placeholder-shown)) .pc-search-hint {
    display: none;
  }

  .pc-groups {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 12px 14px 14px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    align-content: start;
  }

  /* Пока идёт поиск — обычный список в один столбец (могут совпасть сразу
     несколько папок/линеек, карточная сетка с "прячем не открытое" сюда не подходит). */
  .price-checklist:has(.pc-search:not(:placeholder-shown)) .pc-groups {
    display: block;
  }

  .pc-group-brand {
    background: var(--color-blue-dark);
    border: 1px solid var(--color-blue-dark);
    border-radius: 10px;
  }

  /* Плоский список товаров прямо в открытой карточке бренда (без вложенных линеек) —
     свой белый "лист", иначе тёмный текст товаров потеряется на синем/красном фоне карточки. */
  .pc-group-brand > .pc-group-body > ul {
    background: var(--color-paper);
  }

  .price-checklist:has(.pc-search:not(:placeholder-shown)) .pc-group-brand {
    margin-bottom: 8px;
  }

  .pc-group-brand[open] {
    grid-column: 1 / -1;
    background: var(--color-paper);
    border-color: var(--color-paper);
  }

  .pc-group-brand[open] > summary {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    gap: 6px;
    color: #fff;
    background: var(--color-blue-dark);
    border-radius: 999px;
    padding: 8px 16px;
    margin: 14px 0 0 16px;
    box-shadow: var(--shadow-sm);
  }

  .pc-group-brand[open] > summary .pc-group-count {
    color: rgba(255, 255, 255, 0.75);
  }

  /* Пока список папок листается (не идёт поиск) — открытая папка/линейка разворачивается
     во всю ширину, а остальные закрытые карточки на этом уровне прячутся, чтобы не мешать. */
  .price-checklist:has(.pc-search:placeholder-shown) .pc-groups:has(.pc-group-brand[open]) .pc-group-brand:not([open]) {
    display: none;
  }

  .price-checklist:has(.pc-search:placeholder-shown) .pc-group-body:has(.pc-group-line[open]) .pc-group-line:not([open]) {
    display: none;
  }

  .pc-group[hidden] {
    display: none;
  }

  .pc-group-brand > summary {
    padding: 14px 16px;
  }

  .pc-group-line > summary {
    padding: 12px 14px;
  }

  .pc-group summary {
    cursor: pointer;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.98rem;
    color: var(--color-ink);
    list-style: none;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
  }

  .pc-group-brand > summary {
    color: #fff;
  }

  .pc-group-brand > summary .pc-group-count {
    color: var(--color-panel);
  }

  .pc-group-line > summary {
    font-size: 0.9rem;
  }

  .pc-group summary::-webkit-details-marker { display: none; }

  .pc-group-count {
    font-family: var(--font-sans);
    font-weight: 400;
    color: #8a7f7a;
    font-size: 0.8rem;
  }

  /* Подкатегории «Акции» по ступени скидки — раньше были сплошной цветной заливкой
     («сухие плашки», по отзыву пользователя 2026-09-04) — теперь белая карточка
     с акцентной полосой слева и цветным текстом, 15%/7% всё ещё различимы с
     первого взгляда, но не выглядят голым цветным блоком. */
  .pc-tier-15,
  .pc-tier-7 {
    background: var(--color-paper);
    border: none;
    border-left: 4px solid var(--color-panel-line);
    box-shadow: var(--shadow-card);
  }

  .pc-tier-15 {
    border-left-color: var(--color-red);
  }

  .pc-tier-15 > summary {
    color: var(--color-red);
  }

  .pc-tier-15 > summary .pc-group-count {
    color: var(--color-red);
    opacity: 0.75;
  }

  .pc-tier-7 {
    border-left-color: var(--color-red);
  }

  .pc-tier-7 > summary {
    color: var(--color-red);
  }

  .pc-tier-7 > summary .pc-group-count {
    color: var(--color-red);
    opacity: 0.75;
  }

  .pc-group-body {
    padding-bottom: 4px;
  }

  /* Имя бренда уже показано в заголовке диалога (см. JS toggle-обработчик ниже) — дублирующая
     плашка-заголовок открытой карточки в самом списке лишняя, прячем её визуально. Сам <summary>
     остаётся в DOM (нужен для нативного открытия/закрытия <details>), сворачивание уже есть
     через кнопку «Назад» и повторный тап по «Каталогу»/«Акциям». */
  .pc-group-brand[open] > summary {
    display: none;
  }

  .pc-group-brand > .pc-group-body {
    display: block;
    padding: 14px 4px 8px;
  }

  .pc-group-brand > .pc-group-body > ul {
    padding: 4px 10px;
    margin: 4px 0;
  }

  /* Линейки внутри бренда — те же тонкие строки-списки, что и сами бренды в общем
     каталоге (см. .pc-group-brand:not([open]) выше), а не закрашенные синие плитки. */
  .pc-group-line:not([open]) {
    background: var(--color-paper);
    border: none;
    border-bottom: 1px solid var(--color-panel-line);
    border-radius: 0;
  }

  .pc-group-line:not([open]) > summary {
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
    padding: 12px 4px;
  }

  /* Длинное название линейки переносится на 2+ строки — счётчик не должен переноситься следом
     (иначе "97" и "товаров" расходятся по разным строкам, а стрелка ещё на третью). */
  .pc-group-line:not([open]) > summary .pc-group-count,
  .price-checklist[data-group-by='brand'] .pc-group-brand:not([open]) > summary .pc-group-count {
    flex: none;
    white-space: nowrap;
    text-align: right;
  }

  .pc-group-line > summary {
    color: var(--color-ink);
  }

  .pc-group-line > summary .pc-group-count {
    color: #8a7f7a;
  }

  .pc-group-line:not([open]) > summary .pc-group-count::after {
    content: ' \203A';
    color: var(--color-blue-dark);
    font-weight: 700;
  }

  .pc-group-line ul {
    list-style: none;
    background: var(--color-paper);
    border-radius: 6px;
    margin: 0 0 10px;
    padding: 4px 8px;
  }

  /* Список брендов каталога («Полный прайс») — компактные строки-списки, не крупные закрашенные
     плитки: у Dikson 2 товара, у Londa 170 — плиткой одинакового размера оба выглядели одинаково
     «тяжело», строкой разница видна сразу по подписи. «Акции» (data-group-by="discount") эта
     правка не касается — там ступени скидки остаются акцентными цветными карточками, как были. */
  .price-checklist[data-group-by='brand'] .pc-groups {
    display: block;
  }

  .price-checklist[data-group-by='brand'] .pc-group-brand:not([open]) {
    background: var(--color-paper);
    border: none;
    border-bottom: 1px solid var(--color-panel-line);
    border-radius: 0;
    margin-bottom: 0;
  }

  .price-checklist[data-group-by='brand'] .pc-group-brand:first-child:not([open]) {
    border-top: 1px solid var(--color-panel-line);
  }

  .price-checklist[data-group-by='brand'] .pc-group-brand:not([open]) > summary {
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
    padding: 12px 4px;
    font-size: 0.92rem;
    color: var(--color-ink);
  }

  .price-checklist[data-group-by='brand'] .pc-group-brand:not([open]) > summary .pc-group-count {
    color: #8a7f7a;
  }

  .price-checklist[data-group-by='brand'] .pc-group-brand:not([open]) > summary .pc-group-count::after {
    content: ' \203A';
    color: var(--color-blue-dark);
    font-weight: 700;
  }

  /* «Популярные» — топ-4 бренда по объёму, отдельным блоком карточек над алфавитным списком. */
  .pc-popular-title,
  .pc-all-title {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--color-ink);
    margin: 2px 4px 8px;
  }

  .pc-popular-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-bottom: 20px;
  }

  .pc-popular-card {
    font: inherit;
    text-align: left;
    background: var(--color-paper);
    border: 1px solid var(--color-panel-line);
    border-radius: 10px;
    padding: 20px 16px;
    min-height: 84px;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    box-shadow: var(--shadow-card);
    transition: box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .pc-popular-card:hover {
    border-color: var(--color-blue-dark);
    box-shadow: var(--shadow-card-hover);
  }

  .pc-popular-name {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-ink);
  }

  .pc-popular-count {
    font-size: 0.82rem;
    color: #8a7f7a;
  }

  /* Баннер-приглашение в «Акции» прямо внутри каталога — по просьбе пользователя (2026-09-03),
     не отдельная невидимая кнопка, а часть обычного просмотра каталога. Красный (не синий, как
     на референсе) — на сайте красный уже устойчиво значит «акция/скидка» (бейдж «Акция»,
     ступень 15% и т.п.), синий тут был бы не к месту. */
  .pc-promo-banner {
    display: flex;
    flex-direction: column;
    gap: 3px;
    background: linear-gradient(135deg, var(--color-red-dark), var(--color-red));
    color: #fff;
    border-radius: 10px;
    padding: 14px 40px 14px 16px;
    margin-bottom: 18px;
    position: relative;
    box-shadow: var(--shadow-card);
    text-decoration: none;
  }

  .pc-promo-banner-title {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.95rem;
  }

  .pc-promo-banner-sub {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .pc-promo-banner-arrow {
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.2rem;
    font-weight: 700;
  }

  /* «Лучшая скидка» в «Акциях» — честная витрина (реально самая большая разница в рублях
     среди акционных товаров), без придуманного таймера/дедлайна. */
  .pc-best-deal {
    grid-column: 1 / -1;
    margin-bottom: 18px;
  }

  .pc-best-deal-label {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--color-red);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 2px 4px 8px;
  }

  /* Строка в том же стиле, что и список брендов (тонкая линия-разделитель, без рамки/фона-
     карточки) — не отдельный визуально «тяжёлый» блок. */
  .pc-best-deal-list {
    list-style: none;
    margin: 0;
    padding: 0 4px;
    border-top: 1px solid var(--color-panel-line);
    border-bottom: 1px solid var(--color-panel-line);
  }

  .pc-best-deal-list .pc-item-name {
    font-weight: 700;
  }

  .pc-best-deal-brand {
    display: block;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink);
    margin-bottom: 1px;
  }

  /* Без явного чекбокса везде по каталогу (по просьбе пользователя, 2026-09-04) — активность
     решает количество: 0 = товара нет в заявке, степпер «+» переводит на 1 и сразу добавляет.
     Чекбокс остаётся в DOM (источник состояния для syncItemToCart/поиска), просто скрыт. */
  .pc-check {
    display: none;
  }

  .price-checklist:has(.pc-search:not(:placeholder-shown)) .pc-best-deal {
    display: none;
  }

  /* Пока идёт поиск или уже открыт конкретный бренд — блок «Популярные»/«Все бренды» лишний. */
  .price-checklist:has(.pc-search:not(:placeholder-shown)) .pc-popular {
    display: none;
  }

  .pc-groups:has(.pc-group-brand[open]) .pc-popular {
    display: none;
  }

  /* Открыта конкретная ступень скидки — «Лучшая скидка» вверху списка Акций лишняя, это
     свой отдельный «экран», а не аккордеон рядом с общей витриной. */
  .pc-groups:has(.pc-group-brand[open]) .pc-best-deal {
    display: none;
  }

  .pc-item[hidden] {
    display: none;
  }

  .pc-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 0;
    border-top: 1px solid var(--color-panel-line);
  }

  .pc-item:first-child {
    border-top: none;
  }

  .pc-item label {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    flex: 1;
    min-width: 0;
    cursor: pointer;
  }

  .pc-qty {
    flex: none;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .pc-qty-btn {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1px solid var(--color-panel-line);
    background: #fff;
    color: var(--color-ink);
    font-size: 0.85rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pc-qty-btn:hover {
    background: var(--color-panel);
  }

  .pc-qty-input {
    width: 32px;
    text-align: center;
    font: inherit;
    font-size: 0.85rem;
    border: 1px solid var(--color-panel-line);
    border-radius: 6px;
    padding: 3px 0;
    color: var(--color-ink);
    background: #fff;
    -moz-appearance: textfield;
  }

  .pc-qty-input::-webkit-outer-spin-button,
  .pc-qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .pc-item:not(:has(.pc-check:checked)) .pc-qty {
    opacity: 0.4;
  }

  .pc-item-name {
    flex: 1;
    font-size: 0.9rem;
    color: var(--color-ink);
  }

  .pc-promo .pc-item-name {
    color: var(--color-red);
  }

  .pc-item-price {
    font-size: 0.88rem;
    color: #5c5049;
    white-space: nowrap;
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
  }

  .pc-promo .pc-item-price {
    color: var(--color-red-dark);
  }

  .pc-price-now {
    font-weight: 600;
  }

  .pc-old-price {
    display: block;
    font-size: 0.78rem;
    font-weight: 400;
    color: #8a7f7a;
    text-decoration: line-through;
  }

  .pc-badges {
    display: flex;
    gap: 4px;
  }

  .pc-badge {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    background: var(--color-red);
    color: #fff;
    padding: 2px 6px;
    border-radius: 999px;
  }

  .pc-badge-new {
    background: var(--color-blue-dark);
  }

  .pc-no-results {
    padding: 24px 18px;
    text-align: center;
    color: #8a7f7a;
    font-size: 0.9rem;
  }


  @media (max-width: 640px) {
    .price-checklist {
      /* Открывается через .show() (не .showModal()), см. скрипт ниже — иначе нативный modal-режим
         делает всё остальное содержимое страницы inert (невзаимодействуемым), включая MobileNavBar,
         даже там, где сам диалог физически её не перекрывает. Без modal-режима ::backdrop браузер
         не рисует — сам диалог достаточно непрозрачен, чтобы не растеряться без затемнения фона. */
      top: 0;
      left: 0;
      right: 0;
      bottom: auto;
      margin: 0;
      width: 100vw;
      max-width: 100vw;
      /* На всю высоту экрана (не оставляем зазор снизу) — раньше зазор был нужен под плавающую
         MobileNavBar, но сквозь него было видно реальную страницу позади (реальный случай,
         2026-09-04: сквозь зазор просвечивала красная кнопка «Акции — выбрать и заказать» с
         главной страницы, выглядело как рудимент). Плашка навигации теперь просто лежит ПОВЕРХ
         диалога (z-index у неё выше, см. MobileNavBar.astro) — сам диалог полностью непрозрачен,
         сквозь него ничего не видно. Место для плашки внизу списка — через padding-bottom на
         .pc-groups (см. ниже), а не через дырку в самом диалоге.
         100vh первой строкой — запасной вариант для браузеров без поддержки dvh (100dvh считается
         по фактически видимой области, сам подстраивается под появление/скрытие адресной строки —
         см. реальный баг с "застрявшим" списком, 2026-08-27, актуален и здесь). */
      height: 100vh;
      height: 100dvh;
      max-height: 100vh;
      max-height: 100dvh;
      border-radius: 0;
    }

    .pc-groups {
      padding-bottom: 90px;
    }
  }
</style>

<script>
  // Открытие модалок по клику на любую кнопку с data-open-modal="<id диалога>" (см. PriceBlock.astro).
  // Простой overflow:hidden не спасает: showModal() сам фокусирует кнопку закрытия и браузер асинхронно
  // (уже после нашего кода) скроллит страницу, чтобы она попала в область видимости — window.scrollTo()
  // сразу после showModal() не успевает это перебить. Поэтому используем стандартный приём scroll-lock:
  // body переводится в position:fixed на время открытой модалки — тогда фон физически не может сдвинуться
  // ни от фокуса, ни от колеса/тача внутри диалога, а при закрытии позиция скролла восстанавливается.
  // Переход по баннеру «Больше выгодных предложений» из Каталога в Акции закрывает Каталог
  // (см. openDialog ниже — при открытии одного диалога любой другой открытый закрывается) —
  // без этого флага «Назад» из Акций на верхнем уровне просто закрывал бы всё, высаживая
  // человека на голой странице (реальная жалоба пользователя, 2026-09-04: "ведёт на херо, а
  // не обратно в каталог"). Флаг ставится кликом по баннеру и потребляется/сбрасывается ровно
  // один раз — в обработчике «←» диалога Акций, либо при любом ином закрытии Акций (см. ниже).
  let cameFromCatalogToPromo = false;
  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-open-promo-from-catalog]')) {
      cameFromCatalogToPromo = true;
    }
  });

  let lockedScrollY = 0;
  // Токен для отмены "reassert"-цикла ниже — когда после закрытия диалога нужно уйти к другому
  // месту страницы (напр. к #info по клику на плашке), а не вернуться туда, где было до открытия.
  let reassertToken = 0;
  // Когда true — unlockPageScroll полностью пропускает свою работу при следующем срабатывании
  // (см. closeDialogAndScrollTo: мы уже разлочили страницу сами и уводим её в другое место).
  let skipNextUnlock = false;
  function lockPageScroll() {
    lockedScrollY = window.scrollY;
    document.body.style.position = 'fixed';
    document.body.style.top = `-${lockedScrollY}px`;
    document.body.style.left = '0';
    document.body.style.right = '0';
  }
  function resetBodyLockStyles() {
    document.body.style.position = '';
    document.body.style.top = '';
    document.body.style.left = '';
    document.body.style.right = '';
  }
  function unlockPageScroll() {
    if (skipNextUnlock) {
      skipNextUnlock = false;
      return;
    }
    resetBodyLockStyles();
    window.scrollTo(0, lockedScrollY);
    // close() у <dialog> возвращает фокус на элемент-триггер с задержкой в несколько кадров (замерено
    // ~28мс в Chromium) — этот возврат фокуса сам скроллит страницу уже ПОСЛЕ того как мы её восстановили.
    // Подтверждаем правильную позицию ещё десяток кадров вперёд, чтобы перебить этот запоздалый скачок.
    const myToken = ++reassertToken;
    let ticks = 0;
    function reassert() {
      if (myToken !== reassertToken) return; // отменено — страница уже уводится в другое место
      if (window.scrollY !== lockedScrollY) window.scrollTo(0, lockedScrollY);
      ticks++;
      if (ticks < 15) requestAnimationFrame(reassert);
    }
    requestAnimationFrame(reassert);
  }

  // dialog.close() сам возвращает фокус на элемент-триггер и скроллит к нему страницу и (для диалога,
  // открытого через .show(), см. openDialog) снимает блокировку скролла НЕ синхронно, а с небольшой
  // задержкой — если убрать фокус из диалога непосредственно перед close() (когда активный элемент
  // больше не потомок диалога), браузер видит, что восстанавливать нечего, и лишнего скролла не будет.
  function closeDialog(root: HTMLDialogElement) {
    (document.activeElement as HTMLElement | null)?.blur();
    root.close();
  }

  // Закрывает диалог и сразу уводит взгляд в другое место страницы (якорь с плашки, форма заявки
  // после "Добавить в заявку") — а не туда, где был скролл до открытия диалога. Раз close() снимает
  // блокировку скролла асинхронно (см. выше), обычный scrollIntoView сразу после close() бьётся об
  // ещё зафиксированный body. Поэтому разлочиваем сами тут же, глушим отложенный автоматический
  // unlockPageScroll флагом (иначе он позже откатит скролл туда, где было до открытия) и держим
  // целевую позицию несколько кадров — на случай запоздалого скролла от возврата фокуса (см. выше).
  function closeDialogAndScrollTo(dialog: HTMLDialogElement, target: Element | null) {
    skipNextUnlock = true;
    closeDialog(dialog);
    resetBodyLockStyles();
    if (!target) return;
    const myToken = ++reassertToken;
    let ticks = 0;
    const holdScroll = () => {
      if (myToken !== reassertToken) return;
      target.scrollIntoView({ behavior: 'auto', block: 'start' });
      ticks++;
      if (ticks < 12) requestAnimationFrame(holdScroll);
    };
    holdScroll();
  }

  // Страховка от «мёртвого» сайта после сворачивания с открытым диалогом (реальный кейс,
  // пользователь 2026-08-27: свернул телефон на Каталоге, вернулся — страница не реагирует,
  // помогало только убить вкладку/приложение из памяти). Похоже на то, что мобильный
  // браузер иногда закрывает/теряет синхронизацию с открытым <dialog> при заморозке вкладки
  // в фоне, не давая отработать нашему 'close'-слушателю (см. unlockPageScroll выше) — тогда
  // body остаётся в position:fixed навсегда, и страница выглядит открытой, но не скроллится
  // и не реагирует на тапы. При возврате видимости страницы проверяем: лок стоит, а реально
  // открытого диалога нет — значит лок «осиротел», снимаем его сами.
  function healStuckScrollLock() {
    const anyOpenDialog = document.querySelector('dialog[open]');
    if (!anyOpenDialog && document.body.style.position === 'fixed') {
      resetBodyLockStyles();
      window.scrollTo(0, lockedScrollY || window.scrollY);
    }
  }
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') healStuckScrollLock();
  });
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) healStuckScrollLock();
  });

  function isMobileNav() {
    return window.matchMedia('(max-width: 640px)').matches;
  }

  interface CommittedItem {
    name: string;
    price: number;
    qty: number;
    brand: string;
    promo: boolean;
  }

  // Отметка чекбокса СРАЗУ добавляет/убирает товар из корзины (window.zilmaCart, см. CartStore.astro) —
  // по прямой просьбе пользователя (2026-09-03): отдельная кнопка «Добавить в заявку» лишний шаг,
  // как в обычном интернет-магазине отметка = товар уже в корзине. Мёрджим/убираем по названию,
  // не плодим дублирующие строки (тот же принцип, что раньше был в commitSelection — реальный
  // случай 2026-08-31, "Socolor 505M" дважды разными строками при повторном открытии).
  function syncItemToCart(check: HTMLInputElement, qtyInput: HTMLInputElement | null) {
    const cart: CommittedItem[] = (window as any).zilmaCart?.get() ?? [];
    const name = check.dataset.name ?? '';
    const idx = cart.findIndex((it) => it.name === name);
    if (check.checked) {
      const qty = Math.max(1, parseInt(qtyInput?.value ?? '1', 10) || 1);
      if (idx >= 0) {
        cart[idx].qty = qty;
      } else {
        cart.push({
          name,
          price: parseFloat(check.dataset.price ?? '0') || 0,
          qty,
          brand: check.dataset.brandLabel ?? '',
          promo: check.dataset.promo === '1',
        });
      }
    } else if (idx >= 0) {
      cart.splice(idx, 1);
    }
    (window as any).zilmaCart?.set(cart);
  }

  // На мобильном открываем через .show() (не .showModal()): нативный modal-режим делает ВЕСЬ остальной
  // документ inert (невзаимодействуемым) — это выключило бы MobileNavBar.astro даже в зазоре снизу, где
  // диалог её физически не перекрывает (см. mobile-медиа-запрос выше). На десктопе плашки нет — там
  // поведение остаётся прежним, showModal() с фокус-ловушкой и затемнением фона.
  // Повторный клик по той же кнопке ("Каталог"), пока список уже открыт и клиент залистался внутрь
  // раскрытой папки (бренд/линейка с длинным списком товаров) — сворачивает обратно к списку папок,
  // чтобы не листать наверх вручную. Отмеченные чекбоксы не трогает — только .open у <details> и скролл.
  function collapseToFolderList(dialog: HTMLDialogElement) {
    delete dialog.dataset.categoryMode;
    dialog.querySelectorAll<HTMLDetailsElement>('.pc-group').forEach((d) => {
      d.open = false;
    });
    // Фильтр по категории (см. [data-filter-category]) прячет несовпавшие товары через
    // li.hidden напрямую, в обход обычного поиска — сбрасываем здесь же, иначе после выхода
    // из категории и захода в обычный бренд там могли остаться "залипшие" скрытые строки.
    dialog.querySelectorAll<HTMLLIElement>('.pc-item[hidden]').forEach((li) => {
      li.hidden = false;
    });
    const search = dialog.querySelector<HTMLInputElement>('.pc-search');
    if (search && search.value) {
      search.value = '';
      search.dispatchEvent(new Event('input', { bubbles: true }));
    }
    // Реальный баг на Android (найден пользователем 2026-08-27): резкое схлопывание сразу многих
    // <details> меняет высоту списка одним синхронным рывком, и если тут же скроллить новым
    // scrollTo() — мобильный Chrome иногда не успевает пересчитать границы скролла и дальше не
    // даёт пролистать список до конца (застревает на середине). Помогает: ждать кадр отрисовки
    // (браузер успевает переразметить укороченный список) и сбрасывать позицию простым свойством
    // scrollTop, а не новым scrollTo() API — так надёжнее на этом классе устройств.
    const scrollEl = dialog.querySelector<HTMLElement>('.pc-groups');
    if (scrollEl) {
      requestAnimationFrame(() => {
        scrollEl.scrollTop = 0;
      });
    }
  }

  function openDialog(dialog: HTMLDialogElement) {
    // Если переключаемся между Каталогом и Акциями (клик по плашке, когда одно окно уже открыто) —
    // просто закрываем его: отмеченное уже в корзине (см. syncItemToCart — коммитить отдельно
    // больше не нужно, каждая отметка уже сразу применена).
    document.querySelectorAll<HTMLDialogElement>('[data-checklist]').forEach((d) => {
      if (d !== dialog && d.open) {
        closeDialog(d);
      }
    });
    if (dialog.open) {
      collapseToFolderList(dialog);
      return;
    }
    lockPageScroll();
    if (isMobileNav()) {
      dialog.show();
    } else {
      dialog.showModal();
    }
    document.dispatchEvent(new CustomEvent('zilma:nav-show'));
  }

  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest('[data-open-modal]') as HTMLElement | null;
    if (!trigger) return;
    const id = trigger.getAttribute('data-open-modal');
    const dialog = id && document.getElementById(id);
    if (dialog instanceof HTMLDialogElement) openDialog(dialog);
  });

  // Автооткрытие по хэшу-команде из плашки быстрой навигации (MobileNavBar.astro), которая всегда
  // ссылается на главную (единственная страница, где гарантированно есть обе модалки).
  // hashchange — на случай клика, когда мы уже на главной (полной перезагрузки страницы не будет),
  // и когда переключаемся между уже открытыми Каталогом/Акциями прямо с плашки.
  const HASH_TO_DIALOG: Record<string, string> = {
    '#open-catalog': 'checklist-current-dialog',
    '#open-promo': 'checklist-promo-dialog',
  };
  function openFromHash() {
    const hash = location.hash;
    const targetId = HASH_TO_DIALOG[hash];
    if (targetId) {
      const dialog = document.getElementById(targetId);
      if (dialog instanceof HTMLDialogElement) openDialog(dialog);
      history.replaceState(null, '', location.pathname + location.search);
      return;
    }

    // Хэш не команда открытия окна (например, "#info" по клику на плашку). Если сейчас открыт
    // Каталог/Акции — страница физически не может проскроллиться к цели, пока не разлочена
    // (см. closeDialogAndScrollTo); иначе кнопка выглядит "неживой": и сама не закрывается, и
    // никуда не ведёт.
    const openDlg = document.querySelector<HTMLDialogElement>('[data-checklist][open]');
    const target = hash.length > 1 ? document.getElementById(hash.slice(1)) : null;
    if (openDlg) {
      closeDialogAndScrollTo(openDlg, target);
    } else {
      target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    history.replaceState(null, '', location.pathname + location.search);
  }
  openFromHash();
  window.addEventListener('hashchange', openFromHash);

  document.querySelectorAll<HTMLDialogElement>('[data-checklist]').forEach((dialog) => {
    dialog.addEventListener('close', unlockPageScroll);
    dialog.addEventListener('close', () => document.dispatchEvent(new CustomEvent('zilma:nav-show')));
    // Флаг «пришли из Каталога» нужен ровно на один следующий клик «←» в Акциях (см. выше) —
    // если Акции закрылись любым ДРУГИМ способом (клик по подложке, повторный тап по «Акции»
    // на плашке), флаг сбрасываем, чтобы он не «выстрелил» ошибочно в другой раз.
    if (dialog.id === 'checklist-promo-dialog') {
      dialog.addEventListener('close', () => {
        cameFromCatalogToPromo = false;
      });
    }

    // Автоскрытие MobileNavBar при скролле списка внутри диалога: листаем дальше вниз по списку —
    // плашка уезжает, чтобы не мешать; возвращаемся к началу — плашка появляется снова.
    const scrollArea = dialog.querySelector<HTMLElement>('.pc-groups');
    let lastTop = 0;
    scrollArea?.addEventListener(
      'scroll',
      () => {
        const top = scrollArea.scrollTop;
        const delta = top - lastTop;
        if (Math.abs(delta) > 6) {
          document.dispatchEvent(new CustomEvent(delta > 0 ? 'zilma:nav-hide' : 'zilma:nav-show'));
          lastTop = top;
        }
      },
      { passive: true }
    );
  });

  // Точку/запятую в номере оттенка приравниваем к слэшу — "wella 1.9" должно находить
  // товар с "1/9" в названии, люди печатают код оттенка кто как привык.
  function normalizeSearch(s: string): string {
    return s.toLowerCase().replace(/[.,]/g, '/');
  }

  // Часть товаров в прайсе названа латиницей (бренды/линии/английские слова) — мастер,
  // печатающий кириллицей ("иллюмина", "шварцкопф"), иначе ничего не найдёт. Побуквенная
  // транслитерация не подходит — реальное произношение часто расходится с ней (Shinefinity
  // читается "шайнфинити", а не "шинефинити"), поэтому вместо алгоритма — словарь реальных
  // известных пар для всех значимых латинских слов из priceItems.json (бренды, линии,
  // частые английские слова в названиях — не служебные аббревиатуры вроде CT/KP/LC, их
  // никто не произносит по-русски). Значения — уже нормализованные (нижний регистр).
  const CYRILLIC_ALIASES: Record<string, string> = {
    матрикс: 'matrix', велла: 'wella', оллин: 'ollin', лонда: 'londa',
    шварцкопф: 'schwarzkopf', лебель: 'lebel', лебел: 'lebel', капус: 'kapous',
    концепт: 'concept', диксон: 'dikson', эстель: 'estel', карепрост: 'careprost',
    левиссим: 'levissime', лореаль: "l'oreal", лореал: "l'oreal", искартес: 'iskartes',
    игора: 'igora', блондми: 'blondme', иллюмина: 'illumina', шайнфинити: 'shinefinity',
    эйми: 'eimi', инвиго: 'invigo', соколор: 'socolor', синк: 'sync', ладор: 'la`dor',
    озис: 'osis', осис: 'osis', силуэт: 'silhouette',
    тач: 'touch', колор: 'color', кэр: 'care', кеа: 'care', софт: 'soft', блонд: 'blond',
    нью: 'new', тотал: 'total', силк: 'silk', ойл: 'oil', вельвет: 'velvet',
    перфект: 'perfect', бриллианс: 'brilliance', профи: 'profy',
  };

  // Разные бренды называют один и тот же тип товара разными словами — осветляющий
  // порошок у Wella зовётся "Блондор", у Londa "Блондоран", у Ollin/Matrix "Супра",
  // а мастер может искать и общим словом "порошок"/"пудра"/"осветляющий". Это не
  // фонетическая пара (как в CYRILLIC_ALIASES выше), а группа взаимозаменяемых слов —
  // если запрос совпал с одним словом из группы, ищем товар по ЛЮБОМУ слову из той же
  // группы. "освет" без окончания — так ловится и "осветляющий", и опечатка в прайсе
  // "осветяющий" (без "л"), и "освет." (сокращение).
  const SYNONYM_GROUPS: string[][] = [
    ['супра', 'блондор', 'блондоран', 'порошок', 'пудра', 'освет'],
  ];

  function matchToken(token: string, entry: { name: string; brand: string; line: string }): boolean {
    if (entry.name.includes(token) || entry.brand.includes(token) || entry.line.includes(token)) return true;
    const alias = CYRILLIC_ALIASES[token];
    if (alias && (entry.name.includes(alias) || entry.brand.includes(alias) || entry.line.includes(alias))) return true;
    const group = SYNONYM_GROUPS.find((g) => g.some((w) => token.includes(w) || w.includes(token)));
    return !!group && group.some((w) => entry.name.includes(w) || entry.brand.includes(w) || entry.line.includes(w));
  }

  document.querySelectorAll<HTMLDialogElement>('[data-checklist]').forEach((root) => {
    const search = root.querySelector<HTMLInputElement>('.pc-search');
    const items = [...root.querySelectorAll<HTMLLIElement>('.pc-item')];
    const groups = [...root.querySelectorAll<HTMLDetailsElement>('.pc-group')];
    const checks = [...root.querySelectorAll<HTMLInputElement>('.pc-check')];
    // Индекс на каждый товар — считаем один раз, не при каждом нажатии клавиши.
    const searchIndex = new Map<HTMLLIElement, { name: string; brand: string; line: string }>(
      items.map((li) => [
        li,
        {
          name: normalizeSearch(li.dataset.name ?? ''),
          brand: normalizeSearch(li.dataset.brand ?? ''),
          line: normalizeSearch(li.dataset.line ?? ''),
        },
      ])
    );
    const noResults = root.querySelector<HTMLElement>('.pc-no-results');

    // Отдельной кнопки «✕ Закрыть» больше нет (пользователь справедливо заметил: рядом с «←»
    // и всегда доступной нижней плашкой навигации она лишняя). Стрелка «←» теперь «умная»:
    // внутри открытого бренда — сворачивает к списку папок (как раньше), а на самом верхнем
    // уровне (папки уже свёрнуты) — закрывает диалог целиком, как обычная кнопка «Назад».
    // Гамбургер — выпадающее меню с категориями (не отдельный экран, просто список поверх).
    const menuBtn = root.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const menuDropdown = root.querySelector<HTMLElement>('[data-menu-dropdown]');
    function closeMenuDropdown() {
      if (menuDropdown) menuDropdown.hidden = true;
      menuBtn?.setAttribute('aria-expanded', 'false');
    }
    menuBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const willOpen = !!menuDropdown?.hidden;
      if (menuDropdown) menuDropdown.hidden = !willOpen;
      menuBtn.setAttribute('aria-expanded', String(willOpen));
    });
    document.addEventListener('click', (e) => {
      if (!menuDropdown || menuDropdown.hidden) return;
      if (!menuDropdown.contains(e.target as Node) && e.target !== menuBtn) closeMenuDropdown();
    });

    // «←» — назад РОВНО на один экран, не сразу в самый верх (реальная жалоба пользователя:
    // из открытой линии внутри бренда один клик улетал сразу к списку папок, минуя список
    // линий этого бренда). Порядок шагов от самого глубокого к самому верхнему:
    // 1) активен фильтр категории (гамбургер) → снять целиком ПЕРВЫМ делом — это не цепочка
    //    вложенных экранов, а один оверлей, который сам открывает МНОГО линий/брендов сразу
    //    (по всем совпадениям); если проверять открытую линию раньше категории, «Назад»
    //    закрывал бы линии по одной вместо честного выхода из фильтра за один клик (реальный
    //    баг, найден пользователем 2026-09-04 — то же применимо и к «Акциям», где тиры/бренды
    //    устроены той же парой классов pc-group-brand/pc-group-line);
    // 2) открыта линия внутри бренда (обычное, не категориальное листание) → закрыть только её;
    // 3) идёт поиск → просто очистить поле;
    // 4) открыт бренд (или ступень скидки в «Акциях») → закрыть его;
    // 5) ничего не открыто и не активно → закрыть диалог целиком.
    root.querySelector('[data-back-to-folders]')?.addEventListener('click', () => {
      if (root.dataset.categoryMode === '1') {
        collapseToFolderList(root);
        return;
      }
      const openLine = root.querySelector<HTMLDetailsElement>('.pc-group-line[open]');
      if (openLine) {
        openLine.open = false;
        return;
      }
      if (search && search.value) {
        search.value = '';
        search.dispatchEvent(new Event('input', { bubbles: true }));
        return;
      }
      const openBrand = root.querySelector<HTMLDetailsElement>('.pc-group-brand[open]');
      if (openBrand) {
        openBrand.open = false;
        return;
      }
      // На самом верхнем уровне Акций, если сюда попали именно из Каталога (баннер) — «Назад»
      // должен вернуть в Каталог, а не просто закрыть всё на голую страницу.
      if (root.id === 'checklist-promo-dialog' && cameFromCatalogToPromo) {
        cameFromCatalogToPromo = false;
        closeDialog(root);
        const catalogDialog = document.getElementById('checklist-current-dialog');
        if (catalogDialog instanceof HTMLDialogElement) openDialog(catalogDialog);
        return;
      }
      closeDialog(root);
    });

    // Открытая карточка верхнего уровня (бренд в Каталоге, ступень скидки в Акциях) ведёт
    // себя как отдельный «экран»: заголовок и подсказка поиска меняются на её имя, пока она
    // открыта — визуально не просто раскрытый аккордеон в общем списке, а переход внутрь.
    // Работает для ОБОИХ groupBy — и .pc-group-brand[data-brand], и ступени скидки в Акциях
    // используют тот же атрибут data-brand (там это имя ступени "Скидка 15%"/"Скидка 7%").
    const headerTitle = root.querySelector<HTMLElement>('.pc-header h3');
    const originalHeading = headerTitle?.textContent ?? '';
    const defaultSearchPlaceholder = search?.placeholder ?? '';
    {
      root.querySelectorAll<HTMLDetailsElement>('.pc-group-brand').forEach((brandEl) => {
        brandEl.addEventListener('toggle', () => {
          // Фильтр по категории открывает СРАЗУ много брендов — без этой проверки каждый
          // такой toggle (событие асинхронное, см. requestAnimationFrame в обработчике
          // категории) по очереди перезаписывал бы шапку СВОИМ именем бренда вместо
          // названия категории, последний открытый просто побеждал бы гонку.
          if (root.dataset.categoryMode === '1') return;
          const brandName = brandEl.dataset.brand;
          // Ступень скидки (Акции) — тот же шрифт/размер, что у обычного имени бренда, но
          // красным и прописными (по прямой просьбе пользователя) — свой отдельный класс,
          // не .pc-header-logo (у него другой шрифт/размер, это именно логотип).
          const isTier = root.dataset.groupBy === 'discount';
          if (brandEl.open && brandName) {
            if (headerTitle) {
              headerTitle.textContent = brandName;
              headerTitle.classList.remove('pc-header-logo');
              headerTitle.classList.toggle('pc-header-tier', isTier);
            }
            if (search) search.placeholder = `Поиск по ${brandName}…`;
          } else if (!brandEl.open) {
            if (headerTitle) {
              headerTitle.textContent = originalHeading;
              headerTitle.classList.add('pc-header-logo');
              headerTitle.classList.remove('pc-header-tier');
            }
            if (search) search.placeholder = defaultSearchPlaceholder;
          }
        });
      });
    }

    // Корзинка-счётчик в шапке — тот же приём, что у пункта «Заявка» нижней плашки
    // (MobileNavBar.astro): на главной ведёт мгновенным якорем, с других страниц — на
    // отдельную лёгкую страницу /order/ (без херо), бейдж читает общее хранилище корзины.
    const cartLink = root.querySelector<HTMLAnchorElement>('[data-cart-link]');
    if (cartLink && location.pathname === '/') cartLink.href = '/#order';
    const cartBadge = root.querySelector<HTMLElement>('[data-cart-badge]');
    function updateCartBadge() {
      if (!cartBadge) return;
      const cart = (window as any).zilmaCart?.get() ?? [];
      const count = Array.isArray(cart) ? cart.length : 0;
      cartBadge.textContent = String(count);
      cartBadge.hidden = count === 0;
    }
    document.addEventListener('zilma:cart-updated', updateCartBadge);
    updateCartBadge();

    // Карточка «Популярные» — ярлык на нужный бренд в общем алфавитном списке ниже,
    // не отдельный дублирующий рендер товаров.
    root.querySelectorAll<HTMLButtonElement>('[data-jump-to-brand]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const name = btn.dataset.jumpToBrand ?? '';
        groups.forEach((g) => {
          if (g.classList.contains('pc-group-brand')) g.open = false;
        });
        const target = root.querySelector<HTMLDetailsElement>(`.pc-group-brand[data-brand="${CSS.escape(name)}"]`);
        if (target) {
          target.open = true;
          target.scrollIntoView({ block: 'start', behavior: 'smooth' });
        }
      });
    });

    // Карточка «Категории» — фильтр по типу товара (эвристика по названию, см. frontmatter
    // компонента). В отличие от «Популярные» (ярлык на ОДИН бренд), категория обычно
    // встречается сразу во многих брендах — открываем ВСЕ бренды/линейки, где нашлось
    // совпадение, прячем остальные. Работает поверх той же CSS-логики "прячь неоткрытых
    // соседей" (:has(.pc-search:placeholder-shown) ...) — она уже реагирует на .open, ничего
    // отдельно для категорий дорабатывать не пришлось.
    root.querySelectorAll<HTMLButtonElement>('[data-filter-category]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.dataset.filterCategory ?? '';
        closeMenuDropdown();
        root.dataset.categoryMode = '1';
        let anyVisibleTotal = false;
        groups.forEach((g) => {
          const groupItems = [...g.querySelectorAll<HTMLLIElement>('.pc-item')];
          let anyVisible = false;
          groupItems.forEach((li) => {
            const match = li.dataset.category === cat;
            li.hidden = !match;
            if (match) anyVisible = true;
          });
          g.hidden = !anyVisible;
          g.open = anyVisible;
          if (anyVisible) anyVisibleTotal = true;
        });
        if (noResults) noResults.hidden = anyVisibleTotal;
        if (headerTitle) {
          headerTitle.textContent = cat;
          headerTitle.classList.remove('pc-header-logo');
        }
        root.querySelector('.pc-groups')?.scrollTo({ top: 0 });
      });
    });
    // Клик по подложке (::backdrop) — событие всплывает с target === сам dialog, а не его содержимое.
    root.addEventListener('click', (e) => {
      if (e.target === root) closeDialog(root);
    });

    // Отмеченное здесь может измениться СНАРУЖИ (товар убрали в корзине на странице заявки,
    // истёк TTL и т.п.) — держим чекбоксы синхронными с реальным содержимым корзины, а не
    // только со своими собственными кликами.
    function syncCheckedFromCart() {
      const cart: CommittedItem[] = (window as any).zilmaCart?.get() ?? [];
      const byName = new Map(cart.map((it) => [it.name, it]));
      checks.forEach((c) => {
        const entry = byName.get(c.dataset.name ?? '');
        const qtyInput = c.closest('.pc-item')?.querySelector<HTMLInputElement>('.pc-qty-input');
        c.checked = !!entry;
        if (qtyInput) qtyInput.value = entry ? String(entry.qty) : qtyInput.min || '1';
      });
    }
    syncCheckedFromCart();
    document.addEventListener('zilma:cart-updated', syncCheckedFromCart);

    // Степпер количества: +/- меняют значение и, если товар ещё не отмечен, отмечают его.
    // Любое изменение (отметка, снятие отметки, +/-, ручной ввод количества) сразу применяется
    // к корзине через syncItemToCart — отдельного шага «подтвердить» больше нет.
    root.querySelectorAll<HTMLElement>('.pc-item').forEach((li) => {
      const check = li.querySelector<HTMLInputElement>('.pc-check');
      const qtyInput = li.querySelector<HTMLInputElement>('.pc-qty-input');
      if (!check || !qtyInput) return;

      // Минимум количества берём из атрибута min самого поля (обычные товары — "1", у карточки
      // «Лучшая скидка» без видимого чекбокса — "0": количество 0 само по себе значит "не в
      // заявке", "+" от 0 до 1 добавляет, "−" обратно до 0 убирает — чекбокс скрыт, но остаётся
      // источником состояния для syncItemToCart/поиска, просто управляется только степпером).
      const floor = Number(qtyInput.min) || 0;

      function clamp() {
        const n = Math.max(floor, Math.min(999, parseInt(qtyInput!.value, 10) || floor));
        qtyInput!.value = String(n);
        return n;
      }

      li.querySelectorAll<HTMLButtonElement>('.pc-qty-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const dir = Number(btn.dataset.qtyDir) || 0;
          const n = Math.max(floor, Math.min(999, (parseInt(qtyInput.value, 10) || floor) + dir));
          qtyInput.value = String(n);
          if (n === 0) {
            if (check.checked) {
              check.checked = false;
              syncItemToCart(check, qtyInput);
            }
          } else if (!check.checked) {
            check.checked = true;
            check.dispatchEvent(new Event('change'));
          } else {
            syncItemToCart(check, qtyInput);
          }
        });
      });

      qtyInput.addEventListener('change', () => {
        const n = clamp();
        if (n === 0 && check.checked) {
          check.checked = false;
          syncItemToCart(check, qtyInput);
        } else if (check.checked) {
          syncItemToCart(check, qtyInput);
        }
      });
      qtyInput.addEventListener('input', () => {
        const n = parseInt(qtyInput.value, 10) || 0;
        if (n > 0 && !check.checked) {
          check.checked = true;
          check.dispatchEvent(new Event('change'));
        } else if (n === 0 && check.checked) {
          check.checked = false;
          syncItemToCart(check, qtyInput);
        } else if (check.checked) {
          syncItemToCart(check, qtyInput);
        }
      });

      check.addEventListener('change', () => {
        if (check.checked) {
          // Чекбокс скрыт, но по-прежнему переключается кликом по названию/цене (нативное
          // поведение <label>) — если это произошло при количестве 0, показываем честную
          // единицу (в корзину в любом случае уйдёт минимум 1, см. syncItemToCart).
          if ((parseInt(qtyInput.value, 10) || 0) < 1) qtyInput.value = '1';
        } else {
          qtyInput.value = qtyInput.min || '1';
        }
        syncItemToCart(check, qtyInput);
      });
    });

    search?.addEventListener('input', () => {
      // Каждое слово запроса ищем по отдельности (не всю строку целиком) — так "wella 1.9"
      // находит товар, у которого "wella" в бренде, а "1/9" (точка = слэш) — в названии,
      // даже если это не идёт подряд как в запросе.
      const tokens = normalizeSearch(search.value.trim()).split(/\s+/).filter(Boolean);
      // Если уже открыт конкретный бренд («экран бренда») — поиск ищет только внутри него,
      // не по всему прайсу: набирая "7/0" внутри LONDA, не хочется внезапно улететь в WELLA.
      // Сам заголовок открытого бренда не трогаем (не прячем, не сворачиваем) — это текущий
      // экран, а не результат поиска среди прочих.
      const openBrand = groups.find((g) => g.classList.contains('pc-group-brand') && g.open);
      let anyVisibleTotal = false;
      groups.forEach((g) => {
        // Другой (не текущий) бренд верхнего уровня, пока мы внутри «экрана» одного бренда —
        // всегда прячем, не полагаясь на CSS-трюк для пустого поиска (он работает только
        // пока :placeholder-shown, а тут уже что-то введено).
        if (openBrand && g.classList.contains('pc-group-brand') && g !== openBrand) {
          g.hidden = true;
          return;
        }
        const groupItems = [...g.querySelectorAll<HTMLLIElement>('.pc-item')];
        let anyVisible = false;
        groupItems.forEach((li) => {
          const entry = searchIndex.get(li);
          const match = tokens.length === 0 || !entry || tokens.every((t) => matchToken(t, entry));
          li.hidden = !match;
          if (match) anyVisible = true;
        });
        if (g === openBrand) {
          g.hidden = false; // текущий экран бренда всегда виден, поиск лишь фильтрует товары внутри
        } else {
          g.hidden = !anyVisible;
          g.open = tokens.length > 0 && anyVisible;
        }
        if (anyVisible) anyVisibleTotal = true;
      });
      if (noResults) noResults.hidden = anyVisibleTotal || items.length === 0;
    });
  });
</script>
