  }

  .price-checklist[data-group-by='brand'] .pc-group-brand:not([open]) > summary {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 12px 14px;
    font-size: 0.92rem;
    color: var(--color-ink);
  }

  .price-checklist[data-group-by='brand'] .pc-group-brand:not([open]) > summary .pc-group-count {
    color: #8a7f7a;
  }

  /* «Популярные» — топ-4 бренда по объёму, отдельным блоком карточек над алфавитным списком. */
  .pc-popular-title,
  .pc-all-title {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--color-ink);
    margin: 2px 4px 8px;
  }

  .pc-popular-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-bottom: 20px;
