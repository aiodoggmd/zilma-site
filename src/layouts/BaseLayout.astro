---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import CartStore from '../components/CartStore.astro';
import InstallPrompt from '../components/InstallPrompt.astro';
import MobileNavBar from '../components/MobileNavBar.astro';

interface Props {
  title: string;
  ogTitle?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishDate?: Date;
  verifiedDate?: Date;
}

const {
  title,
  ogTitle = title,
  description = 'Zilma — профессиональная косметика для салонов красоты: Wella, Londa, Schwarzkopf, Matrix, Lebel.',
  image = '/images/og-default.jpg?v=2',
  type = 'website',
  publishDate,
  verifiedDate,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@400;500;600;700&display=swap"
    />
    <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png?v=3" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png?v=3" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
    <link rel="manifest" href="/site.webmanifest?v=2" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Zilma" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#c8000f" />
    <meta name="geo.region" content="RU-MOW" />
    <meta name="geo.placename" content="Москва" />
    <meta name="yandex-verification" content="94926554404b9c62" />
    <title>{title}</title>

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Zilma" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {type === 'article' && publishDate && (
      <meta property="article:published_time" content={publishDate.toISOString()} />
    )}
    {type === 'article' && verifiedDate && (
      <meta property="article:modified_time" content={verifiedDate.toISOString()} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <slot name="head" />
  </head>
  <body>
    <CartStore />
    <Analytics />
    <SpeedInsights />
    <slot />
    <InstallPrompt />
    <MobileNavBar />
    <script>
      function initReveal() {
        const selector = '.price-card, .section-title, .card, .prose > *';
        document.querySelectorAll(selector).forEach((el) => el.classList.add('reveal'));

        const revealEls = document.querySelectorAll('.reveal');
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );
        revealEls.forEach((el) => io.observe(el));
      }
      initReveal();

      // На деве (в т.ч. по локальной сети/VPN на телефоне — так тестируем правки) SW регистрировать
      // не даём: раньше он кешировал сборку с devserver'а, и с телефона можно было получить старую
      // версию скрипта после правок на компьютере, хотя на компьютере всё уже работало верно.
      const isDevHost = ['localhost', '127.0.0.1'].includes(location.hostname) || /^(10|172\.(1[6-9]|2\d|3[01])|192\.168)\./.test(location.hostname);
      if ('serviceWorker' in navigator && !isDevHost) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      } else if ('serviceWorker' in navigator && isDevHost) {
        // На случай если SW уже успел зарегистрироваться в прошлых сессиях на этом устройстве —
        // снимаем регистрацию и чистим его кеш, чтобы дальше devserver всегда отдавал свежее.
        navigator.serviceWorker.getRegistrations().then((regs) => regs.forEach((r) => r.unregister()));
        if ('caches' in window) caches.keys().then((keys) => keys.forEach((k) => caches.delete(k)));
      }

      // Реальный баг с телефона (2026-08-27): если свернуть сайт (браузер или установленное
      // приложение) на несколько минут и вернуться — страница «мёртвая», ничего не реагирует ни
      // на статьях, ни в каталоге; помогало только жёстко закрыть вкладку/приложение из диспетчера
      // и открыть заново. Похоже на стандартную заморозку фоновой вкладки мобильным браузером
      // (Chrome по спецификации Page Lifecycle замораживает скрытые вкладки примерно через 5 минут,
      // экономя батарею/память) — иногда не отмерзает нормально сама. Раз пользователь и так лечит
      // это принудительным перезапуском — делаем то же самое сами, автоматически: если страница
      // была скрыта дольше порога, при возврате видимости просто перезагружаем её. Корзина (главная
      // ценность на этой странице) переживёт — она в localStorage (CartStore.astro), не в памяти
      // вкладки; потеряться может только незаполненный черновик текста в полях имени/телефона.
      const HIDDEN_RELOAD_THRESHOLD_MS = 5 * 60 * 1000;
      let hiddenAt = 0;
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'hidden') {
          hiddenAt = Date.now();
        } else if (document.visibilityState === 'visible' && hiddenAt) {
          const hiddenMs = Date.now() - hiddenAt;
          hiddenAt = 0;
          if (hiddenMs > HIDDEN_RELOAD_THRESHOLD_MS) location.reload();
        }
      });
    </script>
  </body>
</html>
