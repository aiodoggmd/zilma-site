---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  ogTitle?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishDate?: Date;
  verifiedDate?: Date;
}

const {
  title,
  ogTitle = title,
  description = 'Zilma — профессиональная косметика для салонов красоты: Wella, Londa, Schwarzkopf, Matrix, Lebel.',
  image = '/images/og-default.jpg',
  type = 'website',
  publishDate,
  verifiedDate,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png?v=3" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png?v=3" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#c8000f" />
    <title>{title}</title>

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Zilma" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {type === 'article' && publishDate && (
      <meta property="article:published_time" content={publishDate.toISOString()} />
    )}
    {type === 'article' && verifiedDate && (
      <meta property="article:modified_time" content={verifiedDate.toISOString()} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <slot name="head" />
  </head>
  <body>
    <Analytics />
    <slot />
    <script>
      function initReveal() {
        const selector = '.price-card, .section-title, .card, .prose > *';
        document.querySelectorAll(selector).forEach((el) => el.classList.add('reveal'));

        const revealEls = document.querySelectorAll('.reveal');
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );
        revealEls.forEach((el) => io.observe(el));
      }
      initReveal();
    </script>
  </body>
</html>
