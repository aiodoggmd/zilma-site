---
// Страница бренда — посадочная для поиска (решение 2026-09-07, см. CLAUDE.md).
//
// Зачем вообще: каталог живёт в модальном <dialog>, а его поисковик не видит — 218 позиций
// Wella для Google просто не существуют. Здесь тот же ассортимент лежит обычным текстом
// со своими ценами и кнопками заказа, то есть страница может приносить трафик по запросам
// вроде «Wella прайс».
//
// ENABLED — намеренно белый список, а не «все бренды сразу»: сначала выкатываем один бренд,
// смотрим вживую, и только потом тиражируем. Так же делали каталог и статьи; переделывать
// одну страницу дешевле, чем пятнадцать.
export const prerender = true;

import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import priceItems from '../../data/priceItems.json';
import { MIN_ORDER_TOTAL } from '../../lib/order-rules';

// В прайсе 1С бренд записан капсом, а линейки — служебными строками вида
// «KP Me+/CT - Красители и специальные продукты». В каталоге это привычно (мастер видит
// то же, что в накладной), но посадочная страница для поиска должна называть вещи так,
// как их ищут. Товары внутри таблицы при этом остаются с исходными именами из 1С —
// по ним сверяют заказ.
const BRAND_NAME: Record<string, string> = {
  WELLA: 'Wella',
};

const LINE_NAME: Record<string, string> = {
  'KP Me+/CT - Красители и специальные продукты': 'Koleston Perfect, Color Touch и окислители',
  'Illumina - Красители': 'Illumina Color',
  'SHINEFINITY - Гель-крем краска, цветное глазирование': 'Shinefinity',
  'INVIGO - Уход': 'INVIGO — уход',
  'EIMI - Укладка': 'EIMI — укладка',
};

// Короткое описание бренда — только проверяемые факты об ассортименте, без рекламных
// формулировок. Для брендов без описания страница соберётся и так, просто без абзаца.
const BRAND_TEXT: Record<string, string> = {
  WELLA:
    'Wella Professionals — профессиональные краски и уход для салонов. В прайсе Zilma ' +
    'представлены перманентная линия Koleston Perfect, безаммиачные Color Touch и Illumina ' +
    'Color, тонирующий гель-крем Shinefinity, осветляющие продукты Blondor, окислители ' +
    'Welloxon Perfect, а также уход INVIGO и стайлинг EIMI.',
};

export function getStaticPaths() {
  // Список объявлен ВНУТРИ функции намеренно: Astro выполняет getStaticPaths в отдельном
  // контексте, и переменные из фронтматтера ей не видны — сборка падает с «is not defined».
  // Расширять этот массив по мере проверки брендов.
  const ENABLED = ['WELLA'];
  return ENABLED.map((brand) => ({ params: { brand: brand.toLowerCase() } }));
}

const { brand: slug } = Astro.params;
const brandKey = (slug ?? '').toUpperCase();
const items = priceItems.filter((i) => i.brand.toUpperCase() === brandKey);
const rawBrand = items[0]?.brand ?? brandKey;
const brandTitle = BRAND_NAME[brandKey] ?? rawBrand;

// Линейки и категории считаем из самого прайса, а не держим отдельным списком:
// после каждого обновления цен страница пересобирается сама и не разъезжается с каталогом.
const byLine = new Map<string, typeof items>();
for (const it of items) {
  const line = it.line || 'Прочее';
  if (!byLine.has(line)) byLine.set(line, []);
  byLine.get(line)!.push(it);
}
const lines = [...byLine.entries()].sort((a, b) => b[1].length - a[1].length);

const byCategory = new Map<string, number>();
for (const it of items) {
  const cat = it.category || 'Без категории';
  byCategory.set(cat, (byCategory.get(cat) ?? 0) + 1);
}
const categories = [...byCategory.entries()].sort((a, b) => b[1] - a[1]);

const promoCount = items.filter((i) => i.promo).length;

// Гиды этого бренда — из тех же статей, что и лента на главной.
const guides = (await getCollection('articles'))
  .filter((a) => a.data.brand.toUpperCase() === brandKey)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

function money(v: number): string {
  return v.toLocaleString('ru-RU', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
}

const title = `${brandTitle}: прайс и гиды для мастеров`;
const description =
  `${brandTitle} в прайсе Zilma — ${items.length} позиций с ценами и наличием` +
  (promoCount ? `, ${promoCount} по акции` : '') +
  `. Краски, окислители и уход, гиды по оттенкам и заказ с доставкой по Москве.`;
---

<BaseLayout title={`${title} — Zilma`} description={description}>
  <div class="container page">
    <nav class="crumbs" aria-label="Хлебные крошки">
      <a href="/">Главная</a> <span aria-hidden="true">›</span> <span>{brandTitle}</span>
    </nav>

    <h1>{brandTitle}</h1>
    {BRAND_TEXT[brandKey] && <p class="lead">{BRAND_TEXT[brandKey]}</p>}

    <p class="stats">
      <b>{items.length}</b> позиций в прайсе{promoCount > 0 && <>, <b>{promoCount}</b> по акции</>}.
      Доставка по Москве бесплатно, минимальный заказ {MIN_ORDER_TOTAL.toLocaleString('ru-RU')} ₽.
    </p>

    <div class="brand-actions">
      <a class="brand-btn" href={`/#open-catalog=${brandKey}`}>Открыть в каталоге</a>
      <a class="brand-btn outline" href="/order/">Оформить заявку</a>
    </div>

    {guides.length > 0 && (
      <>
        <h2>Гиды по линейкам</h2>
        <p class="section-note">Пропорции, время выдержки и палитры оттенков с ценами по прайсу.</p>
        <div class="guide-grid">
          {guides.map((g) => (
            <ArticleCard
              id={g.id}
              title={g.data.title}
              description={g.data.description}
              line={g.data.line}
              brand={g.data.brand}
              tags={g.data.tags}
              coverImage={g.data.coverImage}
              publishDate={g.data.publishDate}
              verifiedDate={g.data.verifiedDate}
            />
          ))}
        </div>
      </>
    )}

    <h2>Что есть в наличии</h2>
    <ul class="cat-chips">
      {categories.map(([cat, n]) => (
        <li><span class="cat-name">{cat}</span> <span class="cat-num">{n}</span></li>
      ))}
    </ul>

    <h2>Прайс по линейкам</h2>
    {lines.map(([line, list]) => (
      <details class="line-block">
        <summary>
          <span class="line-name">{LINE_NAME[line] ?? line}</span>
          <span class="line-num">{list.length}</span>
        </summary>
        {/* Список, а не таблица: страницу открывают в основном с телефона, а таблица
            на три колонки там либо жмётся, либо едет вбок. Здесь строка товара — как
            в каталоге: имя переносится, цена и кнопка встают под ним на узком экране. */}
        <ul class="goods">
          {list.map((it) => (
            <li class="good">
              <span class="good-name">{it.name}</span>
              <span class="good-price">
                {it.promo && it.oldPrice
                  ? <><s>{money(it.oldPrice)} ₽</s> <b>{money(it.price)} ₽</b></>
                  : <>{money(it.price)} ₽</>}
              </span>
              <button
                type="button"
                class="cart-add-btn"
                data-name={it.name}
                data-price={it.price}
                data-brand={brandKey}
                data-promo={it.promo ? '1' : undefined}
              >+ В заявку</button>
            </li>
          ))}
        </ul>
      </details>
    ))}
  </div>
</BaseLayout>

<script>
  // Кнопки заказа работают так же, как в статьях: пишем в общую корзину (CartStore),
  // а не в скрытое поле формы — оно существует только на страницах с формой заявки.
  document.querySelectorAll<HTMLButtonElement>('.cart-add-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const cart = (window as unknown as { zilmaCart?: { get(): unknown[]; set(v: unknown[]): void } }).zilmaCart;
      if (!cart) return;
      const name = btn.dataset.name ?? '';
      const price = Number(btn.dataset.price ?? 0);
      const list = cart.get() as { name: string; price: number; qty: number }[];
      const found = list.find((x) => x.name === name);
      if (found) found.qty += 1;
      else list.push({ name, price, qty: 1 });
      cart.set(list);
      btn.textContent = 'Добавлено';
      btn.disabled = true;
      setTimeout(() => { btn.textContent = '+ В заявку'; btn.disabled = false; }, 1400);
    });
  });
</script>

<style>
  .page { padding-top: 28px; padding-bottom: 60px; }

  .crumbs {
    font-size: 0.85rem;
    color: var(--color-meta);
    margin-bottom: 14px;
  }
  .crumbs a { color: var(--color-blue-dark); }

  h1 {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 5vw, 2.6rem);
    margin: 0 0 12px;
  }

  .lead { margin: 0 0 14px; max-width: 68ch; line-height: 1.6; }

  .stats {
    margin: 0 0 20px;
    padding: 12px 14px;
    background: var(--color-panel);
    border: 1px solid var(--color-card-line);
    border-radius: var(--radius-card);
    font-size: 0.93rem;
  }

  .brand-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 34px; }
  .brand-btn {
    display: inline-block;
    padding: 11px 20px;
    border-radius: var(--radius-control);
    background: var(--color-red);
    color: #fff;
    text-decoration: none;
    font-size: 0.95rem;
  }
  .brand-btn.outline {
    background: var(--color-paper);
    color: var(--color-blue-dark);
    border: 1px solid var(--color-blue-dark);
  }
  .brand-btn:hover { opacity: 0.92; }

  h2 {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    margin: 34px 0 6px;
  }
  .section-note { margin: 0 0 16px; color: var(--color-meta); font-size: 0.9rem; }

  .guide-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 10px;
  }

  .cat-chips {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .cat-chips li {
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    padding: 7px 12px;
    border: 1px solid var(--color-card-line);
    border-radius: var(--radius-control);
    background: var(--color-paper);
    font-size: 0.88rem;
  }
  .cat-num { color: var(--color-meta); font-variant-numeric: tabular-nums; }

  .line-block {
    border: 1px solid var(--color-card-line);
    border-radius: var(--radius-card);
    background: var(--color-paper);
    margin-bottom: 10px;
  }
  .line-block > summary {
    cursor: pointer;
    padding: 13px 16px;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-weight: 600;
    list-style: none;
  }
  .line-block > summary::-webkit-details-marker { display: none; }
  .line-num { color: var(--color-meta); font-variant-numeric: tabular-nums; font-weight: 400; }

  .goods { list-style: none; margin: 0; padding: 0; }
  .good {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 6px 14px;
    padding: 11px 16px;
    border-top: 1px solid var(--color-panel-line);
  }
  .good-name { font-size: 0.9rem; line-height: 1.35; }
  .good-price { white-space: nowrap; font-variant-numeric: tabular-nums; font-size: 0.9rem; }
  .good-price s { color: var(--color-meta); margin-right: 4px; }
  .good-price b { color: var(--color-red); }

  /* На телефоне имя занимает всю ширину, цена и кнопка встают под ним одной строкой —
     иначе длинное название из 1С сжимает цену в столбик по одному символу. */
  @media (max-width: 560px) {
    .good { grid-template-columns: 1fr auto; }
    .good-name { grid-column: 1 / -1; }
  }

  .cart-add-btn {
    font: inherit;
    font-size: 0.85rem;
    padding: 6px 12px;
    border: 1px solid var(--color-blue-dark);
    border-radius: var(--radius-control);
    background: var(--color-blue-dark);
    color: #fff;
    cursor: pointer;
    white-space: nowrap;
  }
  .cart-add-btn:disabled { opacity: 0.6; cursor: default; }

  @media (max-width: 900px) {
    .guide-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .guide-grid { grid-template-columns: 1fr; }
    .line-table th, .line-table td { padding: 8px 10px; }
  }
</style>
