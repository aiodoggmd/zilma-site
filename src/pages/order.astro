---
// Явная статика: с output:'server' (нужен для /api/order) страница иначе рендерилась бы
// на каждый запрос вместо предсборки.
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import PriceBlock from '../components/PriceBlock.astro';
import PriceChecklist from '../components/PriceChecklist.astro';
import OrderForm from '../components/OrderForm.astro';
import { currentPrice } from '../data/prices';
import priceItems from '../data/priceItems.json';
---
<BaseLayout
  title="Заказать по актуальному прайсу — Zilma"
  description="Выберите нужные позиции из актуального прайса Wella, Londa, Schwarzkopf, Matrix, Lebel и оформите заявку — свяжемся с вами для подтверждения."
>
  <div class="container page">
    <a href="/" class="back" id="order-back">← Назад</a>
    <!-- Форма/корзина — первым блоком на странице, не после прайса. Раньше OrderForm стояла
         последней, а сюда обычно приходят по прямому переходу "/order/#order" (кнопка «Корзина»
         с других страниц) — свежая загрузка страницы должна была допрыгнуть якорем вниз мимо
         PriceBlock, и на реальном телефоне это было видно как «мелькнул прайс, подвисло, потом
         скролл к форме» (2026-08-28/30). С формой первым блоком прыгать вообще никуда не нужно —
         страница открывается сразу в нужном месте, без видимого скачка. -->
    <OrderForm />
    <PriceBlock
      kind="current"
      title="Актуальный прайс-лист"
      description="Полный прайс на профессиональную косметику Wella, Londa, Schwarzkopf, Matrix, Lebel."
      file={currentPrice.file}
      date={currentPrice.date}
    />
    <PriceChecklist items={priceItems} instanceId="checklist-current" heading="ZILMA" />
  </div>
</BaseLayout>

<script>
  // Реальный баг с телефона (2026-08-28): клиент выбирал оттенок в интерактивной палитре
  // статьи, переходил в корзину указать количество, а обратно попадал не в статью на том же
  // месте, а на главную (ссылка была жёстко href="/"). Если сюда пришли с другой страницы
  // этого же сайта (typично — со статьи), настоящий переход «назад» в истории браузера
  // возвращает именно туда и восстанавливает прокрутку — обычная ссылка на "/" так не умеет,
  // это всегда новый переход. Если пришли напрямую (закладка, новая вкладка) — просто идём
  // по обычной ссылке на главную.
  const backLink = document.getElementById('order-back') as HTMLAnchorElement | null;
  if (backLink && document.referrer) {
    try {
      if (new URL(document.referrer).origin === location.origin) {
        backLink.addEventListener('click', (e) => {
          e.preventDefault();
          history.back();
        });
      }
    } catch {}
  }
</script>

<style>
  .page {
    padding-top: 32px;
    padding-bottom: 20px;
  }

  .back {
    display: inline-block;
    margin-bottom: 20px;
    color: var(--color-blue-dark);
    font-size: 0.92rem;
    text-decoration: none;
  }

  .back:hover {
    text-decoration: underline;
  }

  /* На мобильном «Назад» убрана, а форма поднята к верху (правка пользователя 2026-09-05):
     внизу постоянно висит плашка навигации с «Главная», и ссылка её просто дублировала,
     занимая первый экран — тот самый, ради которого страницу и открывают.
     На десктопе плашки нет, там «Назад» единственный видимый путь обратно (кроме кнопки
     браузера) — поэтому скрываем ровно там, где появляется плашка, а не везде. */
  @media (max-width: 640px) {
    .page {
      padding-top: 10px;
    }
    .back {
      display: none;
    }
  }
</style>
