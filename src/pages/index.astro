---
// Явная статика: с output:'server' (нужен для /api/order) все страницы по умолчанию
// рендерились бы на каждый запрос — эта осталась быстрой предсобранной статикой.
export const prerender = true;
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import PriceBlock from '../components/PriceBlock.astro';
import FilterTabs from '../components/FilterTabs.astro';
import ArticleCard from '../components/ArticleCard.astro';
import OrderForm from '../components/OrderForm.astro';
import PriceChecklist from '../components/PriceChecklist.astro';
import { currentPrice } from '../data/prices';
import priceItems from '../data/priceItems.json';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const [newest, ...rest] = articles;
// "Zilma" — служебное значение brand у статей базы знаний (не привязанных к бренду
// поставщика), а не реальный бренд — в фильтре он дублировал бы категорию "база знаний".
const brands = [...new Set(articles.map((a) => a.data.brand))]
  .filter((b) => b !== 'Zilma')
  .sort((a, b) => a.localeCompare(b, 'ru'));

const promoItems = priceItems.filter((it) => it.promo);

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Zilma',
  url: siteUrl,
  logo: `${siteUrl}/images/logo.jpg`,
  description: 'Zilma — поставщик профессиональной косметики для салонов красоты: Wella, Londa, Schwarzkopf, Matrix, Lebel.',
  areaServed: 'RU',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Москва',
    addressCountry: 'RU',
  },
};
---
<BaseLayout
  title="Zilma — профессиональная косметика для салонов"
  description="Актуальный прайс и прайс с акциями на профессиональную косметику Wella, Londa, Schwarzkopf, Matrix, Lebel — плюс гиды по оттенкам для мастеров."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(organizationLd)} />
  <Hero />

  <div class="container">
    <div class="price-grid">
      <PriceBlock
        kind="current"
        title="Актуальный прайс-лист"
        description="Полный прайс на профессиональную косметику Wella, Londa, Schwarzkopf, Matrix, Lebel."
        file={currentPrice.file}
        date={currentPrice.date}
      />
      <OrderForm framed />
    </div>

    <PriceChecklist items={priceItems} instanceId="checklist-current" heading="ZILMA" />
    <PriceChecklist items={promoItems} instanceId="checklist-promo" heading="Акции" groupBy="discount" />

    {/* Витрина оттенков убрана 2026-09-05 по решению пользователя: стена из цветов без
        привязки к бренду и линейке полезна «зевакам, которым нужен цвет», а мастер выбирает
        оттенок ВНУТРИ своей линейки — ему нужен и цвет, и бренд сразу. Вместо неё палитры
        подняты наверх самих статей, ближе к заказу. Не возвращать без явной просьбы. */}

    <h2 class="section-title" id="info">Инфо</h2>
    <FilterTabs brands={brands} />

    <div class="article-grid">
      {newest && (
        <ArticleCard
          id={newest.id}
          title={newest.data.title}
          description={newest.data.description}
          line={newest.data.line}
          brand={newest.data.brand}
          tags={newest.data.tags}
          coverImage={newest.data.coverImage}
          publishDate={newest.data.publishDate}
          verifiedDate={newest.data.verifiedDate}
          isNew={true}
          size="lg"
        />
      )}
      {rest.map((a) => (
        <ArticleCard
          id={a.id}
          title={a.data.title}
          description={a.data.description}
          line={a.data.line}
          brand={a.data.brand}
          tags={a.data.tags}
          coverImage={a.data.coverImage}
          publishDate={a.data.publishDate}
          verifiedDate={a.data.verifiedDate}
        />
      ))}
    </div>
  </div>

  <footer class="site-footer">
    <div class="container">
      <p>Zilma — профессиональная косметика для салонов красоты. © {new Date().getFullYear()}</p>
    </div>
  </footer>

  <script>
    // На мобильном хиро занимает весь первый экран — сразу под ним самое полезное
    // (почему заказывают у нас + новость). Даём хиро показаться и доиграть анимацию
    // логотипа, затем мягко доскролливаем до полезного блока. Не мешает переходам
    // по конкретному якорю (#info, #order и т.п.) — там скроллим только напрямую.
    // data-anchor-nav ставит openFromHash в PriceChecklist.astro — см. подробный разбор там.
    // Коротко: он снимает якорь со строки адреса, и одной проверки location.hash мало —
    // к моменту этой строки якоря может уже не быть, хотя переход был именно по нему.
    if (window.innerWidth <= 640 && !location.hash && !document.documentElement.dataset.anchorNav) {
      // Человек тронул страницу сам — отступаем. Без этого автоскролл спорит с живым
      // действием, а спорить он не имеет права: у человека всегда приоритет.
      let cancelled = false;
      const cancel = () => { cancelled = true; };
      ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach((ev) =>
        window.addEventListener(ev, cancel, { once: true, passive: true })
      );

      setTimeout(() => {
        // Реальный баг, найден пользователем 2026-09-04 ("мега авария"): если открыть Каталог/
        // Акции быстро после загрузки (страница в это время залочена через position:fixed, см.
        // lockPageScroll в PriceChecklist.astro), этот таймер всё равно срабатывал вслепую -
        // scrollIntoView попадал на залоченную страницу, и после закрытия диалога пользователя
        // отбрасывало на блок "Почему заказывают", а не туда, где он реально был. Пропускаем
        // автоскролл целиком, если в этот момент открыт любой диалог каталога/акций.
        if (document.querySelector('dialog[open]')) return;
        if (cancelled) return;

        // ПОВТОРНАЯ проверка якоря — именно здесь, а не только при заведении таймера.
        // Реальный баг с телефона (2026-09-05, пойман диагностикой ?debug=nav): человек
        // открыл главную и через СЕКУНДУ тапнул «Инфо». Таймер к тому моменту уже был
        // заведён (якоря при загрузке не было), «Инфо» честно увела на 2271, а потом
        // сработал этот таймер и утащил страницу обратно на 178 — к хиро. В логе это
        // видно построчно: 2271 -> 1481 -> 178.
        // Урок: у отложенного действия условия надо перепроверять В МОМЕНТ выполнения.
        // За полторы секунды на странице успевает произойти что угодно.
        if (location.hash || document.documentElement.dataset.anchorNav) return;

        // Куда именно останавливаться (уточнено пользователем 2026-09-05 на реальном
        // телефоне): в кадре должны поместиться логотип, причины «Почему заказывают
        // у Zilma» и панель с новостью — целиком, не обрезанные нижней плашкой.
        //
        // Прокручивать до фиксированного блока нельзя: содержимое плавающее. Новость
        // бывает разной высоты, а бывает её нет вовсе — тогда на её месте остаётся дата
        // обновления прайса, и она тоже должна попасть в кадр. Поэтому берём НИЖНИЙ край
        // .stat-panel (в неё входит и дата, и новость) и прокручиваем ровно настолько,
        // чтобы этот край встал над плашкой навигации. Если всё и так помещается —
        // Math.max(0, ...) даёт 0, и страница не дёргается вовсе.
        const anchor = document.querySelector('.price-card.current .stat-panel');
        if (!anchor) return;
        const nav = document.querySelector('nav[aria-label="Быстрая навигация"]');
        const navH = nav ? nav.getBoundingClientRect().height + 16 : 96;
        const bottom = anchor.getBoundingClientRect().bottom;
        const wanted = Math.max(0, window.scrollY + bottom - (window.innerHeight - navH));

        // Потолок прокрутки: верх логотипа не должен уйти за край экрана.
        // На реальном телефоне видимая высота меньше, чем кажется (адресная строка),
        // и логотип + причины + новость вместе могут не поместиться. Тогда первый
        // расчёт «дотянуть нижний край» срезал логотип сверху — пользователь прислал
        // скриншот (2026-09-05). Логотип режем в последнюю очередь: он и есть точка,
        // с которой начинается нужный кадр, а новость внизу пусть обрежется.
        const art = document.querySelector('.hero-art');
        const ceiling = art
          ? Math.max(0, window.scrollY + art.getBoundingClientRect().top - 2)
          : wanted;

        window.scrollTo({ top: Math.min(wanted, ceiling), behavior: 'smooth' });
      }, 1600);
    }
  </script>
</BaseLayout>

<style>
  /* Белый фон вместо тёплого беж-крема (--color-page-bg) — только на главной, глобальный
     токен не трогаем (используется на страницах статей, там оставляем как было). */
  :global(body) {
    background: var(--color-paper);
  }

  .price-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 44px;
    /* Каждая карточка своей естественной высоты (решение пользователя 2026-09-05).
       По умолчанию grid растягивает обе колонки до высоты самой высокой: форма заявки
       выше карточки прайса, и та добирала разницу пустотой — дыра между текстом и
       кнопками плюс сплющенная новостная плашка (замерено: 572px против 860px при
       шести товарах в корзине). Дыра росла вместе с корзиной, то есть композиция
       зависела от того, сколько товаров набрал клиент. Теперь не зависит. */
    align-items: start;
  }

  /* Без этого grid-элемент по умолчанию min-width:auto — трек 1fr раздувается
     под min-content самого широкого потомка вместо того чтобы сжаться до контейнера.
     :global() обязателен — прямые потомки (.price-card, .order-form) рендерятся
     другими компонентами и не получают scope-атрибут index.astro. */
  .price-grid > :global(*) {
    min-width: 0;
  }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    padding-bottom: 60px;
  }

  .article-grid :global(.card.lg) {
    grid-column: span 3;
  }

  .site-footer {
    background: var(--color-ink);
    color: #cbb;
    padding: 24px 0;
    font-size: 0.85rem;
  }

  @media (max-width: 900px) {
    .article-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .article-grid :global(.card.lg) {
      grid-column: span 2;
    }
  }

  @media (max-width: 860px) {
    .price-grid {
      grid-template-columns: 1fr;
      /* 14px вместо 28px: этот зазор — последнее, что мешало логотипу, причинам и
         новости уместиться в один кадр после автоскролла на коротком экране. */
      margin-top: 14px;
    }
  }

  @media (max-width: 640px) {
    .article-grid {
      grid-template-columns: 1fr;
    }
    .article-grid :global(.card.lg) {
      grid-column: span 1;
    }
  }
</style>
