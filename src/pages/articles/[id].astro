  }

  .prose :global(.callout ul:last-child) {
    margin-bottom: 0;
  }

  .prose :global(.zoom-hint) {
    margin: -10px 0 16px;
    font-size: 0.76rem;
    color: var(--color-meta);
    text-align: center;
  }

  /* чеклист «область применения» — зелёные галочки. На мобильном flex-wrap-пилюли разной ширины
     переносились вразнобой (то 1 в ряд, то 2 неровных) — некрасиво и нечитаемо (реальная жалоба
     пользователя на статье Lebel, 2026-08-28, но виджет общий для всех гид-статей — чиним сразу
     везде). На узких экранах — ровная сетка 2 колонки, пилюли тянутся на всю ширину своей ячейки. */
  .prose :global(.checklist) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 10px;
    margin: 16px 0;
    padding: 0;
    list-style: none;
  }

  .prose :global(.checklist li) {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--surface-card);
    border: 1px solid var(--color-panel-line);
    border-radius: 4px;
    padding: 8px 14px 8px 10px;
    font-size: 0.84rem;
    line-height: 1.3;
    width: 100%;
  }

  @media (max-width: 640px) {
    .prose :global(.checklist) {
      grid-template-columns: 1fr 1fr;
    }
  }

  .prose :global(.checklist .check-icon) {
    flex: none;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--color-blue-dark);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: 700;
    box-shadow: var(--shadow-sm);
  }

  /* Виджеты для статей раздела «База знаний» (первая — 2026-08-29, «Почему цвет волос выцветает
     неравномерно») — это не гид по товару, а редакционный лонгрид, поэтому набор виджетов другой:
     оглавление, вопрос-ответ, нумерованные шаги. Переиспользовать для любой будущей статьи этого
     раздела, не изобретать заново. */

  /* оглавление «В этой статье» — ссылки на автоматические id заголовков. Проверено программно
     (2026-08-29): id для заголовков со смайликами генерируются стабильно на каждой сборке (не
     случайно), просто некрасиво — ведущий дефис вместо вырезанного смайла, а у эмодзи с
     variation selector (☀️, 🗣️ и т.п.) перед дефисом остаётся невидимый символ ️. Смотреть
     фактический id в браузере (document.querySelectorAll('h2,h3')) перед тем как проставлять
     ссылки в новой статье — не гадать по шаблону. */
  .prose :global(.toc-box) {
    background: var(--surface-card);
    border: 1px solid var(--color-panel-line);
    border-radius: 6px;
    padding: 20px 24px;
    margin: 20px 0;
  }

  .prose :global(.toc-box .toc-title) {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.05rem;
    margin: 0 0 10px;
