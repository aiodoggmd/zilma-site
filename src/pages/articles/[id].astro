  }

  .prose :global(.callout .callout-order) {
    margin-top: 10px;
  }

  .prose :global(table th) {
    background: var(--surface-flat);
    color: var(--color-ink);
    text-align: left;
    padding: 10px 14px;
    font-family: var(--font-serif);
