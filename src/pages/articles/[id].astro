---
// Явная статика: с output:'server' (нужен для /api/order) страница иначе рендерилась бы
// на каждый запрос вместо предсборки — а getStaticPaths() как раз для предсборки и нужен.
export const prerender = true;
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categoryColor } from '../../lib/category-color';
import ShadeSwatchGrid from '../../components/ShadeSwatchGrid.astro';
import { resolveLiveShades } from '../../lib/resolve-live-price';
import illuminaShadesRaw from '../../data/illumina-shades.json';
import shinefinityShadesRaw from '../../data/shinefinity-shades.json';
import kolestonShadesRaw from '../../data/koleston-shades.json';
import colortouchShadesRaw from '../../data/colortouch-shades.json';
import igoraRoyalShadesRaw from '../../data/igora-royal-shades.json';
import londaShadesRaw from '../../data/londa-shades.json';
import londaDemiShadesRaw from '../../data/londa-demi-shades.json';
import colortuneShadesRaw from '../../data/colortune-shades.json';
import priceItems from '../../data/priceItems.json';

// Цена/наличие каждого оттенка пересчитывается из актуального priceItems.json на каждой
// сборке сайта (по артикулу — см. resolve-live-price.ts), а не берётся застывшей из
// data-файла линии — тот же дрейф цены, что чинили для kit-table, был и здесь.
const illuminaShades = resolveLiveShades(illuminaShadesRaw, 'WELLA');
const shinefinityShades = resolveLiveShades(shinefinityShadesRaw, 'WELLA');
const kolestonShades = resolveLiveShades(kolestonShadesRaw, 'WELLA');
const colortouchShades = resolveLiveShades(colortouchShadesRaw, 'WELLA');
const igoraRoyalShades = resolveLiveShades(igoraRoyalShadesRaw, 'SCHWARZKOPF');
const londaShades = resolveLiveShades(londaShadesRaw, 'LONDA');
const londaDemiShades = resolveLiveShades(londaDemiShadesRaw, 'LONDA');
const colortuneShades = resolveLiveShades(colortuneShadesRaw, 'LONDA');

const PALETTE_SHADES: Record<string, typeof illuminaShades> = {
  '2026-08-13-illumina-color': illuminaShades,
  '2026-08-13-shinefinity': shinefinityShades,
  '2026-08-13-koleston-perfect': kolestonShades,
  '2026-08-13-color-touch': colortouchShades,
  '2026-08-28-igora-royal': igoraRoyalShades,
  '2026-08-29-londa-professional': londaShades,
  '2026-08-30-londa-color-tune': colortuneShades,
};

// Заголовок над основной палитрой — по умолчанию общий, но для линеек с несколькими
// категориями оттенков (напр. Londa: аммиачная Permanent и безаммиачная тонирующая) нужно
// уточнение, чтобы не перепутать с дополнительной палитрой ниже.
const PALETTE_TITLE: Record<string, string> = {
  '2026-08-29-londa-professional': 'Аммиачная линия (Permanent) — с ценами по прайсу',
};

// Вторая, отдельная палитра оттенков для линеек, где один и тот же номер оттенка продаётся
// в двух разных формулах (напр. Londa Permanent и Londa безаммиачное тонирование —
// разные товары в прайсе, разные точки-маркеры на официальной карте). Использует ту же
// группировку по тоновым семействам, что и основная палитра (PALETTE_GROUP_CONFIG ниже).
const PALETTE_SHADES_SECONDARY: Record<string, typeof illuminaShades> = {
  '2026-08-29-londa-professional': londaDemiShades,
};
const PALETTE_TITLE_SECONDARY: Record<string, string> = {
  '2026-08-29-londa-professional': 'Безаммиачная линия (тонирование) — с ценами по прайсу',
};

// Статьи, где интерактивная палитра построена из реальных фото свотчей (не сэмплированного
// цвета со статичной картинки) — отдельная статичная карта оттенков признана избыточной,
// подсказка «более точный цвет — в палитре выше» тут не нужна (Londa, 2026-08-30).
const PALETTE_NO_STATIC_IMAGE = new Set([
  '2026-08-29-londa-professional',
  '2026-08-13-illumina-color',
  '2026-08-13-shinefinity',
  '2026-08-13-koleston-perfect',
  '2026-08-13-color-touch',
  '2026-08-28-igora-royal',
  '2026-08-30-londa-color-tune',
]);

// Линейки с нерегулярной структурой палитры (несколько несовпадающих семейств оттенков вместо
// одной ровной сетки) передают свой набор групп сюда — по умолчанию ShadeSwatchGrid использует
// warm/neutral/cool/opal/booster (Illumina/Shinefinity), этого словаря для них не нужно.
const PALETTE_GROUP_CONFIG: Record<string, { order: string[]; labels: Record<string, string>; flat: string[] }> = {
  '2026-08-13-koleston-perfect': {
    order: ['pure', 'rich', 'deep', 'vibrant', 'blonde', 'mix'],
    labels: { pure: 'Pure Naturals', rich: 'Rich Naturals', deep: 'Deep Browns', vibrant: 'Vibrant Reds', blonde: 'Special Blonde', mix: 'Special Mix' },
    flat: ['blonde', 'mix'],
  },
  '2026-08-13-color-touch': {
    order: ['pure', 'rich', 'deep', 'vibrant', 'plus', 'mix'],
    labels: { pure: 'Pure Naturals', rich: 'Rich Naturals', deep: 'Deep Browns', vibrant: 'Vibrant Reds', plus: 'Color Touch Plus', mix: 'Special Mix' },
    flat: ['mix'],
  },
  '2026-08-28-igora-royal': {
    order: ['naturals', 'cendres', 'beiges', 'chocolates', 'reds', 'absolutes', 'highlifts', 'specialities'],
    labels: {
      naturals: 'Naturals',
      cendres: 'Cendrés & Cools',
      beiges: 'Beiges & Golds',
      chocolates: 'Chocolates',
      reds: 'Reds',
      absolutes: 'Absolutes',
      highlifts: 'Highlifts & Pastels',
      specialities: 'Specialities',
    },
    flat: ['specialities'],
  },
  '2026-08-29-londa-professional': {
    order: ['natural', 'ash', 'matt', 'gold', 'copper', 'red', 'violet', 'brown', 'pearl', 'cendre', 'mixtone', 'pastel'],
    labels: {
      natural: 'Натуральные',
      ash: 'Пепельные',
      matt: 'Матовые',
      gold: 'Золотистые',
      copper: 'Медные',
      red: 'Красные',
      violet: 'Фиолетовые',
      brown: 'Коричневые',
      pearl: 'Жемчужные',
      cendre: 'Сандрэ',
      mixtone: 'Микс-тона',
      pastel: 'Пастельные микс-тона',
    },
    flat: ['mixtone', 'pastel'],
  },
  '2026-08-30-londa-color-tune': {
    order: ['tune'],
    labels: { tune: 'Оттенки Color Tune' },
    flat: ['tune'],
  },
};

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((a) => ({
    params: { id: a.id },
    props: { article: a },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const formattedDate = article.data.verifiedDate.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
const accent = categoryColor(article.data.tags);

// Таблицы "Что заказать" в markdown статей — сырой HTML с ценой/промо/наличием, вписанными
// вручную на момент написания статьи (тот же дрейф, что и у интерактивной палитры выше,
// только это обычный текст в markdown, а не JS-данные — резолвить на сборке сайта, как
// resolve-live-price.ts делает для палитр, здесь не получится без переезда на MDX).
// Вместо этого — тот же (бренд, артикул) поиск, но на клиенте: сервер только отдаёт
// урезанный список товаров (без id/isNew/discountPct), клиентский initLivePrices() ниже
// сверяет с ним каждую кнопку "+ В заявку"/"Нет в наличии" на странице при загрузке.
const priceLookup = priceItems.map((it) => ({
  name: it.name,
  brand: it.brand,
  price: it.price,
  oldPrice: it.oldPrice ?? null,
  promo: it.promo,
  // размер скидки и признак новинки — чтобы таблицы статей показывали то же, что каталог
  discountPct: 'discountPct' in it ? (it as { discountPct?: number }).discountPct ?? null : null,
  isNew: 'isNew' in it ? (it as { isNew?: boolean }).isNew ?? false : false,
}));

// «Ещё гиды по бренду» внизу статьи — чтобы из Koleston можно было сразу перейти в Color Touch,
// Illumina или Blondor, не возвращаясь на главную и не пролистывая ленту, отсортированную по
// дате публикации (у одного бренда гиды часто разбросаны по времени создания).
const allArticles = await getCollection('articles');
const sameBrandArticles = allArticles
  .filter((a) => a.id !== article.id && a.data.brand === article.data.brand)
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'ru'));

function truncateTitle(title: string, max = 70) {
  if (title.length <= max) return title;
  const cut = title.slice(0, max);
  const lastSpace = cut.lastIndexOf(' ');
  const trimmed = (lastSpace > 40 ? cut.slice(0, lastSpace) : cut).replace(/[\s:,.;—-]+$/, '');
  return `${trimmed}…`;
}
const ogTitle = truncateTitle(article.data.title);

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.data.title,
  description: article.data.description,
  image: `${siteUrl}${article.data.coverImage}`,
  datePublished: article.data.publishDate.toISOString(),
  dateModified: article.data.verifiedDate.toISOString(),
  author: { '@type': 'Organization', name: 'Zilma' },
  publisher: { '@type': 'Organization', name: 'Zilma', logo: { '@type': 'ImageObject', url: `${siteUrl}/images/logo.jpg` } },
};
---
<BaseLayout
  title={`${article.data.title} — Zilma`}
  ogTitle={ogTitle}
  description={article.data.description}
  image={article.data.coverImage}
  type="article"
  publishDate={article.data.publishDate}
  verifiedDate={article.data.verifiedDate}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(articleLd)} />
  <div class="cover-wrap">
    <div class={`cover cover-${accent}`}>
      <div class="cover-overlay"></div>
    </div>
    <div class={`container cover-inner cover-inner-${accent}`}>
      <div class="cover-text">
        <p class="cover-tagline">Профессиональная<br />косметика для салонов</p>
        <p class="cover-subtitle">Гид по брендам и подбор оттенков — всё для работы мастера.</p>
      </div>
      <div class="cover-art">
        <div class="cover-halo"></div>
        <div class="cover-bubble">
          <img src="/images/logo.jpg" alt="Zilma" class="cover-logo" />
        </div>
      </div>
    </div>
    <article class={`container article accent-${accent}`}>
      <a href="/" class="back" aria-label="Все статьи">←</a>
      <h1>{article.data.title}</h1>
      <p class="meta">Обновлено: {formattedDate}</p>
      <script type="application/json" id="price-lookup-data" set:html={JSON.stringify(priceLookup)} />
      <div class="prose">
        <Content />
      </div>
      {PALETTE_SHADES[article.id] && (
        <div class="prose">
          <h2 id="permanent-line">{PALETTE_TITLE[article.id] ?? 'Интерактивная палитра — с ценами по прайсу'}</h2>
          <ShadeSwatchGrid
            shades={PALETTE_SHADES[article.id]}
            groupOrder={PALETTE_GROUP_CONFIG[article.id]?.order}
            groupLabels={PALETTE_GROUP_CONFIG[article.id]?.labels}
            flatGroups={PALETTE_GROUP_CONFIG[article.id]?.flat}
            cartBrand={article.data.brand.toUpperCase()}
            showPaletteNote={!PALETTE_NO_STATIC_IMAGE.has(article.id)}
          />
        </div>
      )}
      {PALETTE_SHADES_SECONDARY[article.id] && (
        <div class="prose">
          <h2 id="demi-line">{PALETTE_TITLE_SECONDARY[article.id]}</h2>
          <ShadeSwatchGrid
            shades={PALETTE_SHADES_SECONDARY[article.id]}
            groupOrder={PALETTE_GROUP_CONFIG[article.id]?.order}
            groupLabels={PALETTE_GROUP_CONFIG[article.id]?.labels}
            flatGroups={PALETTE_GROUP_CONFIG[article.id]?.flat}
            cartBrand={article.data.brand.toUpperCase()}
            showPaletteNote={!PALETTE_NO_STATIC_IMAGE.has(article.id)}
          />
        </div>
      )}
      {/* Обратный переход: из гида — в прайс. Раньше из статьи можно было добавить
          только те товары, что в ней упомянуты; чтобы посмотреть ВЕСЬ бренд, нужно было
          возвращаться на главную и искать его руками. Хэш открывает каталог сразу на
          нужной папке (см. openFromHash в PriceChecklist.astro). */}
      <div class="prose to-catalog">
        <a class="to-catalog-btn" href={`/#open-catalog=${encodeURIComponent(article.data.brand.toUpperCase())}`}>
          Смотреть весь {article.data.brand} в прайсе
        </a>
        <p class="to-catalog-note">Цены и наличие — актуальные, с возможностью сразу собрать заявку.</p>
      </div>
      {sameBrandArticles.length > 0 && (
        <div class="prose related-articles">
          <h2>Ещё гиды {article.data.brand}</h2>
          <ul class="related-list">
            {sameBrandArticles.map((a) => (
              <li><a href={`/articles/${a.id}/`}>{a.data.title}</a></li>
            ))}
          </ul>
        </div>
      )}
      <a href="/" class="back back-bottom" aria-label="Все статьи">←</a>
    </article>
  </div>
</BaseLayout>

<style>
  /* Белый фон, как на главной (2026-09-05). До этого статьи оставались на тёплом
     беж-креме --color-page-bg, и рядом с уже побелевшей главной это читалось как
     две разные версии сайта. Сам токен не трогаем — он может пригодиться, просто
     страницы его больше не используют. */
  :global(body) {
    background: var(--color-paper);
  }

  /* Пастель внутри статьи следует КАТЕГОРИИ, а не всегда голубая (замечание
     пользователя 2026-09-05): колористика — голубая, уход и восстановление —
     розовая, база знаний — градиент из обеих. Тот же categoryColor, что уже красил
     шапку статьи и карточку в ленте, теперь задаёт и фон виджетов внутри.

     Через переменные, а не через дубли правил на каждый акцент: правил с фоном
     внутри .prose полтора десятка, и трижды их копировать — гарантированный
     источник расхождений при следующей правке.

     --surface-card — для крупных виджетов, --surface-flat — для строчной мелочи
     (шапка таблицы, чипы): на высоте в 20px градиент не читается, кроме случая
     «база знаний», где сам градиент и есть смысл. */
  .article {
    --surface-card: var(--gradient-surface-blue);
    --surface-flat: var(--color-surface-blue);
  }

  .article.accent-red {
    --surface-card: var(--gradient-surface-pink);
    --surface-flat: var(--color-surface-pink);
  }

  .article.accent-gradient {
    --surface-card: linear-gradient(160deg, #fdf3f6 0%, #fae6ea 45%, #cbe3fb 100%);
    --surface-flat: linear-gradient(120deg, #fae6ea 0%, #cbe3fb 100%);
  }

  .cover-wrap {
    position: relative;
  }

  .cover {
    height: 260px;
    position: relative;
    overflow: hidden;
  }

  .cover-blue {
    background: linear-gradient(135deg, var(--color-blue-dark), var(--color-blue));
  }

  .cover-red {
    background: var(--color-red);
  }

  .cover-gradient {
    background: linear-gradient(135deg, var(--color-red), var(--color-blue-dark));
  }

  .cover-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 75%, rgba(43, 32, 28, 0.08) 100%);
  }

  .cover-inner {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 260px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    z-index: 3;
    pointer-events: none;
  }

  .cover-text {
    max-width: 460px;
  }

  .cover-tagline {
    font-family: var(--font-serif);
    font-weight: 600;
    color: var(--color-cream);
    font-size: clamp(1.7rem, 3.2vw, 2.5rem);
    line-height: 1.15;
    margin: 0;
  }

  .cover-subtitle {
    margin: 8px 0 0;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--color-cream);
    opacity: 0.88;
  }

  .cover-art {
    position: relative;
    flex-shrink: 0;
    width: clamp(180px, 20vw, 210px);
    aspect-ratio: 1;
  }

  .cover-halo {
    position: absolute;
    inset: -9%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.92) 0%, rgba(255, 255, 255, 0.28) 34%, rgba(255, 255, 255, 0) 56%);
  }

  .cover-bubble {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 0 0 6px rgba(250, 243, 234, 0.32), 0 20px 40px rgba(0, 0, 0, 0.35);
  }

  .cover-logo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    animation: zilma-wipe 2.1s cubic-bezier(0.25, 0.7, 0.3, 1) 0.3s forwards;
  }

  @keyframes zilma-wipe {
    from {
      -webkit-mask-image: linear-gradient(100deg, transparent 0%, transparent 42%, black 58%, black 100%);
      mask-image: linear-gradient(100deg, transparent 0%, transparent 42%, black 58%, black 100%);
      -webkit-mask-size: 320% 100%;
      mask-size: 320% 100%;
      -webkit-mask-position: 0% 0;
      mask-position: 0% 0;
    }
    to {
      -webkit-mask-image: linear-gradient(100deg, transparent 0%, transparent 42%, black 58%, black 100%);
      mask-image: linear-gradient(100deg, transparent 0%, transparent 42%, black 58%, black 100%);
      -webkit-mask-size: 320% 100%;
      mask-size: 320% 100%;
      -webkit-mask-position: 100% 0;
      mask-position: 100% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cover-logo {
      animation: none;
    }
  }

  /* На мобильных .cover не подстраивался под контент вовсе — фикс.-высота 260px + overflow:hidden
     обрезали двухстрочный тэглайн и булю-лого сбоку, как только для них переставало хватать ширины
     (у Hero.astro на главной та же проблема решена стеканием текст-над-лого при max-width:720px).
     Здесь идём другим путём: .cover и .cover-inner — сиблинги (не родитель/потомок, см. комментарий
     выше про намеренный нахлёст логотипа на стык баннера и карточки), поэтому вместо того чтобы
     угадывать высоту .cover в px под стекающийся контент .cover-inner, на мобильных просто прячем
     исходный .cover, а .cover-inner сам становится цветной полосой — его высота тогда естественно
     подстраивается под реальный контент (текст + логотип), без нахлёстов и магических отступов. */
  @media (max-width: 720px) {
    .cover {
      display: none;
    }

    .cover-inner {
      position: static;
      height: auto;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      text-align: center;
      gap: 16px;
      padding: 28px 20px 56px;
      pointer-events: auto;
    }

    .cover-inner-blue {
      background: linear-gradient(135deg, var(--color-blue-dark), var(--color-blue));
    }

    .cover-inner-red {
      background: var(--color-red);
    }

    .cover-inner-gradient {
      background: linear-gradient(135deg, var(--color-red), var(--color-blue-dark));
    }

    .cover-text {
      max-width: 100%;
    }

    .cover-tagline {
      font-size: 1.4rem;
    }

    .cover-subtitle {
      font-size: 0.85rem;
    }

    .cover-art {
      width: 150px;
    }
  }

  .article {
    max-width: 760px;
    margin-top: -48px;
    position: relative;
    background: var(--color-paper);
    border: 1px solid var(--color-panel-line);
    border-radius: 6px;
    box-shadow: var(--shadow-card);
    padding: 32px clamp(20px, 5vw, 48px) 60px;
  }

  .back {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin-bottom: 16px;
    text-decoration: none;
    color: #fff;
    background: var(--color-blue-dark);
    border: 1px solid var(--color-blue-dark);
    border-radius: 50%;
    font-size: 1.1rem;
    line-height: 1;
    font-family: var(--font-sans);
    box-shadow: var(--shadow-sm);
    transition: all 0.2s ease;
  }

  .back:hover {
    background: var(--color-blue-dark);
    border-color: var(--color-blue-dark);
  }

  .back-bottom {
    margin-top: 32px;
    margin-bottom: 0;
  }

  /* Переход из гида в прайс. Красная кнопка, потому что ведёт в прайс — по общему
     правилу сайта прайс красный, инфо синее (а статья вокруг как раз синяя/розовая). */
  .to-catalog {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin: 34px 0 6px;
