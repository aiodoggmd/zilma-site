  /* Сетка готовых формул-миксов (Color Tune) — маленькая иллюстративная миниатюра
     (текстура из официального гида) + название + формула, без привязки к наличию в прайсе
     (см. feedback_no-static-availability-text-in-articles — реальное наличие видно только
     по кнопкам заказа в таблице «Что заказать»/интерактивной палитре, не здесь). */
  .prose :global(.combo-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
