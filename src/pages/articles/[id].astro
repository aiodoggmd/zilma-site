<script>
  // На мобильном pinch-zoom по картинке в лайтбоксе — это зум ВСЕЙ страницы (браузер не умеет
  // масштабировать один fixed-элемент отдельно от остальных), и после закрытия оверлея масштаб
  // сайта остаётся «прилипшим» увеличенным. Единственный надёжный кросс-браузерный способ сбросить
  // зум обратно — на мгновение подменить content у <meta name="viewport">, это форсит перерасчёт.
  function resetPageZoom() {
    const viewport = document.querySelector('meta[name="viewport"]');
    if (!viewport) return;
    const original = viewport.getAttribute('content') ?? '';
    viewport.setAttribute('content', original + ', maximum-scale=1');
    requestAnimationFrame(() => viewport.setAttribute('content', original));
  }

  function initLightbox() {
    document.querySelectorAll('.prose img').forEach((img) => {
      img.addEventListener('click', () => {
        const overlay = document.createElement('div');
        overlay.className = 'lightbox-overlay';
        const big = document.createElement('img');
        big.src = img.currentSrc || img.src;
        big.alt = img.alt;
        overlay.appendChild(big);
        overlay.addEventListener('click', () => {
          overlay.remove();
          resetPageZoom();
        });
        document.body.appendChild(overlay);
      });
    });
  }
  initLightbox();

  // Обычная markdown-таблица не может сама себя обернуть в скролл-контейнер — оборачиваем
  // в рантайме (см. комментарий у `.prose :global(.table-scroll-wrap)` в styles выше про то,
  // почему `display:block` прямо на `<table>` не даёт колонкам растянуться на всю ширину).
  // `.kit-table` уже приходит с собственной `.kit-table-wrap` из markdown — не трогаем повторно.
  function initTableScroll() {
    document.querySelectorAll('.prose table').forEach((table) => {
      if (table.classList.contains('kit-table') || table.closest('.table-scroll-wrap')) return;
      const wrap = document.createElement('div');
      wrap.className = 'table-scroll-wrap';
      table.parentNode?.insertBefore(wrap, table);
      wrap.appendChild(table);
    });
  }
  initTableScroll();

  // Кнопки «В заявку» на статичных товарных таблицах/карточках (Lebel «Абсолютное счастье
  // для волос», 2026-08-28) — тот же window.zilmaCart, что и в интерактивной палитре оттенков
  // (ShadeSwatchGrid.astro), просто без пикера цвета: цена и название уже зашиты в data-атрибуты
  // прямо в markdown статьи (там же, где вручную сверялись с priceItems.json). Общий приём для
  // любой будущей статьи с обычным списком товаров (не палитрой) — не только для Lebel.
  function initCartButtons() {
    document.querySelectorAll<HTMLButtonElement>('.cart-add-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const name = btn.dataset.name;
        const price = parseFloat(btn.dataset.price ?? '');
        const brand = btn.dataset.brand || 'LEBEL';
        if (!name || !Number.isFinite(price)) return;
        const items = (window as any).zilmaCart?.get() ?? [];
        const existing = items.find((it: any) => it.name === name);
        if (existing) existing.qty += 1;
        else items.push({ name, price, qty: 1, brand, promo: false });
        (window as any).zilmaCart?.set(items);
        const original = btn.textContent;
        btn.textContent = '✓ Добавлено';
        btn.classList.add('is-added');
        setTimeout(() => {
          btn.textContent = original;
          btn.classList.remove('is-added');
        }, 1200);
      });
    });
  }
  initCartButtons();
</script>
