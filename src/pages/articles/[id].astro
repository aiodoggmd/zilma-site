  }

  /* кнопка «В заявку» на статичных товарных таблицах/карточках — см. initCartButtons() в script
     ниже. Синяя, как CTA в интерактивной палитре (ShadeSwatchGrid), для визуальной консистентности. */
  .prose :global(.cart-add-btn) {
