  }

  .prose :global(.faq-item .faq-q) {
    font-family: var(--font-serif);
    font-weight: 700;
    color: var(--color-ink);
    margin: 0 0 6px;
  }

  .prose :global(.faq-item .faq-a) {
    margin: 0;
    color: var(--color-ink);
  }

  /* нумерованные шаги с кружком-цифрой (порядок важен — не путать с .checklist, там порядок
     не имеет значения) */
  .prose :global(.steps-ordered) {
    list-style: none;
    counter-reset: step;
    margin: 16px 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .prose :global(.steps-ordered li) {
    counter-increment: step;
    display: flex;
    align-items: flex-start;
    gap: 14px;
    background: var(--surface-card);
    border: 1px solid var(--color-panel-line);
    border-radius: 6px;
