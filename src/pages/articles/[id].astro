  .prose :global(h2) {
    font-family: var(--font-serif);
    font-weight: 600;
    margin-top: 36px;
    color: var(--color-ink);
    font-size: 1.35rem;
  }

  .prose :global(p) {
    line-height: 1.7;
  }

  /* Ссылки в тексте статьи (напр. перекрёстные ссылки на другие гиды в предисловии) раньше
     были неотличимы от обычного текста — color:inherit из global.css красил их в тот же
     цвет, что и абзац, оставался только тонкое браузерное подчёркивание. Правило намеренно
     стоит ДО специализированных ссылок ниже (.related-list a, .toc-box a и т.п.) — при
     равной специфичности побеждает то, что ниже по файлу, так что их собственные более
     новые правила продолжат переопределять это базовое, как и раньше. */
  .prose :global(a) {
    color: var(--color-blue-dark);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose :global(a:hover) {
    color: var(--color-blue);
  }

  .prose :global(ul) {
    line-height: 1.7;
  }

  .prose :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    height: 320px;
    object-fit: contain;
    margin: 16px auto;
    border-radius: 6px;
  }

  .prose :global(img[src*="palette"]) {
    width: 100%;
    max-width: 100%;
    height: 480px;
    margin: 16px 0;
  }

  @media (max-width: 640px) {
    .prose :global(img) {
      height: 240px;
    }

    .prose :global(img[src*="palette"]) {
