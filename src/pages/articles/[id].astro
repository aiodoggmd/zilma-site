    line-height: 1.5;
  }

  .prose :global(.steps-ordered li::before) {
    content: counter(step);
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-blue-dark);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 0.9rem;
    box-shadow: var(--shadow-sm);
  }

  /* лайтбокс — увеличение картинок по клику. touch-action:manipulation отключает нативный
     двойной-тап-зум браузера на самой картинке — без этого на телефоне тап иногда триггерил
     зум всей страницы вместо клика, открывающего оверлей (реальная жалоба, 2026-08-30). */
  .prose :global(img) {
    cursor: zoom-in;
    touch-action: manipulation;
  }

  :global(.lightbox-overlay) {
    position: fixed;
    inset: 0;
    background: rgba(20, 14, 12, 0.86);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 200;
    cursor: zoom-out;
    padding: 24px;
  }

  :global(.lightbox-overlay img) {
    max-width: 100%;
    max-height: 100%;
    border-radius: 6px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    cursor: zoom-out;
    margin: 0;
  }
</style>

<script>
  // На мобильном pinch-zoom по картинке в лайтбоксе — это зум ВСЕЙ страницы (браузер не умеет
  // масштабировать один fixed-элемент отдельно от остальных), и после закрытия оверлея масштаб
  // сайта остаётся «прилипшим» увеличенным. Единственный надёжный кросс-браузерный способ сбросить
  // зум обратно — на мгновение подменить content у <meta name="viewport">, это форсит перерасчёт.
  // Реальная жалоба (2026-08-30): «← Все статьи» на телефоне вела жёстко на "/" — новый
  // переход всегда открывает главную с самого верха (херо), теряя место в ленте, откуда
  // читатель зашёл в статью, и не давая продолжить скролл. Тот же приём, что уже работает
  // на /order/ (см. order.astro) — если сюда пришли с этого же сайта, настоящий history.back()
  // возвращает именно на прежнее место (ленту с той же прокруткой, или #info, или куда угодно
  // ещё) вместо нового перехода. Прямые заходы (закладка, поиск, соцсети) — обычная ссылка на "/".
  if (document.referrer) {
    try {
      if (new URL(document.referrer).origin === location.origin) {
        document.querySelectorAll<HTMLAnchorElement>('a.back').forEach((link) => {
          link.addEventListener('click', (e) => {
            e.preventDefault();
            history.back();
          });
        });
      }
    } catch {}
  }

  function resetPageZoom() {
    const viewport = document.querySelector('meta[name="viewport"]');
    if (!viewport) return;
    const original = viewport.getAttribute('content') ?? '';
    viewport.setAttribute('content', original + ', maximum-scale=1');
    requestAnimationFrame(() => viewport.setAttribute('content', original));
  }

  // Живая сверка таблиц "Что заказать" с актуальным прайсом — сервер отдал урезанный
  // список товаров в #price-lookup-data (см. priceLookup в frontmatter), здесь сверяем
  // с ним каждую кнопку "+ В заявку"/"Нет в наличии" при загрузке страницы. Тот же
  // (бренд, артикул)-поиск с защитой от неоднозначности, что и в resolve-live-price.ts
  // для интерактивной палитры — короткие тоновые коды могут повторяться у разных линий
  // одного бренда (найдено программно на реальных данных, 2026-08-31), поэтому при
  // коллизии строку просто не трогаем, а не гадаем.
  interface PriceLookupItem {
    name: string;
    brand: string;
    price: number;
    oldPrice: number | null;
    promo: boolean;
    discountPct: number | null;
    isNew: boolean;
  }

  function articleOfName(name: string): string {
    const toks = name.trim().split(/\s+/);
    return toks[toks.length - 1] ?? '';
  }

  function formatPriceRu(n: number): string {
    const rounded = Math.round(n * 100) / 100;
    const str = Number.isInteger(rounded) ? String(rounded) : rounded.toFixed(2).replace(/0+$/, '').replace(/\.$/, '');
    return str.replace('.', ',');
  }

  // Цена в таблице статьи — ровно как в каталоге: зачёркнутая старая цена, красная новая,
  // бейдж с РАЗМЕРОМ скидки (а не общее слово «Акция» — по нему не видно, насколько дешевле),
  // и синий бейдж «Нов» у новинок. Новинка может быть и без скидки, поэтому бейдж
  // приклеивается к обеим веткам, а не только к акционной.
  function badgesHtml(item: PriceLookupItem): string {
    const badges: string[] = [];
    if (item.promo) {
      badges.push(`<span class="kit-promo-badge">${item.discountPct ? `-${Math.round(item.discountPct)}%` : 'Акция'}</span>`);
    }
    if (item.isNew) badges.push('<span class="kit-new-badge">Нов</span>');
    return badges.join(' ');
  }

  function priceCellHtml(item: PriceLookupItem): string {
    const badges = badgesHtml(item);
    if (item.promo && item.oldPrice != null) {
      return `<s class="kit-old-price">${formatPriceRu(item.oldPrice)} ₽</s><b class="kit-price-now">${formatPriceRu(item.price)} ₽</b>${badges ? ' ' + badges : ''}`;
    }
    return `${formatPriceRu(item.price)} ₽${badges ? ' ' + badges : ''}`;
  }

  function initLivePrices() {
    const dataEl = document.getElementById('price-lookup-data');
    if (!dataEl) return;
    let items: PriceLookupItem[];
    try {
      items = JSON.parse(dataEl.textContent || '[]');
    } catch {
      return;
    }

    const AMBIGUOUS = Symbol('ambiguous');
    const byBrandArticle = new Map<string, Map<string, PriceLookupItem | typeof AMBIGUOUS>>();
    for (const it of items) {
      const brand = it.brand.toUpperCase();
      if (!byBrandArticle.has(brand)) byBrandArticle.set(brand, new Map());
      const m = byBrandArticle.get(brand)!;
      const key = articleOfName(it.name);
      m.set(key, m.has(key) ? AMBIGUOUS : it);
    }

    document.querySelectorAll<HTMLElement>('.cart-add-btn, .order-unavailable').forEach((el) => {
      const brand = el.dataset.brand;
      if (!brand) return;
      const key = el.dataset.article || articleOfName(el.dataset.name || '');
      if (!key) return;
      const match = byBrandArticle.get(brand.toUpperCase())?.get(key);
      if (match === AMBIGUOUS) return;

      const row = el.closest('tr');
      const priceCell = row?.querySelector<HTMLElement>('td.col-price-cell');
      const isBtn = el.classList.contains('cart-add-btn');

      if (match) {
        if (priceCell) priceCell.innerHTML = priceCellHtml(match);
        if (isBtn) {
          (el as HTMLButtonElement).dataset.name = match.name;
          (el as HTMLButtonElement).dataset.price = String(match.price);
          (el as HTMLButtonElement).dataset.promo = match.promo ? '1' : '';
        } else {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'cart-add-btn';
          btn.dataset.name = match.name;
          btn.dataset.price = String(match.price);
          btn.dataset.brand = brand;
          btn.dataset.promo = match.promo ? '1' : '';
          btn.textContent = '+ В заявку';
          el.replaceWith(btn);
        }
      } else if (isBtn) {
        if (priceCell) priceCell.textContent = '—';
        const span = document.createElement('span');
        span.className = 'order-unavailable';
        span.dataset.article = key;
        span.dataset.brand = brand;
        span.textContent = brand.toUpperCase() === 'LEBEL' ? 'Под заказ' : 'Нет в наличии';
        el.replaceWith(span);
      }
    });
  }
  initLivePrices();

  function initLightbox() {
    document.querySelectorAll('.prose img').forEach((img) => {
      img.addEventListener('click', () => {
        const overlay = document.createElement('div');
        overlay.className = 'lightbox-overlay';
        const big = document.createElement('img');
        big.src = img.currentSrc || img.src;
        big.alt = img.alt;
        overlay.appendChild(big);
        overlay.addEventListener('click', () => {
          overlay.remove();
          resetPageZoom();
        });
        document.body.appendChild(overlay);
      });
    });
  }
  initLightbox();

  // Обычная markdown-таблица не может сама себя обернуть в скролл-контейнер — оборачиваем
  // в рантайме (см. комментарий у `.prose :global(.table-scroll-wrap)` в styles выше про то,
  // почему `display:block` прямо на `<table>` не даёт колонкам растянуться на всю ширину).
  // `.kit-table` уже приходит с собственной `.kit-table-wrap` из markdown — не трогаем повторно.
  function initTableScroll() {
    document.querySelectorAll('.prose table').forEach((table) => {
      if (table.classList.contains('kit-table') || table.closest('.table-scroll-wrap')) return;
      const wrap = document.createElement('div');
      wrap.className = 'table-scroll-wrap';
      table.parentNode?.insertBefore(wrap, table);
      wrap.appendChild(table);
    });
  }
  initTableScroll();

  // Подсказка про горизонтальный скролл — только для таблиц, которые реально не помещаются
  // в ширину экрана (на десктопе, где всё и так видно, подсказка не создаётся вообще).
  // Общий шаблон, а не разметка статьи — правится в одном месте сразу для всех таблиц сайта.
  function initScrollHints() {
    document.querySelectorAll<HTMLElement>('.kit-table-wrap, .table-scroll-wrap').forEach((wrap) => {
      if (wrap.scrollWidth <= wrap.clientWidth + 1) return;
      const hint = document.createElement('p');
      hint.className = 'scroll-hint';
      hint.textContent = 'Прокрутите таблицу вправо, чтобы увидеть остальные колонки →';
      wrap.parentNode?.insertBefore(hint, wrap);
    });
  }
  initScrollHints();

  // Кнопки «В заявку» на статичных товарных таблицах/карточках (Lebel «Абсолютное счастье
  // для волос», 2026-08-28) — тот же window.zilmaCart, что и в интерактивной палитре оттенков
  // (ShadeSwatchGrid.astro), просто без пикера цвета: цена и название уже зашиты в data-атрибуты
  // прямо в markdown статьи (там же, где вручную сверялись с priceItems.json). Общий приём для
  // любой будущей статьи с обычным списком товаров (не палитрой) — не только для Lebel.
  function initCartButtons() {
    document.querySelectorAll<HTMLButtonElement>('.cart-add-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const name = btn.dataset.name;
        const price = parseFloat(btn.dataset.price ?? '');
        const brand = btn.dataset.brand || 'LEBEL';
        const promo = btn.dataset.promo === '1';
        if (!name || !Number.isFinite(price)) return;
        const items = (window as any).zilmaCart?.get() ?? [];
        const existing = items.find((it: any) => it.name === name);
        if (existing) existing.qty += 1;
        else items.push({ name, price, qty: 1, brand, promo });
        (window as any).zilmaCart?.set(items);
        const original = btn.textContent;
        btn.textContent = '✓ Добавлено';
        btn.classList.add('is-added');
        setTimeout(() => {
          btn.textContent = original;
          btn.classList.remove('is-added');
        }, 1200);
      });
    });
  }
  initCartButtons();
</script>
