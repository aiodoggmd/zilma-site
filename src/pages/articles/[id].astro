  }

  /* карточка продукта внутри callout (напр. IAU Essence Moist/Sleek/Forti) — название сверху,
     затем мелкая подпись объём/артикул. Раньше здесь была отдельная grid-раскладка .mix-card
     с большим круглым значком слева («булька») — на мобильном при grid-template-columns:1fr
     значок вставал НАД текстом, съедая огромную высоту экрана на каждой из трёх карточек подряд
     (реальная жалоба пользователя, 2026-08-28). Просто текстовый блок в callout, без иконки —
     компактно на любом экране. */
  .prose :global(.callout .callout-title) {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-ink);
    margin: 0 0 2px;
  }

  .prose :global(.callout .callout-sub) {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.03em;
