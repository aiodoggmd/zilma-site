  @media (max-width: 480px) {
    .prose :global(.photo-pair img) {
      height: 180px;
    }

    .prose :global(.photo-pair .photo-pair-swatch) {
      height: 120px;
    }
    .prose :global(.combo-card img) {
      width: 52px;
      height: 52px;
    }
  }

  /* таблицы (Special Mix) — на узких экранах длинные ячейки (см. Igora Royal, «Линейки Igora
     Royal» 5 колонок) не переносятся по словам и раздувают таблицу шире экрана, из-за чего у
     ВСЕЙ страницы появляется горизонтальный overflow (проверено: 622px контента при 360px экрана,
     в статьях с более короткими ячейками этого не было) — это, предположительно, и сбивало
     позиционирование фиксированной нижней плашки на Android Chrome (реальный баг, 2026-08-28).
     Оборачиваем таблицу в собственный горизонтальный скролл, чтобы разрастись могла только она,
     а не вся страница. */
  .prose :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    width: 100%;
    border-collapse: collapse;
    margin: 18px 0;
    font-size: 0.88rem;
  }

  /* Отдельная от `.kit-table` проблема с тем же корнем: `display:block` на самой `<table>`
     (нужен для скролла выше) отключает штатный алгоритм растягивания колонок под ширину
     контейнера — узкая таблица (мало текста в ячейках, напр. «Special Mix» у Koleston) не
     дотягивается до ширины страницы, хотя сам элемент table формально 100% ширины, и справа
     остаётся невидимая пустота внутри его же бокса (проверено программно: сумма ширин ячеек
     на Koleston — 268px из 662px бокса). Решение то же самое, что и у `.kit-table` — обычной
     markdown-таблице просто неоткуда взять свою обёртку из коробки, поэтому оборачиваем в
     `.table-scroll-wrap` через JS (см. initTableScroll ниже) и возвращаем самой `<table>`
     настоящий display:table, тогда браузер честно распределяет свободную ширину по колонкам. */
  .prose :global(.table-scroll-wrap) {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: 18px 0;
  }

  .prose :global(.table-scroll-wrap table) {
    display: table;
    width: 100%;
    min-width: max-content;
    margin: 0;
    border-collapse: collapse;
    font-size: 0.88rem;
  }

  /* .kit-table (Lebel «Абсолютное счастье для волос», малый/большой набор) — две отдельные таблицы
     с разной длиной названий товаров иначе получают разную ширину колонок (auto table-layout
     считает ширину каждой таблицы независимо от содержимого), из-за чего № и Артикул визуально
     «гуляли» между таблицами. ТРИ варианта на голом `<table>` не сработали, все давали одинаковый
     неверный результат (проверено программно): дело в том, что общее правило `.prose table` выше
     форсит `display:block` (нужно для горизонтального скролла на мобильном) — с этим display на
     table браузер, судя по всему, всё равно считает неявную/процентную ширину «свободной» колонки
     по её собственному контенту, а не по факту заданного CSS, независимо от того, как именно эта
     ширина задана (голый table-layout:fixed, auto-layout с шириной на крайних ячейках, calc(100%)
     на col). Рабочий вариант — вернуть самой `<table>` НАСТОЯЩИЙ `display:table` (не block), а
     горизонтальный скролл повесить на отдельный оборачивающий `<div class="kit-table-wrap">` —
     тогда стандартный алгоритм fixed-таблиц отрабатывает штатно и одинаково на обеих таблицах. */
  .prose :global(.kit-table-wrap) {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: 18px 0;
  }

  /* min-width на самой таблице — иначе на узком экране table-layout:fixed при нескольких
     колонках фиксированной ширины (номер+артикул+цена+заказ, до 368px суммарно) схлопывает
     колонку названия товара до 0px вместо того, чтобы просто стать шире контейнера и
     проскроллиться (авария реальная, найдено 2026-08-30 после добавления колонки «Цена»
     во все kit-table сразу — раньше без неё сумма фикс.колонок не превышала ширину контейнера,
     баг был скрыт). min-width форсит таблицу учитывать реальные нужды колонки названия,
     .kit-table-wrap уже даёт горизонтальный скролл для этого случая. */
  .prose :global(.kit-table-wrap table.kit-table) {
    display: table;
    table-layout: fixed;
    width: 100%;
    min-width: 560px;
    margin: 0;
  }

  .prose :global(table.kit-table col.col-num) {
    width: 40px;
  }

  .prose :global(table.kit-table col.col-art) {
    width: 90px;
  }

  .prose :global(table.kit-table col.col-order) {
    width: 108px;
  }

  .prose :global(table.kit-table col.col-price) {
    width: 130px;
  }

  /* Колонка «Заказ» прилипает к правому краю обёртки при горизонтальном скролле (найдено
     2026-08-30: на узком экране кнопка «+» уезжала за край без сдвига таблицы, и ничего
     не намекало, что таблицу вообще можно докрутить). Фон должен быть непрозрачным —
     иначе сквозь sticky-ячейку было бы видно уезжающий текст соседних колонок под ней.
     Чётные строки красим тем же rgba-тоном, что и обычные ячейки (`tr:nth-child(even) td`
     ниже), но наложенным непрозрачным слоем (linear-gradient с одинаковым цветом на обоих
     стопах) поверх сплошной var(--color-paper) — иначе сам rgba(...,0.4) остался бы
     полупрозрачным и не решил бы исходную проблему. */
  .prose :global(table.kit-table td.col-order-cell) {
    text-align: center;
    position: sticky;
    right: 0;
    z-index: 1;
    background: var(--color-paper);
    box-shadow: -6px 0 8px -6px rgba(43, 32, 28, 0.18);
  }

  .prose :global(table.kit-table tr:nth-child(even) td.col-order-cell) {
    background: linear-gradient(rgba(241, 236, 228, 0.4), rgba(241, 236, 228, 0.4)), var(--color-paper);
  }

  .prose :global(table.kit-table thead th:last-child) {
    position: sticky;
    right: 0;
    z-index: 2;
    box-shadow: -6px 0 8px -6px rgba(43, 32, 28, 0.18);
  }

  /* Реальная авария (найдено 2026-08-30): при промо в ячейке одновременно старая цена, новая
     цена и бейдж «Акция» — на одной строке (white-space:nowrap) это шире 130px и вылезает
     в соседнюю колонку «Заказ», наезжая на кнопку. display:flex + flex-wrap переносит старую
     цену на отдельную строку от новой+бейджа, если не помещаются — без wrap кнопка съедалась. */
  /* min-height — иначе строки без акции (одна строка текста) заметно ниже соседних строк
     с акцией (две строки — старая цена сверху, новая+бейдж снизу), и таблица выглядит
     неровной, «дёрганой» по высоте от строки к строке (найдено 2026-08-30). */
  .prose :global(table.kit-table td.col-price-cell) {
    text-align: center;
    vertical-align: middle;
    font-size: 0.86rem;
    min-height: 71px;
    box-sizing: border-box;
  }

  /* display:block (не inline-block) — старая цена сама встаёт на отдельную строку от
     новой цены+бейджа без display:flex на самой ячейке. flex на <td> раньше выбивал
     ячейку из обычной табличной раскладки (перестаёт тянуться на высоту строки), и в
     строках с длинным названием товара (третья колонка) граница ячейки цены повисала
     прямо посреди строки — выглядело как лишняя линия под ценой (найдено 2026-08-31,
     статья Infinity Aurum, где названия товаров непривычно длинные). */
  .prose :global(.kit-old-price) {
    display: block;
    color: var(--color-meta);
    text-decoration: line-through;
  }

  .prose :global(.kit-price-now) {
    color: var(--color-red);
    font-weight: 700;
  }

  /* Красный = скидка, синий = новинка — та же пара, что в каталоге. */
  .prose :global(.kit-promo-badge),
  .prose :global(.kit-new-badge) {
    display: inline-block;
    padding: 1px 7px;
    color: #fff;
    border-radius: 4px;
    font-size: 0.68rem;
    font-weight: 700;
