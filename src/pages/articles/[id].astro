  }

  /* текстовая врезка */
  .prose :global(.callout) {
    background: var(--surface-card);
    border-left: 3px solid var(--color-blue-dark);
    border-radius: 0 6px 6px 0;
    padding: 14px 18px;
    margin: 14px 0;
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .prose :global(.callout b) {
