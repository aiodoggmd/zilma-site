---
// Уроки за минуту — лента коротких вертикальных роликов-рецептов (заведена 16.10.2026).
// Каждый ролик — готовое решение из статьи: «хочу такой цвет → смешай вот это → оксид, время».
// Ролик открывается на весь экран тем же плеером, что и кружок над статьёй (LessonBubbles).
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import LessonBubbles from '../../components/LessonBubbles.astro';
import lessons from '../../data/lessons.json';
import { getArticles } from '../../lib/articles';

const titles = Object.fromEntries((await getArticles()).map((a) => [a.id, a.data.title]));
const list = [...lessons].sort((a, b) => b.date.localeCompare(a.date));
const fmt = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const videoLd = list.map((l) => ({
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: l.title,
  description: l.subtitle,
  thumbnailUrl: `${siteUrl}${l.poster}`,
  contentUrl: `${siteUrl}${l.video}`,
  uploadDate: l.date,
  duration: `PT${l.duration}S`,
}));
---
<BaseLayout
  title="Уроки за минуту: готовые формулы окрашивания — Zilma"
  description="Короткие видео-рецепты для колористов: какой оттенок смешать, какой оксид и сколько держать — Koleston, Igora, Londa, Matrix."
>
  {videoLd.map((v) => <script type="application/ld+json" slot="head" set:html={JSON.stringify(v)} />)}

  <div class="container">
    <nav class="crumbs" aria-label="Вы здесь">
      <a href="/">Главная</a><span aria-hidden="true">→</span><span>Уроки</span>
    </nav>

    <h1>Уроки за минуту</h1>
    <p class="lead">Короткие видео-рецепты: какой оттенок хочет клиентка, что смешать, какой оксид и сколько держать.</p>

    <div class="lesson-grid">
      {list.map((l) => (
        <div class="lesson-card">
          <button type="button" class="lesson-bubble lc-play" data-video={l.video} data-poster={l.poster} data-title={l.title} data-article={`/articles/${l.article}/`} data-id={l.id}
                  aria-label={`Смотреть урок: ${l.title}, ${fmt(l.duration)}`}>
            <img src={l.poster} alt="" width="540" height="960" loading="lazy" />
          </button>
          <h2 class="lc-title">{l.title}</h2>
          <p class="lc-sub">{l.subtitle}</p>
          {titles[l.article] && <a class="lc-article" href={`/articles/${l.article}/`}>Статья: {titles[l.article]}</a>}
        </div>
      ))}
    </div>

    <p class="back-to-catalog">
      <a href="/articles/" class="link">Все инструкции →</a>
    </p>
  </div>
  <LessonBubbles article="—" showAllLink={false} player />
</BaseLayout>

<style>
  .crumbs { display: flex; gap: 8px; align-items: center; font-size: 0.82rem; color: var(--color-muted); padding: 22px 0 0; }
  .crumbs a { color: var(--color-muted); text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  h1 { margin: 14px 0 10px; }
  .lead { max-width: 60ch; color: var(--color-muted); margin: 0 0 26px; }
  .lesson-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; padding-bottom: 20px; }
  .lesson-card { display: flex; flex-direction: column; gap: 6px; }
  .lc-play { position: relative; padding: 0; border: 0; border-radius: 14px; overflow: hidden; cursor: pointer; background: #000; aspect-ratio: 9 / 16; }
  .lc-play img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .lc-time { position: absolute; left: 10px; bottom: 10px; background: rgba(0, 0, 0, 0.6); color: #fff; font-size: 0.82rem; font-weight: 600; padding: 4px 10px; border-radius: 999px; }
  .lc-title { font-size: 1.05rem; margin: 8px 0 0; line-height: 1.3; }
  .lc-sub { font-size: 0.85rem; color: var(--color-muted); margin: 0; }
  .lc-article { font-size: 0.82rem; color: var(--color-blue-dark); }
  .back-to-catalog { padding-bottom: 60px; }
  @media (max-width: 900px) { .lesson-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 640px) { .lesson-grid { grid-template-columns: repeat(2, 1fr); gap: 16px; } }
</style>
