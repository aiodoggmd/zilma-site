---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Страница не найдена — Zilma"
  description="Такой страницы нет — возможно, ссылка устарела или в адресе опечатка."
>
  <div class="container page">
    <p class="code">404</p>
    <h1>Страница не найдена</h1>
    <p class="lede">Такой страницы нет — возможно, ссылка устарела или в адресе опечатка.</p>
    <div class="links">
      <a href="/" class="btn">На главную</a>
      <a href="/#info" class="link">Гиды по брендам</a>
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    padding: 80px 0 100px;
    text-align: center;
  }

  .code {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 4rem;
    color: var(--color-red);
    margin: 0;
    line-height: 1;
  }

  h1 {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.6rem;
    margin: 10px 0 8px;
    color: var(--color-ink);
  }

  .lede {
    color: var(--color-meta);
    margin: 0 0 28px;
  }

  .links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    background: var(--color-blue-dark);
    color: #fff;
    font-weight: 600;
    padding: 12px 26px;
    border-radius: 999px;
    text-decoration: none;
  }

  .btn:hover {
    filter: brightness(1.1);
  }

  .link {
    color: var(--color-blue-dark);
    text-decoration: none;
    font-size: 0.92rem;
  }

  .link:hover {
    text-decoration: underline;
  }
</style>
